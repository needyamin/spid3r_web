// server.matrix
// Spid3rWeb Production & Development HTTP Application Server

import "framework/Application";
import "routes/web";
import "routes/api";
import "app/Middleware/AdminMiddleware";

fn main() {
    println("==================================================================");
    println("                  Spid3rWeb Application Server                   ");
    println("==================================================================");

    // 1. Initialize Application Kernel
    let app = new Application();

    // 1b. Named middleware aliases (route-level guards)
    app.middleware("admin", fn(_args) { return new AdminMiddleware(); });

    // 2. Register Web and API Routes
    register_web_routes();
    register_api_routes();

    // 3. Port Configuration (default 8000)
    let port = 8000;
    let cli_args = args();
    if cli_args.len() > 0 {
        let parsed = 0;
        try {
            parsed = int(cli_args[0]);
        } catch (_e) {
            println("[Spid3rWeb] Invalid port argument '" + string(cli_args[0]) + "', falling back to 8000");
            parsed = 0;
        }
        if parsed > 0 {
            port = parsed;
        }
    }

    // 4. Start HTTP Server
    app.listen(port);
}
