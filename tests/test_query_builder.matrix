// tests/test_query_builder.matrix
// Unit tests for Spid3rWeb Database & QueryBuilder

import "framework/Database/DB";
import "framework/Database/Schema";

fn test_query_builder_crud() {
    let now = string(unix_time());

    // 1. Insert
    let user_id = DB.table("users").insert(map(
        "name", "Test User",
        "email", "test_" + now + "@example.com",
        "password", "hashed_pw_test",
        "created_at", now,
        "updated_at", now
    ));
    assert(user_id > 0, "Insert should return last_id > 0");

    // 2. Find
    let user = DB.table("users").find(user_id);
    assert(user != null, "find(id) should return inserted user");
    assert(user["name"] == "Test User", "User name should match");

    // 3. Where
    let found = DB.table("users")
        .where("id", "=", user_id)
        .first();
    assert(found != null, "where query should find user");

    // 4. Count
    let total = DB.table("users").count();
    assert(total > 0, "Users count should be greater than 0");

    // 5. Update
    let changes = DB.table("users")
        .where("id", "=", user_id)
        .update(map("name", "Updated Test User"));
    assert(changes > 0, "Update should return changes > 0");

    let updated_user = DB.table("users").find(user_id);
    assert(updated_user["name"] == "Updated Test User", "Updated name should match");

    // 6. Delete
    let deleted_count = DB.table("users")
        .where("id", "=", user_id)
        .delete();
    assert(deleted_count > 0, "Delete should return changes > 0");

    let after_delete = DB.table("users").find(user_id);
    assert(after_delete == null, "User should no longer exist after delete");
    println("  [PASS] test_query_builder_crud");
}

fn test_query_builder_joins_sql() {
    // 1. Standard 4-arg inner join
    let q1 = DB.table("orders").join("users", "orders.user_id", "=", "users.id");
    assert(q1.toSql() == "SELECT * FROM orders INNER JOIN users ON orders.user_id = users.id", "q1 toSql mismatch");

    // 2. Shorthand 3-arg inner join
    let q2 = DB.table("orders").join("users", "orders.user_id", "users.id");
    assert(q2.toSql() == "SELECT * FROM orders INNER JOIN users ON orders.user_id = users.id", "q2 toSql mismatch");

    // 3. Explicit innerJoin alias
    let q3 = DB.table("orders").innerJoin("users", "orders.user_id", "=", "users.id");
    assert(q3.toSql() == "SELECT * FROM orders INNER JOIN users ON orders.user_id = users.id", "q3 toSql mismatch");

    // 4. Left join
    let q4 = DB.table("users").leftJoin("orders", "users.id", "=", "orders.user_id");
    assert(q4.toSql() == "SELECT * FROM users LEFT JOIN orders ON users.id = orders.user_id", "q4 toSql mismatch");

    // 5. Right join
    let q5 = DB.table("orders").rightJoin("users", "orders.user_id", "=", "users.id");
    assert(q5.toSql() == "SELECT * FROM orders RIGHT JOIN users ON orders.user_id = users.id", "q5 toSql mismatch");

    // 6. Cross join
    let q6 = DB.table("users").crossJoin("roles");
    assert(q6.toSql() == "SELECT * FROM users CROSS JOIN roles", "q6 toSql mismatch");

    // 7. Chained joins with select, where, orderBy, limit, offset
    let q7 = DB.table("products")
        .select(["products.id", "products.name", "categories.name as category"])
        .join("categories", "products.category_id", "=", "categories.id")
        .leftJoin("brands", "products.brand_id", "=", "brands.id")
        .where("products.status", "=", "active")
        .where("categories.id", ">", 0)
        .orderBy("products.created_at", "DESC")
        .limit(10)
        .offset(5);

    let compiled7 = q7.build_select_sql();
    let expected_sql = "SELECT products.id, products.name, categories.name as category FROM products INNER JOIN categories ON products.category_id = categories.id LEFT JOIN brands ON products.brand_id = brands.id WHERE products.status = ? AND categories.id > ? ORDER BY products.created_at DESC LIMIT 10 OFFSET 5";
    assert(compiled7["sql"] == expected_sql, "q7 sql mismatch");
    assert(compiled7["params"].len() == 2, "q7 params count mismatch");
    assert(compiled7["params"][0] == "active", "q7 param 0 mismatch");
    assert(compiled7["params"][1] == 0, "q7 param 1 mismatch");
    assert(q7.toSql() == expected_sql, "q7 toSql mismatch");
    println("  [PASS] test_query_builder_joins_sql");
}

fn test_query_builder_joins_execution() {
    let now = string(unix_time());

    // Temporary fixture table (dropped at teardown)
    Schema.dropIfExists("qb_join_items");
    Schema.create("qb_join_items", table => {
        table.id();
        table.string("title");
        table.integer("user_id");
        table.timestamps();
    });

    // 1. Create test user A with one item
    let user_a_id = DB.table("users").insert({
        "name": "Join User A",
        "email": "join_a_" + now + "@example.com",
        "password": "secret",
        "created_at": now,
        "updated_at": now
    });

    let item_id = DB.table("qb_join_items").insert({
        "title": "Join Test Item",
        "user_id": user_a_id,
        "created_at": now,
        "updated_at": now
    });

    // 2. Create test user B with no items
    let user_b_id = DB.table("users").insert({
        "name": "Join User B",
        "email": "join_b_" + now + "@example.com",
        "password": "secret",
        "created_at": now,
        "updated_at": now
    });

    // 3. Test INNER JOIN execution
    let inner_rows = DB.table("qb_join_items")
        .select(["qb_join_items.title", "users.name", "qb_join_items.user_id"])
        .join("users", "qb_join_items.user_id", "=", "users.id")
        .where("qb_join_items.id", "=", item_id)
        .get();
    assert(inner_rows.len() == 1, "INNER JOIN should return 1 row");
    assert(inner_rows[0]["title"] == "Join Test Item", "Title should match");
    assert(inner_rows[0]["name"] == "Join User A", "Owner name should match");

    // 4. Test LEFT JOIN execution (user with no items)
    let left_rows = DB.table("users")
        .select(["users.name", "qb_join_items.title"])
        .leftJoin("qb_join_items", "users.id", "=", "qb_join_items.user_id")
        .where("users.id", "=", user_b_id)
        .get();
    assert(left_rows.len() == 1, "LEFT JOIN should return 1 row for lonely user");
    assert(left_rows[0]["name"] == "Join User B", "User name should match");
    assert(left_rows[0]["title"] == null, "Item title should be null for user with no items");

    // 5. Test count() with JOIN and WHERE condition
    let joined_count = DB.table("qb_join_items")
        .join("users", "qb_join_items.user_id", "=", "users.id")
        .where("users.id", "=", user_a_id)
        .count();
    assert(joined_count == 1, "Count with JOIN should return 1");

    // Teardown
    DB.table("users").where("id", "=", user_a_id).delete();
    DB.table("users").where("id", "=", user_b_id).delete();
    Schema.dropIfExists("qb_join_items");
    println("  [PASS] test_query_builder_joins_execution");
}

fn test_database_busy_timeout() {
    // PRAGMA is a SQLite concept — skip on server drivers
    if DB.driver_name() != "sqlite" {
        println("  [SKIP] test_database_busy_timeout (driver: " + DB.driver_name() + ")");
        return;
    }
    let conn = DB.connection();
    let rows = conn.query("PRAGMA busy_timeout;");
    assert(rows.len() > 0, "PRAGMA busy_timeout should return at least one row");
    assert(int(rows[0]["timeout"]) == 5000, "busy_timeout should be 5000 ms");
    println("  [PASS] test_database_busy_timeout");
}

fn main() {
    println("\n=== Running QueryBuilder Test Suite ===");
    test_query_builder_crud();
    test_query_builder_joins_sql();
    test_query_builder_joins_execution();
    test_database_busy_timeout();
    DB.close();
    println("=== All QueryBuilder Tests Passed! ===\n");
    return 0;
}
