// tests/run_all.matrix
// Spid3rWeb Complete Test Suite Runner (delegates to framework/Console/TestRunner)

import "framework/Console/TestRunner";

fn main() {
    let root = "";
    if file_exists("framework") {
        env_set("SPID3R_PATH", ".");
    } elif file_exists("examples/spid3r_web/framework") {
        env_set("SPID3R_PATH", "examples/spid3r_web");
        root = "examples/spid3r_web/";
    }

    let runner = new TestRunner(root);
    return runner.run(args());
}
