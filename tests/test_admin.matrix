// tests/test_admin.matrix
// Automated Test Suite for the Admin Panel
// Covers: admin gate (guest -> 302 login, customer -> 403, admin -> 200),
// product create (auto-slug + dedupe), product update (+input validation),
// product delete, order status transitions (whitelist) and order views.

import "framework/Application";
import "framework/Database/DB";
import "framework/Auth/Hash";
import "routes/web";
import "app/Middleware/AdminMiddleware";
import "app/Support/CartService";

fn extract_cookie(res, name: string) -> string {
    if res == null or not res.has("headers") {
        return "";
    }
    if not res["headers"].has("set-cookie") {
        return "";
    }
    let sc = string(res["headers"]["set-cookie"]);
    for part in sc.split(";") {
        // set-cookie may hold multiple cookies comma-joined; take the last
        // name=value segment matching our cookie across all of them.
        for piece in part.split(",") {
            let pair = piece.trim().split("=");
            if pair[0] == name and pair.len() > 1 {
                return pair[1].trim();
            }
        }
    }
    return "";
}

fn login_user(app, email: string, password: string) -> string {
    let body = "email=" + email + "&password=" + password;
    let res = app.handle_request(map(
        "method", "POST",
        "path", "/login",
        "headers", map("content-type", "application/x-www-form-urlencoded", "accept", "text/html"),
        "body", body
    ));
    assert(res["status"] == 302, "POST /login with valid credentials should redirect (got " + string(res["status"]) + ")");
    let token = extract_cookie(res, "spid3r_session");
    assert(token != "", "POST /login should issue a spid3r_session cookie");
    return token;
}

fn get(app, cookie: string, path: string) {
    let headers = map("accept", "text/html");
    if cookie != "" {
        headers["cookie"] = "spid3r_session=" + cookie;
    }
    return app.handle_request(map("method", "GET", "path", path, "headers", headers, "body", ""));
}

fn post(app, cookie: string, path: string, body: string) {
    let headers = map(
        "content-type", "application/x-www-form-urlencoded",
        "accept", "text/html"
    );
    if cookie != "" {
        headers["cookie"] = "spid3r_session=" + cookie;
    }
    return app.handle_request(map("method", "POST", "path", path, "headers", headers, "body", body));
}

// Authenticated cookie-session POSTs without an Origin header must carry
// the session's _csrf token (Application.csrf_valid). Pages render it as
// <input type="hidden" name="_csrf" value="..."> — grab it from any form.
fn extract_csrf(app, cookie: string, path: string) -> string {
    let res = get(app, cookie, path);
    let body = string(res["body"]);
    let marker = "name=\"_csrf\" value=\"";
    if not body.contains(marker) {
        return "";
    }
    let after = body.split(marker)[1];
    return after.split("\"")[0];
}

fn main() -> int {
    println("\n==================================================================");
    println("                Admin Panel Test Suite (R-Admin)                  ");
    println("==================================================================");

    let app = new Application();
    app.middleware("admin", fn(_args) { return new AdminMiddleware(); });
    register_web_routes();

    // -- Fixture: unique admin + customer + order (timestamped emails) --
    let stamp = string(unix_time());
    let admin_email = "admin_" + stamp + "@test.local";
    let cust_email = "cust_" + stamp + "@test.local";
    let now = string(unix_time());
    let pw = Hash.make("pass12345");

    DB.table("users").insert(map(
        "name", "Test Admin", "email", admin_email, "password", pw,
        "is_admin", 1, "created_at", now, "updated_at", now
    ));
    DB.table("users").insert(map(
        "name", "Plain Customer", "email", cust_email, "password", pw,
        "is_admin", 0, "created_at", now, "updated_at", now
    ));

    // ------------------------------------------------------------------
    // Phase 1: Admin gate
    // ------------------------------------------------------------------
    println("--- Testing Admin Gate ---");

    let res_guest = get(app, "", "/admin");
    assert(res_guest["status"] == 302, "Guest GET /admin should redirect (got " + string(res_guest["status"]) + ")");
    assert(string(res_guest["headers"]["location"]) == "/login", "Guest GET /admin should redirect to /login");
    println("  [PASS] Guest GET /admin -> 302 /login");

    let cust_token = login_user(app, cust_email, "pass12345");
    let res_cust = get(app, cust_token, "/admin");
    assert(res_cust["status"] == 403, "Non-admin GET /admin should be 403 (got " + string(res_cust["status"]) + ")");
    println("  [PASS] Customer GET /admin -> 403 Forbidden");

    // Authenticated users get 302'd away from /login, so pull the
    // customer's CSRF token straight from the sessions row (Auth stores
    // it in the payload column).
    let cust_sess = DB.table("sessions").where("token", "=", cust_token).first();
    assert(cust_sess != null, "Login should create a sessions row");
    let cust_csrf = string(cust_sess["payload"]);
    assert(cust_csrf != "", "Sessions payload should carry the CSRF token");
    let res_cust_post = post(app, cust_token, "/admin/products",
        "name=Hack&category=X&price=1&stock=1&_csrf=" + cust_csrf);
    assert(res_cust_post["status"] == 403, "Non-admin POST /admin/products should be 403 (got " + string(res_cust_post["status"]) + ")");
    let hacked = DB.table("products").where("name", "=", "Hack").first();
    assert(hacked == null, "Non-admin product creation must not persist");
    println("  [PASS] Customer POST /admin/products -> 403, nothing persisted");

    let admin_token = login_user(app, admin_email, "pass12345");
    let res_admin = get(app, admin_token, "/admin");
    assert(res_admin["status"] == 200, "Admin GET /admin should be 200 (got " + string(res_admin["status"]) + ")");
    assert(string(res_admin["body"]).contains("Admin Dashboard"), "Dashboard should render");
    println("  [PASS] Admin GET /admin -> 200 Dashboard");

    // Session CSRF token for no-Origin form POSTs (defense-in-depth layer 2)
    let csrf = extract_csrf(app, admin_token, "/admin/products/create");
    assert(csrf != "", "Admin pages should render the session CSRF token");

    // ------------------------------------------------------------------
    // Phase 2: Product create (auto-slug + duplicate dedupe)
    // ------------------------------------------------------------------
    println("--- Testing Product Create ---");

    let res_create = post(app, admin_token, "/admin/products",
        "name=AdminWidget&category=Gadgets&price=999&stock=7&emoji=&slug=&description=Admin+made&old_price=&_csrf=" + csrf);
    assert(res_create["status"] == 302, "POST /admin/products should redirect on success");
    assert(string(res_create["headers"]["location"]) == "/admin/products", "Successful create redirects to /admin/products");

    let p1 = DB.table("products").where("slug", "=", "adminwidget").first();
    assert(p1 != null, "Product should be created with auto-slug from name");
    assert(string(p1["emoji"]) == "📦", "Empty emoji should default to the box emoji");
    assert(int(p1["stock"]) == 7 and int(p1["price"]) == 999, "Product fields should persist");
    println("  [PASS] POST /admin/products -> created (auto slug, emoji default)");

    post(app, admin_token, "/admin/products",
        "name=AdminWidget&category=Gadgets&price=500&stock=3&emoji=&slug=&description=&old_price=&_csrf=" + csrf);
    let p2 = DB.table("products").where("slug", "=", "adminwidget-2").first();
    assert(p2 != null, "Duplicate name should get slug adminwidget-2");
    println("  [PASS] Duplicate name -> unique slug (adminwidget-2)");

    let res_bad = post(app, admin_token, "/admin/products", "name=&category=Gadgets&price=10&stock=1&_csrf=" + csrf);
    assert(res_bad["status"] == 302, "Invalid product (no name) should redirect, not 500");
    assert(string(res_bad["headers"]["location"]).contains("error="), "Invalid create should redirect back with error");
    println("  [PASS] Invalid input -> redirect with error message");

    let res_bad_price = post(app, admin_token, "/admin/products", "name=NoPrice&category=Gadgets&price=zero&stock=1&_csrf=" + csrf);
    assert(res_bad_price["status"] == 302, "Non-numeric price should redirect, not 500");
    println("  [PASS] Non-numeric price rejected safely");

    // ------------------------------------------------------------------
    // Phase 3: Product update + edit form
    // ------------------------------------------------------------------
    println("--- Testing Product Update ---");

    let pid = int(p1["id"]);
    let res_form = get(app, admin_token, "/admin/products/" + string(pid) + "/edit");
    assert(res_form["status"] == 200, "GET edit form should be 200");
    assert(string(res_form["body"]).contains("AdminWidget"), "Edit form should be prefilled");

    let res_update = post(app, admin_token, "/admin/products/" + string(pid),
        "name=AdminWidget+Pro&category=Gadgets&price=1200&stock=4&emoji=🛠&slug=&description=&old_price=1500&_csrf=" + csrf);
    assert(res_update["status"] == 302, "POST update should redirect on success");
    let p1b = DB.table("products").where("id", "=", pid).first();
    assert(string(p1b["name"]) == "AdminWidget Pro", "Update should persist name");
    assert(int(p1b["price"]) == 1200 and int(p1b["stock"]) == 4, "Update should persist price/stock");
    println("  [PASS] POST /admin/products/:id -> fields updated");

    let res_u404 = post(app, admin_token, "/admin/products/999999",
        "name=Ghost&category=X&price=1&stock=1&_csrf=" + csrf);
    assert(res_u404["status"] == 302, "Update of missing product should redirect safely");
    assert(string(res_u404["headers"]["location"]) == "/admin/products", "Missing product update redirects to list");
    println("  [PASS] Update missing product -> safe redirect");

    // ------------------------------------------------------------------
    // Phase 4: Order management (list, detail, status whitelist)
    // ------------------------------------------------------------------
    println("--- Testing Order Management ---");

    let items_json = "[{\"product\":{\"name\":\"AdminWidget Pro\",\"emoji\":\"🛠\",\"price\":1200},\"qty\":2}]";
    DB.table("orders").insert(map(
        "customer_name", "Admin Test Buyer",
        "phone", "01700000000",
        "address", "1 Test Street, Dhaka",
        "items_json", items_json,
        "total", 2400,
        "status", "pending",
        "user_id", null,
        "created_at", now,
        "updated_at", now
    ));
    let order_row = DB.table("orders").where("customer_name", "=", "Admin Test Buyer").first();
    assert(order_row != null, "Test order fixture should insert");
    let oid = int(order_row["id"]);

    let res_olist = get(app, admin_token, "/admin/orders");
    assert(res_olist["status"] == 200, "GET /admin/orders should be 200");
    assert(string(res_olist["body"]).contains("Admin Test Buyer"), "Order list should contain the fixture order");

    let res_ofilter = get(app, admin_token, "/admin/orders?status=pending");
    assert(res_ofilter["status"] == 200, "Filtered order list should be 200");
    assert(string(res_ofilter["body"]).contains("Admin Test Buyer"), "Pending filter should include pending order");
    println("  [PASS] GET /admin/orders (+status filter) -> 200 with rows");

    let res_odetail = get(app, admin_token, "/admin/orders/" + string(oid));
    assert(res_odetail["status"] == 200, "GET /admin/orders/:id should be 200");
    assert(string(res_odetail["body"]).contains("AdminWidget Pro"), "Order detail should render decoded items");
    assert(string(res_odetail["body"]).contains("01700000000"), "Order detail should render customer contact");
    println("  [PASS] GET /admin/orders/:id -> 200 with items + customer");

    let res_ship = post(app, admin_token, "/admin/orders/" + string(oid) + "/status", "status=shipped&_csrf=" + csrf);
    assert(res_ship["status"] == 302, "Valid status change should redirect");
    let o2 = DB.table("orders").where("id", "=", oid).first();
    assert(string(o2["status"]) == "shipped", "Status should update to shipped");
    println("  [PASS] POST status=shipped -> persisted");

    let res_bad_status = post(app, admin_token, "/admin/orders/" + string(oid) + "/status", "status=teleported&_csrf=" + csrf);
    assert(res_bad_status["status"] == 302, "Invalid status should redirect, not 500");
    let o3 = DB.table("orders").where("id", "=", oid).first();
    assert(string(o3["status"]) == "shipped", "Invalid status must NOT change the order");
    println("  [PASS] Invalid status rejected (whitelist enforced)");

    // ------------------------------------------------------------------
    // Phase 5: Product delete
    // ------------------------------------------------------------------
    println("--- Testing Product Delete ---");

    let res_del = post(app, admin_token, "/admin/products/" + string(pid) + "/delete", "_csrf=" + csrf);
    assert(res_del["status"] == 302, "Delete should redirect");
    let gone = DB.table("products").where("id", "=", pid).first();
    assert(gone == null, "Deleted product should be gone from the database");
    println("  [PASS] POST /admin/products/:id/delete -> row removed");

    // ------------------------------------------------------------------
    // Cleanup: remove fixture rows
    // ------------------------------------------------------------------
    DB.table("products").where("slug", "=", "adminwidget").delete();
    DB.table("products").where("slug", "=", "adminwidget-2").delete();
    DB.table("orders").where("id", "=", oid).delete();
    DB.table("users").where("email", "=", admin_email).delete();
    DB.table("users").where("email", "=", cust_email).delete();

    DB.close();

    println("==================================================================");
    println("  [SUCCESS] All Admin Panel Test Scenarios Passed!                ");
    println("==================================================================\n");
    return 0;
}
