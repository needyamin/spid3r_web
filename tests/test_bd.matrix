// tests/test_bd.matrix
// Unit tests for Spid3rWeb SpiderBD Template Engine (.bd.html)

import "framework/View/BD";
import "app/Models/Product";

fn test_html_escape() {
    let raw = "<script>alert('xss & dangerous')</script>";
    let escaped = html_escape(raw);
    assert(not escaped.contains("<script>"), "Tags should be escaped");
    assert(escaped.contains("&lt;script&gt;"), "&lt; should replace <");
    assert(escaped.contains("&amp;"), "&amp; should replace &");
    assert(html_escape(null) == "", "html_escape(null) should return empty string");
    println("  [PASS] test_html_escape");
}

fn test_bd_view_rendering() {
    let rendered = global_bd.render("home", map(
        "title", "Spid3r Bazaar - Online Shopping",
        "search_term", "",
        "cart_count", 2,
        "categories", list(map("name", "Electronics", "slug", "electronics"), map("name", "Fashion", "slug", "fashion")),
        "products", list(
            map(
                "id", 1,
                "name", "Wireless Noise-Canceling Headphones",
                "emoji", "🎧",
                "price", 2490,
                "discount_html", "",
                "rating", 4.8,
                "sold", 167
            )
        )
    ));
    assert(rendered.contains("Spid3r Bazaar"), "Store title should be rendered");
    assert(rendered.contains("Electronics"), "Category chip should be rendered");
    assert(rendered.contains("Wireless Noise-Canceling Headphones"), "Product name should be rendered");
    assert(rendered.contains("/cart/add"), "Cart add form action should be present");
    println("  [PASS] test_bd_view_rendering");
}

fn test_auth_views_rendering() {
    let login_html = global_bd.render("auth.login", map(
        "title", "Sign In",
        "error", "Invalid credentials test"
    ));
    assert(login_html.contains("Sign In"), "Login title should be present");
    assert(login_html.contains("Invalid credentials test"), "Error banner should be rendered");

    let register_html = global_bd.render("auth.register", map(
        "title", "Register",
        "error", ""
    ));
    assert(register_html.contains("Create Account"), "Register heading should be present");
    println("  [PASS] test_auth_views_rendering");
}

fn test_dot_notation_and_nesting() {
    let t_view = "resources/views/test_nested.bd.html";
    let content = "<p>" + "{{" + " product.name " + "}}" + "</p>" +
                  "<span>" + "{{" + " $product.brand.name " + "}}" + "</span>" +
                  "<div>" + "{!!" + " product.meta.raw_badge " + "!!}" + "</div>";
    write_file(t_view, content);

    let rendered = global_bd.render("test_nested", map(
        "product", map(
            "name", "Modern SpiderBD Engine",
            "brand", map("name", "Ada Lovelace"),
            "meta", map("raw_badge", "<span class='badge'>Verified</span>")
        )
    ));
    file_delete(t_view);

    assert(rendered.contains("<p>Modern SpiderBD Engine</p>"), "1-level dot notation must resolve");
    assert(rendered.contains("<span>Ada Lovelace</span>"), "2-level deep nesting with $ prefix must resolve");
    assert(rendered.contains("<span class='badge'>Verified</span>"), "Raw tag with nested dot notation must not escape HTML");
    println("  [PASS] test_dot_notation_and_nesting");
}

fn test_whitespace_tolerance() {
    let t_view = "resources/views/test_ws.bd.html";
    let content = "1:" + "{{" + "$name" + "}}" + " " +
                  "2:" + "{{" + " $name " + "}}" + " " +
                  "3:" + "{{" + "  $name  " + "}}" + " " +
                  "4:" + "{{" + "name" + "}}" + " " +
                  "5:" + "{{" + " name " + "}}" + " " +
                  "6:" + "{!!" + "$raw" + "!!}" + " " +
                  "7:" + "{!!" + " $raw " + "!!}";
    write_file(t_view, content);

    let rendered = global_bd.render("test_ws", map(
        "name", "Spid3r",
        "raw", "<b>OK</b>"
    ));
    file_delete(t_view);

    assert(rendered.contains("1:Spid3r 2:Spid3r 3:Spid3r 4:Spid3r 5:Spid3r 6:<b>OK</b> 7:<b>OK</b>"),
        "Template tags with zero, single, or multiple spaces must resolve identically");
    println("  [PASS] test_whitespace_tolerance");
}

fn test_null_safety_and_missing_properties() {
    let t_view = "resources/views/test_null_safe.bd.html";
    let content = "A:[" + "{{" + " missing_var " + "}}" + "] " +
                  "B:[" + "{{" + " product.missing_prop " + "}}" + "] " +
                  "C:[" + "{{" + " product.brand.name " + "}}" + "] " +
                  "D:[" + "{{" + " count " + "}}" + "]";
    write_file(t_view, content);

    let rendered = global_bd.render("test_null_safe", map(
        "product", map("id", 1, "brand", null),
        "count", 0
    ));
    file_delete(t_view);

    assert(rendered.contains("A:[]"), "Missing root variable should resolve to empty string");
    assert(rendered.contains("B:[]"), "Missing property on map should resolve to empty string");
    assert(rendered.contains("C:[]"), "Null intermediate property should resolve to empty string without crash");
    assert(rendered.contains("D:[0]"), "Numeric zero must interpolate as '0'");
    println("  [PASS] test_null_safety_and_missing_properties");
}

fn test_model_dot_notation() {
    let product = new Product(map(
        "name", "Mechanical Keyboard",
        "category", "Peripherals",
        "stock", 100
    ));

    let t_view = "resources/views/test_model.bd.html";
    let content = "<h1>" + "{{" + " product.name " + "}}" + "</h1>" +
                  "<span>" + "{{" + " product.category " + "}}" + "</span>" +
                  "<small>" + "{{" + " product.stock " + "}}" + "</small>";
    write_file(t_view, content);

    let rendered = global_bd.render("test_model", map("product", product));
    file_delete(t_view);

    assert(rendered.contains("<h1>Mechanical Keyboard</h1>"), "Model name attribute must resolve");
    assert(rendered.contains("<span>Peripherals</span>"), "Model category attribute must resolve");
    assert(rendered.contains("<small>100</small>"), "Model integer attribute must resolve");
    println("  [PASS] test_model_dot_notation");
}

fn test_store_show_and_index_views() {
    // Test store.show
    let rendered_show = global_bd.render("store.show", map(
        "product", map(
            "id", 99,
            "name", "Architecture Patterns Book",
            "slug", "architecture-patterns",
            "description", "Building scalable Spid3r web apps.",
            "category", "Books",
            "emoji", "📚",
            "price", 49.99,
            "discount_html", "",
            "stock", 250,
            "sold", 10,
            "rating", 4.9
        ),
        "related", list()
    ));
    assert(rendered_show.contains("Architecture Patterns Book"), "Product name should resolve in store.show view");
    assert(rendered_show.contains("Books"), "Product category should resolve in store.show view");
    assert(rendered_show.contains("250 in stock"), "Product stock count should resolve in store.show view");
    assert(rendered_show.contains("/cart/add"), "Cart add form action should be present");

    // Test store.index
    let rendered_index = global_bd.render("store.index", map(
        "categories", list(map("name", "Books", "slug", "books"), map("name", "Electronics", "slug", "electronics")),
        "search_term", "",
        "products", list(
            map(
                "id", 99,
                "name", "Architecture Patterns Book",
                "emoji", "📚",
                "price", 49.99,
                "discount_html", "",
                "rating", 4.9,
                "sold", 10
            )
        )
    ));
    assert(rendered_index.contains("Architecture Patterns Book"), "Product name should populate store index");
    assert(rendered_index.contains("Books"), "Category chip should be present");
    assert(rendered_index.contains("/cart/add"), "Cart add form action should be present");
    println("  [PASS] test_store_show_and_index_views");
}

fn test_nested_conditionals_in_skipped_block() {
    // Regression: nested @if inside a @foreach inside a SKIPPED @if used to
    // escape the non-nesting evaluator, leaking raw fragments + literal
    // @endif into the rendered page.
    let t_view = "resources/views/test_nested_skip.bd.html";
    let content = "@if(not items)\n" +
                  "<p>empty-state</p>\n" +
                  "@endif\n" +
                  "@if(items)\n" +
                  "<ul>\n" +
                  "@foreach(it in items)\n" +
                  "<li>{{ it.name }}</li>\n" +
                  "@if(it.flag)\n" +
                  "<em>flagged</em>\n" +
                  "@endif\n" +
                  "@endforeach\n" +
                  "</ul>\n" +
                  "@endif\n" +
                  "@if(not items)\n" +
                  "<p>stray-endif-guard</p>\n" +
                  "@endif";
    write_file(t_view, content);

    let rendered_empty = global_bd.render("test_nested_skip", map("items", list()));
    file_delete(t_view);

    assert(rendered_empty.contains("empty-state"), "Empty state must render when list is empty");
    assert(not rendered_empty.contains("@endif"), "Literal @endif must never leak into output");
    assert(not rendered_empty.contains("@foreach"), "Literal @foreach must never leak into output");
    assert(not rendered_empty.contains("<li>"), "Loop body must not render when list is empty");
    assert(not rendered_empty.contains("flagged"), "Nested conditional content must not leak from skipped block");
    println("  [PASS] test_nested_conditionals_in_skipped_block");
}

fn test_conditional_on_loop_variable() {
    // Per-iteration scope: @if on a loop variable must evaluate per item
    // (dot-path conditions inside loops).
    let t_view = "resources/views/test_loop_if.bd.html";
    let content = "@foreach(u in users)\n" +
                  "<div>{{ u.name }}</div>\n" +
                  "@if(u.admin)\n" +
                  "<b>staff</b>\n" +
                  "@endif\n" +
                  "@if(not u.admin)\n" +
                  "<i>customer</i>\n" +
                  "@endif\n" +
                  "@endforeach";
    write_file(t_view, content);

    let rendered = global_bd.render("test_loop_if", map(
        "users", list(
            map("name", "Ada", "admin", 1),
            map("name", "Bob", "admin", 0)
        )
    ));
    file_delete(t_view);

    assert(rendered.contains("<div>Ada</div>"), "Loop variable interpolation must work");
    assert(rendered.contains("<b>staff</b>"), "Truthiness on loop var (admin=1) must render staff");
    assert(not rendered.contains("<i>customer</i>") or not rendered.contains("<div>Ada</div><i>customer</i>"), "staff row must not show customer tag");
    assert(rendered.contains("<i>customer</i>"), "Non-admin row must show customer tag");
    assert(not rendered.contains("@if("), "Directive lines must be consumed");
    println("  [PASS] test_conditional_on_loop_variable");
}

fn main() {
    println("\n=== Running SpiderBD Test Suite ===");
    test_html_escape();
    test_bd_view_rendering();
    test_auth_views_rendering();
    test_dot_notation_and_nesting();
    test_whitespace_tolerance();
    test_null_safety_and_missing_properties();
    test_model_dot_notation();
    test_store_show_and_index_views();
    test_nested_conditionals_in_skipped_block();
    test_conditional_on_loop_variable();
    println("=== All SpiderBD Tests Passed! ===\n");
}
