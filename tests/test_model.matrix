// tests/test_model.matrix
// Unit tests for Spid3rWeb Active Record Models

import "app/Models/User";
import "app/Models/Product";
import "framework/Database/DB";

fn test_user_product_models() {
    let now = string(unix_time());

    // 1. Create User
    let user = UserModel.create(map(
        "name", "Linus Torvalds",
        "email", "linus_" + now + "@kernel.org",
        "password", "secret_git"
    ));
    assert(user != null, "User should be created");
    assert(user.get("id") != null, "User should have id");
    let uid = int(user.get("id"));

    // 2. Find User
    let found_user = UserModel.find(uid);
    assert(found_user != null, "UserModel.find should return user");
    assert(found_user.get("name") == "Linus Torvalds", "User name should match");

    // 3. Create Product
    let product = ProductModel.create(map(
        "name", "Git Pro Mechanical Keyboard",
        "slug", "git-pro-keyboard-" + now,
        "description", "Custom tactile mechanical keyboard for kernel hackers.",
        "category", "Peripherals",
        "emoji", "⌨️",
        "price", 149.99,
        "old_price", 199.99,
        "stock", 50,
        "sold", 12,
        "rating", 4.9
    ));
    assert(product != null, "Product should be created");
    assert(product.get("id") != null, "Product should have id");
    let pid = int(product.get("id"));

    // 4. Test Product attributes and finding
    let found_product = ProductModel.find(pid);
    assert(found_product != null, "ProductModel.find should return product");
    assert(found_product.get("name") == "Git Pro Mechanical Keyboard", "Product name should match");
    assert(found_product.get("category") == "Peripherals", "Product category should match");

    // 5. Update Product
    product.update(map("name", "Git Pro RGB Mechanical Keyboard", "stock", 45));
    let reloaded_product = ProductModel.find(pid);
    assert(reloaded_product.get("name") == "Git Pro RGB Mechanical Keyboard", "Updated name should match");
    assert(int(reloaded_product.get("stock")) == 45, "Updated stock should match");

    // 6. Clean up
    product.delete();
    user.delete();

    assert(ProductModel.find(pid) == null, "Product should be deleted");
    assert(UserModel.find(uid) == null, "User should be deleted");
    println("  [PASS] test_user_product_models");
}

fn test_modern_static_and_inheritance() {
    let now = string(unix_time());

    // 1. Test direct static method User.create and class inheritance
    let email = "ada_" + now + "@lovelace.org";
    let user = User.create({
        "name": "Ada Lovelace",
        "email": email,
        "password": "analytical_engine"
    });
    assert(user != null, "User.create should succeed");
    assert(user.get("name") == "Ada Lovelace", "user.get should work via Model inheritance");
    assert(user.model != null, "user.model property must exist for backward compatibility");
    let uid = int(user.get("id"));

    // 2. Test direct static method User.find & User.findByEmail
    let found = User.find(uid);
    assert(found != null, "User.find should locate user");
    assert(found.get("name") == "Ada Lovelace", "Found user name should match");

    let found_by_email = User.findByEmail(email);
    assert(found_by_email != null, "User.findByEmail should locate user");
    assert(int(found_by_email.get("id")) == uid, "Found by email ID should match");

    // 3. Test direct static method Product.create and Product.findBySlug
    let slug = "first-edition-mouse-" + now;
    let product = Product.create({
        "name": "First Edition Precision Mouse",
        "slug": slug,
        "description": "Ergonomic precision mouse.",
        "category": "Peripherals",
        "emoji": "🖱️",
        "price": 59.99,
        "old_price": 79.99,
        "stock": 30,
        "sold": 5,
        "rating": 4.8
    });
    assert(product != null, "Product.create should succeed");
    let pid = int(product.get("id"));

    let found_slug = Product.findBySlug(slug);
    assert(found_slug != null, "Product.findBySlug should locate product");
    assert(found_slug.get("name") == "First Edition Precision Mouse", "Product name should match");

    // 4. Test Product.all()
    let all_products = Product.all();
    assert(all_products.len() > 0, "Product.all should return at least 1 product");

    // 5. Test User.all()
    let all_users = User.all();
    assert(all_users.len() > 0, "User.all should return at least 1 user");

    // 6. Test Model to_map()
    let prod_map = product.to_map();
    assert(prod_map.has("name"), "to_map should contain name");
    assert(prod_map["slug"] == slug, "to_map slug should match");

    // Teardown
    product.delete();
    user.delete();
    assert(User.find(uid) == null, "User should be deleted");
    assert(Product.find(pid) == null, "Product should be deleted");
    println("  [PASS] test_modern_static_and_inheritance");
}

fn main() {
    println("\n=== Running Model Test Suite ===");
    test_user_product_models();
    test_modern_static_and_inheritance();
    DB.close();
    println("=== All Model Tests Passed! ===\n");
    return 0;
}
