// tests/e2e/tier1_features_orm.matrix
// Tier 1: Feature Coverage for Database, ORM & Migrations (Features 4, 5, 6)

import "tests/e2e/test_helpers";
import "framework/Database/DB";
import "framework/Database/Schema";
import "framework/Database/Migration";
import "app/Models/User";
import "app/Models/Product";

fn unique_suffix() -> string {
    return string(unix_ms()) + "_" + string(random_int(1000, 9999));
}

fn main() {
    println("\n==================================================================");
    println("  Tier 1: Feature Coverage - ORM, Relations & DDL (F4, F5, F6)   ");
    println("==================================================================");

    let runner = new TestRunner("Tier 1: ORM & Migrations");

    // ------------------------------------------------------------------------
    // Feature 4: Active Record ORM CRUD & Queries
    // ------------------------------------------------------------------------

    runner.test("F4.1: QueryBuilder insert returns positive auto-increment ID", fn() {
        let suffix = unique_suffix();
        let user_id = DB.table("users").insert(map(
            "name", "E2E Insert User " + suffix,
            "email", "e2e_insert_" + suffix + "@example.com",
            "password", "hash_" + suffix,
            "created_at", string(unix_time()),
            "updated_at", string(unix_time())
        ));
        test_assert(user_id > 0, "Insert should return last_id > 0");

        // Teardown
        DB.table("users").where("id", "=", user_id).delete();
    });

    runner.test("F4.2: QueryBuilder find retrieves record by primary key", fn() {
        let suffix = unique_suffix();
        let name = "E2E Find User " + suffix;
        let user_id = DB.table("users").insert(map(
            "name", name,
            "email", "e2e_find_" + suffix + "@example.com",
            "password", "hash_" + suffix,
            "created_at", string(unix_time()),
            "updated_at", string(unix_time())
        ));

        let user = DB.table("users").find(user_id);
        test_assert_not_null(user, "find(id) should return inserted record");
        test_assert_eq(user["name"], name, "Retrieved user name must match inserted name");

        // Teardown
        DB.table("users").where("id", "=", user_id).delete();
    });

    runner.test("F4.3: QueryBuilder where clause filters matching records", fn() {
        let suffix = unique_suffix();
        let email = "e2e_where_" + suffix + "@example.com";
        let user_id = DB.table("users").insert(map(
            "name", "E2E Where User",
            "email", email,
            "password", "hash_" + suffix,
            "created_at", string(unix_time()),
            "updated_at", string(unix_time())
        ));

        let found = DB.table("users").where("email", "=", email).first();
        test_assert_not_null(found, "where query should find record");
        test_assert_eq(int(found["id"]), user_id, "Found record ID should match");

        // Teardown
        DB.table("users").where("id", "=", user_id).delete();
    });

    runner.test("F4.4: QueryBuilder update modifies record and returns affected count", fn() {
        let suffix = unique_suffix();
        let user_id = DB.table("users").insert(map(
            "name", "Before Update",
            "email", "e2e_update_" + suffix + "@example.com",
            "password", "hash_" + suffix,
            "created_at", string(unix_time()),
            "updated_at", string(unix_time())
        ));

        let affected = DB.table("users").where("id", "=", user_id).update(map("name", "After Update"));
        test_assert(affected > 0, "Update should return affected count > 0");

        let reloaded = DB.table("users").find(user_id);
        test_assert_eq(reloaded["name"], "After Update", "Updated record field should reflect new value");

        // Teardown
        DB.table("users").where("id", "=", user_id).delete();
    });

    runner.test("F4.5: QueryBuilder delete removes record from table", fn() {
        let suffix = unique_suffix();
        let user_id = DB.table("users").insert(map(
            "name", "To Delete",
            "email", "e2e_del_" + suffix + "@example.com",
            "password", "hash_" + suffix,
            "created_at", string(unix_time()),
            "updated_at", string(unix_time())
        ));

        let affected = DB.table("users").where("id", "=", user_id).delete();
        test_assert(affected > 0, "Delete should return affected count > 0");

        let after = DB.table("users").find(user_id);
        test_assert_null(after, "Deleted record should not be found");
    });

    // ------------------------------------------------------------------------
    // Feature 5: Active Record Model Lifecycle & Queries (ProductModel)
    // ------------------------------------------------------------------------

    runner.test("F5.1: ProductModel create persists record with slug", fn() {
        let suffix = unique_suffix();
        let slug = "product-" + suffix;
        let product = ProductModel.create(map(
            "name", "E2E Product " + suffix,
            "slug", slug,
            "description", "Product for model lifecycle test.",
            "category", "TestCat",
            "emoji", "📦",
            "price", 49.99,
            "stock", 20,
            "sold", 0,
            "rating", 4.5
        ));
        let pid = int(product.get("id"));
        test_assert(pid > 0, "Product create should persist with positive ID");

        let found = ProductModel.findBySlug(slug);
        test_assert_not_null(found, "ProductModel.findBySlug should find persisted product");
        test_assert_eq(found.get("name"), "E2E Product " + suffix, "Product name should match");

        // Teardown
        product.delete();
    });

    runner.test("F5.2: ProductModel find retrieves by primary key", fn() {
        let suffix = unique_suffix();
        let product = ProductModel.create(map(
            "name", "Find Product " + suffix,
            "slug", "find-prod-" + suffix,
            "description", "Testing find by ID.",
            "category", "TestCat",
            "emoji", "🔍",
            "price", 29.99,
            "stock", 10,
            "sold", 0,
            "rating", 5.0
        ));
        let pid = int(product.get("id"));

        let found = ProductModel.find(pid);
        test_assert_not_null(found, "ProductModel.find should resolve product by ID");
        test_assert_eq(found.get("name"), "Find Product " + suffix, "Product name should match");

        // Teardown
        product.delete();
    });

    runner.test("F5.3: ProductModel all retrieves list of active products", fn() {
        let suffix = unique_suffix();
        let p1 = ProductModel.create(map(
            "name", "Batch Prod 1 " + suffix,
            "slug", "b1-" + suffix,
            "description", "Batch 1",
            "category", "TestCat",
            "emoji", "1️⃣",
            "price", 10.0,
            "stock", 5,
            "sold", 0,
            "rating", 4.0
        ));
        let p2 = ProductModel.create(map(
            "name", "Batch Prod 2 " + suffix,
            "slug", "b2-" + suffix,
            "description", "Batch 2",
            "category", "TestCat",
            "emoji", "2️⃣",
            "price", 20.0,
            "stock", 5,
            "sold", 0,
            "rating", 4.0
        ));

        let all_prods = ProductModel.all();
        test_assert_gte(all_prods.len(), 2, "ProductModel.all() should return 2 or more products");

        // Teardown
        p1.delete();
        p2.delete();
    });

    runner.test("F5.4: ProductModel find with non-existent ID returns null", fn() {
        let missing = ProductModel.find(-99999);
        test_assert_null(missing, "ProductModel.find(-99999) should return null");
    });

    runner.test("F5.5: Deleting model removes record from database", fn() {
        let suffix = unique_suffix();
        let product = ProductModel.create(map(
            "name", "Ephemeral Product " + suffix,
            "slug", "ephemeral-" + suffix,
            "description", "Will be deleted immediately.",
            "category", "TestCat",
            "emoji", "💨",
            "price", 15.0,
            "stock", 1,
            "sold", 0,
            "rating", 4.0
        ));
        let pid = int(product.get("id"));

        test_assert_not_null(ProductModel.find(pid), "Product should exist before delete");
        product.delete();
        test_assert_null(ProductModel.find(pid), "Product should not exist after delete");
    });

    // ------------------------------------------------------------------------
    // Feature 6: Database Migrations & DDL
    // ------------------------------------------------------------------------

    runner.test("F6.1: Schema.create and Schema.dropIfExists lifecycle", fn() {
        let temp_table = "test_table_" + unique_suffix();

        Schema.create(temp_table, fn(table) {
            table.id();
            table.string("title");
            table.text("body");
            table.integer("views");
            table.boolean("active");
            table.timestamps();
        });

        // Insert row to verify table was created
        let ins_id = DB.table(temp_table).insert(map(
            "title", "Test Title",
            "body", "Test Body",
            "views", 5,
            "active", 1,
            "created_at", string(unix_time()),
            "updated_at", string(unix_time())
        ));
        test_assert(ins_id > 0, "Should be able to insert into created table");

        // Drop table
        Schema.dropIfExists(temp_table);

        // Verify dropped
        let dropped_ok = false;
        try {
            DB.table(temp_table).count();
        } catch (_e) {
            dropped_ok = true;
        }
        test_assert(dropped_ok, "Table should be inaccessible after dropIfExists");
    });

    runner.test("F6.2: Blueprint column definitions and constraints", fn() {
        let temp_table = "test_col_def_" + unique_suffix();

        Schema.create(temp_table, fn(table) {
            table.id();
            table.string("code").unique();
            table.string("desc").nullable();
            table.integer("priority").default(10);
        });

        let id1 = DB.table(temp_table).insert(map("code", "ALPHA"));
        test_assert(id1 > 0, "Insert with default and nullable should succeed");

        // Verify default value
        let row = DB.table(temp_table).find(id1);
        test_assert_eq(int(row["priority"]), 10, "Default priority should be 10");

        // Teardown
        Schema.dropIfExists(temp_table);
    });

    runner.test("F6.3: MigrationRunner inspects applied migrations table", fn() {
        let runner_instance = new MigrationRunner();
        let applied = runner_instance.get_applied();
        test_assert_not_null(applied, "Applied migrations map should not be null");
        // Core migrations (users, sessions, products, orders) should be recorded
        test_assert(applied.has("001_create_users_table"), "Should contain 001_create_users_table");
    });

    runner.test("F6.4: MigrationRunner next batch calculation", fn() {
        let runner_instance = new MigrationRunner();
        let next_batch = runner_instance.get_next_batch();
        test_assert_gte(next_batch, 1, "Next batch number should be at least 1");
    });

    runner.test("F6.5: MigrationRunner migrate is idempotent on up-to-date db", fn() {
        let runner_instance = new MigrationRunner();
        let empty_list = list();
        let ran = runner_instance.migrate(empty_list);
        test_assert_eq(ran, 0, "Migrating with no new migrations should run 0 migrations");
    });

    let success = runner.summary();
    if not success {
        return 1;
    }
    return 0;
}
