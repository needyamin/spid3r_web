// tests/e2e/tier4_real_world.matrix
// Tier 4: Real-World Application Workflows (5 Comprehensive E2E Scenarios)

import "tests/e2e/test_helpers";
import "framework/Application";
import "framework/Router";
import "framework/Request";
import "framework/Response";
import "framework/Auth/Auth";
import "framework/Auth/Hash";
import "framework/Database/DB";
import "framework/View/BD";
import "framework/Console/ConsoleKernel";
import "framework/Middleware";
import "routes/web";
import "routes/api";
import "app/Models/User";
import "app/Models/Product";

fn unique_suffix() -> string {
    return string(unix_ms()) + "_" + string(random_int(1000, 9999));
}

fn extract_cookie_value(cookie_header: string, cookie_name: string) -> string {
    let parts = cookie_header.split(";");
    for p in parts {
        let pair = p.trim().split("=");
        if pair[0] == cookie_name and pair.len() > 1 {
            return pair[1].trim();
        }
    }
    return "";
}

fn main() {
    println("\n==================================================================");
    println("  Tier 4: Real-World Application Scenarios (5 Workflows)          ");
    println("==================================================================");

    let runner = new TestRunner("Tier 4: Real-World Scenarios");

    register_web_routes();
    register_api_routes();

    // ------------------------------------------------------------------------
    // Scenario 1: Complete User Registration & Login Session Flow
    // ------------------------------------------------------------------------
    runner.test("Scenario 1: Complete User Registration & Login Session Flow", fn() {
        let app = new Application();
        let suffix = unique_suffix();
        let test_name = "Ada Lovelace " + suffix;
        let test_email = "ada_" + suffix + "@example.com";
        let test_password = "SecretPassword123!";

        // Step 1: GET /register -> Render registration form
        let res_reg_form = app.handle_request(make_request("GET", "/register", map("accept", "text/html")));
        test_assert_eq(res_reg_form["status"], 200, "GET /register should return 200 OK");
        test_assert_contains(res_reg_form["body"], "Create Account", "Registration form should contain Create Account");

        // Step 2: POST /register with invalid email -> Validation failure
        let bad_payload = "name=" + test_name.replace(" ", "+") + "&email=not-an-email&password=" + test_password;
        let res_reg_bad = app.handle_request(make_request(
            "POST", "/register",
            map("content-type", "application/x-www-form-urlencoded"),
            bad_payload
        ));
        test_assert_contains(res_reg_bad["body"], "valid email", "Should display email validation error");

        // Step 3: POST /register with valid credentials -> Success & Session Cookie
        let good_payload = "name=" + test_name.replace(" ", "+") + "&email=" + test_email.replace("@", "%40") + "&password=" + test_password;
        let res_reg_ok = app.handle_request(make_request(
            "POST", "/register",
            map("content-type", "application/x-www-form-urlencoded"),
            good_payload
        ));
        test_assert_eq(res_reg_ok["status"], 302, "POST /register should redirect 302 on success");
        test_assert(res_reg_ok["headers"].has("set-cookie"), "Registration response should set session cookie");

        let cookie_header = res_reg_ok["headers"]["set-cookie"];
        test_assert_contains(cookie_header, "spid3r_session", "Cookie name should be spid3r_session");
        let session_token = extract_cookie_value(cookie_header, "spid3r_session");
        test_assert(session_token != "", "Extracted session token must not be empty");

        // Step 4: GET /login -> Render sign in form
        let res_login_form = app.handle_request(make_request("GET", "/login", map("accept", "text/html")));
        test_assert_eq(res_login_form["status"], 200, "GET /login should return 200 OK");
        test_assert_contains(res_login_form["body"], "Sign In", "Login page should contain Sign In");

        // Step 5: POST /login with valid credentials -> Success & Redirect
        let login_payload = "email=" + test_email.replace("@", "%40") + "&password=" + test_password;
        let res_login_ok = app.handle_request(make_request(
            "POST", "/login",
            map("content-type", "application/x-www-form-urlencoded"),
            login_payload
        ));
        test_assert_eq(res_login_ok["status"], 302, "POST /login should redirect 302 on success");
        test_assert(res_login_ok["headers"].has("set-cookie"), "Login response should set cookie");

        // Step 6: POST /register duplicate email -> Rejection
        let res_reg_dup = app.handle_request(make_request(
            "POST", "/register",
            map("content-type", "application/x-www-form-urlencoded"),
            good_payload
        ));
        test_assert_contains(res_reg_dup["body"], "already registered", "Duplicate email must be rejected");

        // Step 7: POST /logout -> Destroy session
        let res_logout = app.handle_request(make_request(
            "POST", "/logout",
            map("cookie", "spid3r_session=" + session_token)
        ));
        test_assert_eq(res_logout["status"], 302, "POST /logout should redirect 302");
        test_assert(not Auth.check(), "User must be logged out after POST /logout");

        // Teardown
        let created_user = UserModel.findByEmail(test_email);
        if created_user != null {
            created_user.delete();
        }
    });

    // ------------------------------------------------------------------------
    // Scenario 2: Product Catalog Browsing, Detail Rendering & Search Flow
    // ------------------------------------------------------------------------
    runner.test("Scenario 2: Product Catalog Browsing, Detail Rendering & Search Flow", fn() {
        let app = new Application();
        let suffix = unique_suffix();

        // Step 1: Create Store Product
        let prod_name = "Premium Wireless Headphones " + suffix;
        let prod_slug = "wireless-headphones-" + suffix;
        let product = ProductModel.create(map(
            "name", prod_name,
            "slug", prod_slug,
            "description", "High-fidelity wireless sound with active noise cancelling.",
            "category", "Audio",
            "emoji", "🎧",
            "price", 199.99,
            "old_price", 249.99,
            "stock", 50,
            "sold", 15,
            "rating", 4.8
        ));
        let pid = int(product.get("id"));
        test_assert(pid > 0, "Product should be persisted with positive ID");

        // Step 2: GET / -> Catalog index lists the storefront
        let res_list = app.handle_request(make_request("GET", "/", map("accept", "text/html")));
        test_assert_eq(res_list["status"], 200, "GET / should return 200 OK");
        test_assert_contains(res_list["body"], "Spid3r Bazaar", "Storefront home should contain Spid3r Bazaar");

        // Step 3: GET /product/:id -> Product detail page
        let res_detail = app.handle_request(make_request("GET", "/product/" + string(pid), map("accept", "text/html")));
        test_assert_eq(res_detail["status"], 200, "GET /product/:id should return 200 OK");
        test_assert_contains(res_detail["body"], prod_name, "Detail page should contain product name");
        test_assert_contains(res_detail["body"], "199.99", "Detail page should contain product price");

        // Step 4: Update Product attributes
        let updated_name = "Updated: " + prod_name;
        product.update(map("name", updated_name, "stock", 45));

        let reloaded = ProductModel.find(pid);
        test_assert_eq(reloaded.get("name"), updated_name, "Product name should be updated in DB");
        test_assert_eq(int(reloaded.get("stock")), 45, "Product stock should be updated in DB");

        // Step 5: Lookup by slug
        let by_slug = ProductModel.findBySlug(prod_slug);
        test_assert_not_null(by_slug, "Product should be found by slug");
        test_assert_eq(by_slug.get("name"), updated_name, "Slug lookup should return updated product");

        // Teardown
        product.delete();
        test_assert_null(ProductModel.find(pid), "Product should be removed from database");
    });

    // ------------------------------------------------------------------------
    // Scenario 3: REST API CRUD with JSON & Validation Errors
    // ------------------------------------------------------------------------
    runner.test("Scenario 3: REST API CRUD with JSON & Validation Errors", fn() {
        let app = new Application();
        let suffix = unique_suffix();
        let api_email = "api_user_" + suffix + "@example.com";

        // Step 1: GET /api/v1/status -> Health check
        let res_status = app.handle_request(make_request("GET", "/api/v1/status", map("accept", "application/json")));
        test_assert_eq(res_status["status"], 200, "API status should return 200 OK");
        test_assert_contains(res_status["body"], "healthy", "API status should be healthy");
        test_assert_contains(res_status["body"], "Spid3rWeb", "API should identify framework");

        // Step 2: POST /api/v1/login with bad credentials -> 401 Unauthorized
        let bad_login_body = "{\"email\":\"non_existent_" + suffix + "@example.com\",\"password\":\"wrong\"}";
        let res_bad_login = app.handle_request(map(
            "method", "POST",
            "path", "/api/v1/login",
            "headers", map("content-type", "application/json"),
            "body", bad_login_body
        ));
        test_assert_eq(res_bad_login["status"], 401, "Bad credentials must return 401 Unauthorized");

        // Step 3: POST /api/v1/register with validation failure (missing password) -> 422
        let bad_reg_body = "{\"name\":\"API Tester\",\"email\":\"invalid-email-address\"}";
        let res_bad_reg = app.handle_request(map(
            "method", "POST",
            "path", "/api/v1/register",
            "headers", map("content-type", "application/json"),
            "body", bad_reg_body
        ));
        test_assert_eq(res_bad_reg["status"], 422, "Invalid registration must return 422 Unprocessable");
    });

    // ------------------------------------------------------------------------
    // Scenario 4: Security Defenses
    // ------------------------------------------------------------------------
    runner.test("Scenario 4: Security Defenses", fn() {
        let app = new Application();

        // Defense 1: Directory traversal on static route
        let raw_trav = make_request("GET", "/css/../../spider.toml");
        let res_trav = app.handle_request(raw_trav);
        // Requirement: Must not serve the file
        test_assert(res_trav["status"] == 404 or res_trav["status"] == 400 or not string(res_trav["body"]).contains("name = \"spid3r_web\""),
            "Directory traversal attack must be defended");

        // Defense 2: Tampered / invalid session cookie
        Auth.clear();
        let auth_mw = new AuthMiddleware();
        let raw_tamper = make_request("GET", "/checkout/confirm", map("cookie", "spid3r_session=sess_forged_tampered_token_9999"));
        let res_tamper = auth_mw.handle(new Request(raw_tamper));
        test_assert_eq(res_tamper.status_code, 302, "Request with forged cookie should be redirected to login");
        test_assert(not Auth.check(), "Forged session token must not authenticate user");

        // Defense 3: Method mismatch handling
        let raw_verb = make_request("POST", "/api/v1/status");
        let res_verb = app.handle_request(raw_verb);
        test_assert(res_verb["status"] == 404 or res_verb["status"] == 405, "Mismatched method must return 404 or 405");

        // Defense 4: XSS prevention via html_escape
        let xss_input = "<script>alert('xss attack');</script>";
        let xss_escaped = html_escape(xss_input);
        test_assert(not xss_escaped.contains("<script>"), "XSS script tags must be escaped");
        test_assert_contains(xss_escaped, "&lt;script&gt;", "Escaped entities must replace brackets");

        // Defense 5: SQL injection defense in QueryBuilder
        let sql_inj = "' OR '1'='1";
        let inj_res = DB.table("users").where("email", "=", sql_inj).first();
        test_assert_null(inj_res, "Parameterized queries must prevent SQL injection");
    });

    // ------------------------------------------------------------------------
    // Scenario 5: CLI Workflow Lifecycle
    // ------------------------------------------------------------------------
    runner.test("Scenario 5: CLI Workflow Lifecycle", fn() {
        let kernel = new ConsoleKernel();

        // Step 1: CLI Help output
        let code_help = kernel.handle(list("help"));
        test_assert_eq(code_help, 0, "CLI help should execute successfully");

        // Step 2: Route listing output
        let code_routes = kernel.handle(list("route:list"));
        test_assert_eq(code_routes, 0, "CLI route:list should execute successfully");

        // Step 3: Migration status check
        let code_status = kernel.handle(list("migrate:status"));
        test_assert_eq(code_status, 0, "CLI migrate:status should execute successfully");

        // Step 4: Unknown command safety
        let code_bad = kernel.handle(list("non:existent:command"));
        test_assert_eq(code_bad, 1, "CLI should reject unknown commands with exit code 1");

        // Step 5: Package manifest verification
        test_assert(file_exists("spider.toml"), "spider.toml must be present for CLI project commands");
    });

    let success = runner.summary();
    if not success {
        return 1;
    }
    return 0;
}
