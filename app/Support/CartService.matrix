// app/Support/CartService.matrix
// Store cart state backed by the Cache facade.
// The visitor holds a `spid3r_cart` cookie token; the cart contents live in
// Cache under "cart:<token>" as a map of product_id -> qty.
//
// Security notes:
// - Tokens are validated against the server-issued format before use, so a
//   crafted cookie cannot pollute or collide with other cache keys.
// - count() is derived from items() so ghost entries (products deleted from
//   the catalog) never inflate the navbar badge.

import "framework/Cache/Cache";
import "framework/Database/DB";

public class CartService {
    fn new() {}

    // Read the cart token from the request cookie ("" when absent/invalid)
    public fn token(self, req) -> string {
        let cookies = req.header("cookie", "");
        for c in string(cookies).split(";") {
            let pair = c.trim().split("=");
            if pair[0] == "spid3r_cart" and pair.len() > 1 {
                let token = pair[1].trim();
                if self.valid_token(token) {
                    return token;
                }
                return "";
            }
        }
        return "";
    }

    // Server-issued tokens look like: cart_<24 hex chars>
    public fn valid_token(self, token: string) -> bool {
        if not token.starts_with("cart_") {
            return false;
        }
        let body = token.slice(5, token.len());
        if body.len() != 24 {
            return false;
        }
        let hex_chars = "0123456789abcdef";
        let body_lower = body.lower();
        let i = 0;
        while i < body_lower.len() {
            let ch = body_lower.slice(i, i + 1);
            if not hex_chars.contains(ch) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // Generate a fresh token and attach it to the response as a cookie
    public fn issue_token(self, res) {
        let token = "cart_" + hex_encode(random_bytes(12).unwrap());
        res.cookie("spid3r_cart", token, "/", 604800); // 7 days
        return token;
    }

    fn cache_key(self, token: string) -> string {
        return "cart:" + token;
    }

    // Raw cart data: map of "<product_id>" -> qty
    public fn data(self, token: string) {
        if token == "" or not self.valid_token(token) {
            return map();
        }
        return Cache.get(self.cache_key(token), map());
    }

    public fn save(self, token: string, data) {
        // Expire stale carts server-side (7 days, matching the cookie).
        // Without a TTL the cache would grow forever and orphaned carts
        // would never be reclaimed.
        Cache.put(self.cache_key(token), data, 604800);
        return true;
    }

    public fn clear(self, token: string) {
        Cache.forget(self.cache_key(token));
        return true;
    }

    // Total number of units in the cart (for the navbar badge).
    // Derived from items() so deleted products never inflate the count.
    public fn count(self, token: string) -> int {
        let total = 0;
        for item in self.items(token) {
            total = total + int(item["qty"]);
        }
        return total;
    }

    // Detailed line items: [{ product: {...}, qty, subtotal }]
    // Ghost entries (product no longer in catalog) are dropped and pruned
    // from the stored data so the cart self-heals.
    public fn items(self, token: string) {
        let out = [];
        let data = self.data(token);
        let prune = false;
        for k in data.keys() {
            let row = DB.table("products").where("id", int(k)).first();
            if row != null {
                let qty = int(data[k]);
                out.push(map(
                    "product", row,
                    "qty", qty,
                    "subtotal", int(row["price"]) * qty
                ));
            } else {
                prune = true;
            }
        }
        if prune and token != "" {
            let clean = map();
            for item in out {
                clean[string(item["product"]["id"])] = int(item["qty"]);
            }
            self.save(token, clean);
        }
        return out;
    }

    public fn total(self, token: string) -> int {
        let total = 0;
        for item in self.items(token) {
            total = total + int(item["subtotal"]);
        }
        return total;
    }
}
