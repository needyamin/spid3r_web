// app/Controllers/StoreController.matrix
// Storefront: product grid, search, category filter, product detail

import "framework/Controller";
import "framework/Response";
import "framework/Database/DB";
import "framework/Database/QueryBuilder";
import "app/Models/Product";
import "app/Support/CartService";
import "app/Support/Str";

public class StoreController extends Controller {
    fn new() {
        super();
    }

    // Decorate raw product rows with display fields the templates can output
    // directly (keeps template logic minimal).
    fn decorate(self, rows) {
        let out = [];
        for row in rows {
            let d = map();
            for k in row.keys() {
                d[k] = row[k];
            }
            let price = int(row["price"]);
            let old = row["old_price"];
            let discount_html = "";
            if old != null and int(old) > price and price > 0 {
                let pct = (100 * (int(old) - price)) / price;
                discount_html = "<span class='old-price'>৳" + string(old) + "</span>"
                    + "<span class='discount-badge'>-" + string(pct) + "%</span>";
            }
            d["discount_html"] = discount_html;
            out.push(d);
        }
        return out;
    }

    // GET /store  (optional ?search= & ?category=)
    public fn index(self, req) {
        let cart = new CartService();
        let cart_count = cart.count(cart.token(req));

        let search = req.string("search");
        let category = req.string("category");

        let q = DB.table("products");
        if search != "" {
            // Escape LIKE metacharacters so % and _ in user input are
            // treated literally, and group the OR so it can't leak past
            // the category filter.
            let like = "%" + sql_escape_like(search) + "%";
            q.whereGroup("AND", fn(g) {
                g.where("name", "LIKE", like).orWhere("description", "LIKE", like);
            });
        }
        if category != "" {
            q.where("category", "=", category);
        }
        let rows = q.orderBy("sold", "DESC").get();

        let cat_rows = DB.select("SELECT DISTINCT category FROM products ORDER BY category");
        // SEO: chips link to crawlable /category/{slug} URLs
        let categories = [];
        for r in cat_rows {
            categories.push(map(
                "name", string(r["category"]),
                "slug", Str.slug(string(r["category"]))
            ));
        }

        return self.render(req, "store.index", map(
            "title", "Spid3r Bazaar - Online Shopping",
            "meta_desc", "Shop electronics, fashion, home & kitchen and more at Spid3r Bazaar. Free delivery inside Dhaka, cash on delivery.",
            "products", self.decorate(rows),
            "categories", categories,
            "active_category", category,
            "search_term", search,
            "cart_count", cart_count
        ));
    }

    // GET /product/:id
    public fn show(self, req) {
        let cart = new CartService();
        let cart_count = cart.count(cart.token(req));

        // SEO-friendly URLs: /product/{slug} is canonical, but numeric
        // /product/{id} links keep working (backwards compatibility).
        let raw = string(req.input("id", "")).trim().lower();
        if raw == "" {
            return redirect("/");
        }

        let product = null;
        if Str.is_numeric(raw) {
            product = Product.find(int(raw));
        } else {
            product = Product.findBySlug(raw);
        }
        if product == null {
            return redirect("/");
        }

        // Related products from the same category
        let related_rows = DB.table("products")
            .where("category", "=", product.get("category"))
            .where("id", "!=", product.get("id"))
            .limit(4)
            .get();

        return self.render(req, "store.show", map(
            "title", product.get("name") + " - Spid3r Bazaar",
            "meta_desc", string(product.get("description")),
            "product", self.decorate([product.to_map()])[0],
            "related", self.decorate(related_rows),
            "cart_count", cart_count
        ));
    }

    // SEO-friendly category URL: /category/{slug} (e.g. /category/electronics)
    public fn category(self, req) {
        let cart = new CartService();
        let cart_count = cart.count(cart.token(req));

        let wanted = string(req.input("slug", "")).trim().lower();
        if wanted == "" {
            return redirect("/");
        }

        // Map the slug back to the stored category name (case-insensitive
        // via slug comparison — categories are free-form text).
        let cat_rows = DB.select("SELECT DISTINCT category FROM products ORDER BY category");
        let category = "";
        for r in cat_rows {
            if Str.slug(string(r["category"])) == wanted {
                category = string(r["category"]);
            }
        }
        if category == "" {
            return redirect("/");
        }

        let rows = DB.table("products")
            .where("category", "=", category)
            .orderBy("sold", "DESC")
            .get();

        let categories = [];
        for r in cat_rows {
            categories.push(map(
                "name", string(r["category"]),
                "slug", Str.slug(string(r["category"]))
            ));
        }

        return self.render(req, "store.index", map(
            "title", category + " - Spid3r Bazaar",
            "meta_desc", "Shop " + category + " at Spid3r Bazaar. Cash on delivery, free delivery inside Dhaka.",
            "products", self.decorate(rows),
            "categories", categories,
            "active_category", category,
            "search_term", "",
            "cart_count", cart_count
        ));
    }

    // /sitemap.xml — crawlable index of home, catalog, categories, products
    public fn sitemap(self, req) {
        let host = "http://" + string(req.header("host", "localhost"));
        let today = string(unix_time());

        let xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
        xml = xml + "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n";
        xml = xml + "  <url><loc>" + host + "/</loc><changefreq>daily</changefreq></url>\n";
        xml = xml + "  <url><loc>" + host + "/products</loc><changefreq>daily</changefreq></url>\n";

        let cat_rows = DB.select("SELECT DISTINCT category FROM products ORDER BY category");
        for r in cat_rows {
            xml = xml + "  <url><loc>" + host + "/category/" + Str.slug(string(r["category"])) + "</loc></url>\n";
        }

        let rows = DB.table("products").orderBy("id", "ASC").get();
        for p in rows {
            xml = xml + "  <url><loc>" + host + "/product/" + string(p["slug"]) + "</loc><lastmod>" + today + "</lastmod></url>\n";
        }
        xml = xml + "</urlset>";

        return self.respond(xml, "application/xml; charset=utf-8");
    }

    // /robots.txt — crawlable storefront, private areas excluded
    public fn robots(self, req) {
        let host = "http://" + string(req.header("host", "localhost"));
        let txt = "User-agent: *\n";
        txt = txt + "Allow: /\n";
        txt = txt + "Disallow: /admin\n";
        txt = txt + "Disallow: /cart\n";
        txt = txt + "Disallow: /checkout\n";
        txt = txt + "Disallow: /orders\n";
        txt = txt + "Disallow: /login\n";
        txt = txt + "Disallow: /register\n";
        txt = txt + "Disallow: /logout\n";
        txt = txt + "Sitemap: " + host + "/sitemap.xml\n";

        return self.respond(txt, "text/plain; charset=utf-8");
    }
}
