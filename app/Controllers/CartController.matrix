// app/Controllers/CartController.matrix
// Shopping cart (Cache-backed via CartService) & checkout.
// Mutations return JSON for AJAX requests (no page reload) and redirect
// otherwise — the storefront stays fully functional without JavaScript.
//
// Inventory integrity: every mutation validates the product exists and caps
// quantities at available stock; checkout re-validates against live stock
// before the order is created (no negative stock, no inflated orders).

import "framework/Controller";
import "framework/Response";
import "framework/View/BD";
import "framework/Auth/Auth";
import "framework/Database/DB";
import "app/Models/Order";
import "app/Models/Product";
import "app/Support/CartService";

public class CartController extends Controller {
    fn new() {
        super();
    }

    fn is_ajax(self, req) -> bool {
        return req.header("x-requested-with", "") == "XMLHttpRequest";
    }

    // POST /cart/add  (product_id, qty)
    public fn add(self, req) {
        let cart = new CartService();
        let token = cart.token(req);
        let new_cookie = false;

        if token == "" {
            let probe = response("", 200);
            token = cart.issue_token(probe);
            new_cookie = true;
        }

        let pid = req.int("product_id", 0);
        let qty = req.int("qty", 1);
        if qty <= 0 {
            qty = 1;
        }

        // The product must exist
        let product = null;
        let pname = "";
        if pid > 0 {
            product = Product.find(pid);
            if product != null {
                pname = product.get("name");
            }
        }

        if product == null {
            if self.is_ajax(req) {
                return json(map(
                    "ok", false,
                    "message", "Product not found",
                    "cart_count", cart.count(token)
                ), 404);
            }
            return redirect("/");
        }

        // Cap the requested quantity at available stock
        let data = cart.data(token);
        let key = string(pid);
        let cur = 0;
        if data.has(key) {
            cur = int(data[key]);
        }
        let stock = int(product.get("stock"));
        let want = cur + qty;
        let message = "Added to cart";
        let ok = true;

        if stock <= 0 {
            ok = false;
            message = "Sorry — " + pname + " is out of stock";
            qty = 0;
        } elif want > stock {
            ok = false;
            qty = stock - cur;
            if qty < 0 {
                qty = 0;
            }
            message = "Only " + string(stock) + " in stock — cart updated to maximum";
        }

        if qty > 0 {
            data[key] = cur + qty;
            cart.save(token, data);
        }

        let count = cart.count(token);
        if self.is_ajax(req) {
            let res = json(map(
                "ok", ok,
                "message", message,
                "cart_count", count
            ));
            if new_cookie {
                res.cookie("spid3r_cart", token, "/", 604800);
            }
            return res;
        }

        let res = redirect("/cart");
        if new_cookie {
            res.cookie("spid3r_cart", token, "/", 604800);
        }
        return res;
    }

    // GET /cart
    public fn index(self, req) {
        let cart = new CartService();
        let token = cart.token(req);

        // Prefill checkout fields for signed-in customers
        let customer_name = "";
        let auth = self.auth(req);
        if auth.check() {
            let user = auth.user();
            if user != null and user.has("name") {
                customer_name = string(user["name"]);
            }
        }

        return self.view("store.cart", self.shared(map(
            "title", "Your Cart - Spid3r Bazaar",
            "items", cart.items(token),
            "total", cart.total(token),
            "cart_count", cart.count(token),
            "error", "",
            "customer_name", customer_name,
            "phone", "",
            "address", ""
        ), req));
    }

    // POST /cart/update  (product_id, qty)
    public fn update(self, req) {
        let cart = new CartService();
        let token = cart.token(req);
        let count = 0;
        let total = 0;
        let ok = true;
        let message = "Cart updated";

        if token != "" {
            let pid = req.int("product_id", 0);
            let qty = req.int("qty", 1);
            let data = cart.data(token);
            let key = string(pid);

            if qty <= 0 {
                data.remove(key);
            } else {
                // Cap at available stock
                let product = Product.find(pid);
                if product == null {
                    data.remove(key);
                } else {
                    let stock = int(product.get("stock"));
                    if qty > stock {
                        qty = stock;
                        ok = false;
                        message = "Only " + string(stock) + " in stock — quantity capped";
                    }
                    data[key] = qty;
                }
            }
            cart.save(token, data);
            count = cart.count(token);
            total = cart.total(token);
        }

        if self.is_ajax(req) {
            return json(map(
                "ok", ok,
                "message", message,
                "cart_count", count,
                "total", total
            ));
        }
        return redirect("/cart");
    }

    // POST /cart/remove  (product_id)
    public fn remove(self, req) {
        let cart = new CartService();
        let token = cart.token(req);
        let count = 0;
        let total = 0;

        if token != "" {
            let data = cart.data(token);
            data.remove(string(req.int("product_id", 0)));
            cart.save(token, data);
            count = cart.count(token);
            total = cart.total(token);
        }

        if self.is_ajax(req) {
            return json(map(
                "ok", true,
                "message", "Removed from cart",
                "cart_count", count,
                "total", total
            ));
        }
        return redirect("/cart");
    }

    // POST /checkout  (customer_name, phone, address)
    public fn checkout(self, req) {
        let cart = new CartService();
        let token = cart.token(req);

        let items = cart.items(token);
        if items.len() == 0 {
            return redirect("/cart");
        }

        let customer_name = req.string("customer_name");
        let phone = req.string("phone");
        let address = req.string("address");

        let validator = req.validate(map(
            "customer_name", "required|min:3",
            "phone", "required|min:6",
            "address", "required|min:10"
        ));
        if validator.fails() {
            // Re-render the cart with the error summary and preserve form data
            return self.view("store.cart", self.shared(map(
                "title", "Your Cart - Spid3r Bazaar",
                "items", items,
                "total", cart.total(token),
                "cart_count", cart.count(token),
                "error", validator.error_summary(" · "),
                "customer_name", customer_name,
                "phone", phone,
                "address", address
            ), req));
        }

        // Re-validate every line against LIVE stock before creating the
        // order — protects inventory from stale/oversold carts.
        let stock_errors = [];
        for item in items {
            let live = Product.find(item["product"]["id"]);
            if live == null {
                stock_errors.push(item["product"]["name"] + " is no longer available");
            } elif int(item["qty"]) > int(live.get("stock")) {
                stock_errors.push(item["product"]["name"] + " — only "
                    + string(live.get("stock")) + " left in stock");
            }
        }
        if stock_errors.len() > 0 {
            return self.view("store.cart", self.shared(map(
                "title", "Your Cart - Spid3r Bazaar",
                "items", items,
                "total", cart.total(token),
                "cart_count", cart.count(token),
                "error", stock_errors.join(" · "),
                "customer_name", customer_name,
                "phone", phone,
                "address", address
            ), req));
        }

        // Snapshot the cart into the order; attach the customer account
        // when one is signed in (guest checkout stays supported).
        let total = cart.total(token);
        let auth = self.auth(req);
        let order_attrs = map(
            "customer_name", customer_name.trim(),
            "phone", phone.trim(),
            "address", address.trim(),
            "items_json", json_write(items),
            "total", total,
            "status", "pending"
        );
        if auth.check() {
            order_attrs["user_id"] = auth.id();
        }

        // Order creation + inventory movement happen in ONE database
        // transaction. Stock is decremented with a conditional UPDATE
        // (WHERE stock >= qty): if a concurrent checkout wins the race,
        // the update matches 0 rows, we throw, and the whole transaction
        // (order included) rolls back. No oversell, no lost order.
        let order = null;
        try {
            DB.transaction(fn() {
                let created = Order.create(order_attrs);
                for item in items {
                    let pid = item["product"]["id"];
                    let qty = int(item["qty"]);
                    let fresh = Product.find(pid);
                    if fresh == null or int(fresh.get("stock")) < qty {
                        throw "stock_changed:" + string(item["product"]["name"]);
                    }
                    let changes = DB.table("products")
                        .where("id", "=", pid)
                        .where("stock", ">=", qty)
                        .update(map(
                            "stock", int(fresh.get("stock")) - qty,
                            "sold", int(fresh.get("sold")) + qty
                        ));
                    if changes == 0 {
                        throw "stock_changed:" + string(item["product"]["name"]);
                    }
                }
                order = created;
                return true;
            });
        } catch (e) {
            let msg = string(e);
            if msg.contains("stock_changed") {
                let conflicted = msg.replace("stock_changed:", "");
                return self.view("store.cart", self.shared(map(
                    "title", "Your Cart - Spid3r Bazaar",
                    "items", items,
                    "total", cart.total(token),
                    "cart_count", cart.count(token),
                    "error", conflicted + " — stock changed while checking out. Please review your cart.",
                    "customer_name", customer_name,
                    "phone", phone,
                    "address", address
                ), req));
            }
            throw e;
        }

        cart.clear(token);

        return self.view("store.success", self.shared(map(
            "title", "Order Placed - Spid3r Bazaar",
            "order", order.to_map(),
            "cart_count", 0
        ), req));
    }
}
