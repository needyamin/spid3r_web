// app/Controllers/AdminController.matrix
// Admin panel: dashboard stats, product management (CRUD) and order
// management (list / detail / status transitions).
//
// Access control: every /admin route carries .middleware("admin") — the
// AdminMiddleware short-circuits guests (302 to /login) and non-admins
// (403) before any action runs.

import "framework/Controller";
import "framework/Response";
import "framework/View/BD";
import "framework/Database/DB";
import "app/Support/CartService";

public class AdminController extends Controller {
    fn new() {
        super();
    }

    // Order statuses in lifecycle order (drives dropdown + whitelist)
    fn statuses(self) {
        return list("pending", "processing", "shipped", "delivered", "cancelled");
    }

    // Display label for a status (BD templates cannot compare strings,
    // so presentation strings are always precomputed controller-side).
    fn status_label(self, status: string) -> string {
        let labels = map(
            "pending", "Pending",
            "processing", "Processing",
            "shipped", "Shipped",
            "delivered", "Delivered",
            "cancelled", "Cancelled"
        );
        if labels.has(status) {
            return labels[status];
        }
        return string(status);
    }

    // Bootstrap badge class for a status
    fn status_class(self, status: string) -> string {
        let classes = map(
            "pending", "bg-warning text-dark",
            "processing", "bg-info text-dark",
            "shipped", "bg-primary",
            "delivered", "bg-success",
            "cancelled", "bg-secondary"
        );
        if classes.has(status) {
            return classes[status];
        }
        return "bg-secondary";
    }

    // ------------------------------------------------------------------
    // Dashboard — GET /admin
    // ------------------------------------------------------------------
    public fn dashboard(self, req) {
        let cart = new CartService();

        let products_count = DB.table("products").count();
        let orders_count = DB.table("orders").count();
        let users_count = DB.table("users").count();

        // Net revenue: every order except cancelled ones
        let rev_rows = DB.select("SELECT COALESCE(SUM(total), 0) AS revenue FROM orders WHERE status != 'cancelled'");
        let revenue = 0;
        if rev_rows.len() > 0 {
            revenue = int(rev_rows[0]["revenue"]);
        }

        // Pending orders needing attention
        let pending_count = DB.table("orders").where("status", "=", "pending").count();

        // Low stock alert: 5 or fewer units left
        let low_stock = DB.table("products").where("stock", "<=", 5).orderBy("stock", "ASC").limit(5).get();

        // 8 most recent orders
        let recent = DB.table("orders").orderBy("id", "DESC").limit(8).get();

        return self.view("admin.dashboard", self.shared(map(
            "title", "Admin Dashboard - Spid3r Bazaar",
            "products_count", products_count,
            "orders_count", orders_count,
            "users_count", users_count,
            "revenue", revenue,
            "pending_count", pending_count,
            "low_stock", low_stock,
            "recent_orders", self.decorate_orders(recent),
            "cart_count", cart.count(cart.token(req))
        ), req));
    }

    // ------------------------------------------------------------------
    // Product list — GET /admin/products
    // ------------------------------------------------------------------
    public fn products(self, req) {
        let cart = new CartService();
        let rows = DB.table("products").orderBy("id", "ASC").get();

        return self.view("admin.products", self.shared(map(
            "title", "Manage Products - Spid3r Bazaar",
            "products", rows,
            "cart_count", cart.count(cart.token(req))
        ), req));
    }

    // ------------------------------------------------------------------
    // Product create — GET /admin/products/create, POST /admin/products
    // ------------------------------------------------------------------
    public fn create_form(self, req) {
        let cart = new CartService();

        // Blank product shape so the shared form template always finds its
        // keys (missing map keys must never reach the template).
        let blank = map(
            "id", 0,
            "name", "",
            "slug", "",
            "description", "",
            "price", "",
            "old_price", "",
            "category", "",
            "emoji", "",
            "stock", ""
        );

        return self.view("admin.product_form", self.shared(map(
            "title", "New Product - Spid3r Bazaar",
            "is_edit", false,
            "form_action", "/admin/products",
            "product", blank,
            "form_error", req.query("error", ""),
            "cart_count", cart.count(cart.token(req))
        ), req));
    }

    public fn store(self, req) {
        let check = self.validate_product_input(req, 0);
        if check.has("error") {
            return self.redirect("/admin/products/create?error=" + self.qs(check["error"]));
        }

        let name = string(check["name"]);
        let slug = self.slugify(name);
        if string(req.string("slug")).trim() != "" {
            slug = self.slugify(req.string("slug"));
        }
        slug = self.unique_slug(slug, 0);

        DB.table("products").insert(map(
            "name", name,
            "slug", slug,
            "description", string(check["description"]),
            "price", check["price"],
            "old_price", check["old_price"],
            "category", string(check["category"]),
            "emoji", string(check["emoji"]),
            "stock", check["stock"],
            "sold", 0,
            "rating", 0.0,
            "created_at", string(unix_time()),
            "updated_at", string(unix_time())
        ));

        return self.redirect("/admin/products");
    }

    // ------------------------------------------------------------------
    // Product edit — GET /admin/products/:id/edit, POST /admin/products/:id
    // ------------------------------------------------------------------
    public fn edit_form(self, req) {
        let cart = new CartService();
        let id = req.int("id", 0);
        let row = DB.table("products").where("id", "=", id).first();
        if row == null {
            return self.redirect("/admin/products");
        }

        return self.view("admin.product_form", self.shared(map(
            "title", "Edit Product - Spid3r Bazaar",
            "is_edit", true,
            "form_action", "/admin/products/" + string(id),
            "product", row,
            "form_error", req.query("error", ""),
            "cart_count", cart.count(cart.token(req))
        ), req));
    }

    public fn update(self, req) {
        let id = req.int("id", 0);
        let row = DB.table("products").where("id", "=", id).first();
        if row == null {
            return self.redirect("/admin/products");
        }

        let check = self.validate_product_input(req, id);
        if check.has("error") {
            return self.redirect("/admin/products/" + string(id) + "/edit?error=" + self.qs(check["error"]));
        }

        // Slug: keep the existing one unless the operator supplies a new one.
        let slug = string(row["slug"]);
        if string(req.string("slug")).trim() != "" {
            let wanted = self.slugify(req.string("slug"));
            if wanted != slug {
                slug = self.unique_slug(wanted, id);
            }
        }

        DB.table("products").where("id", "=", id).update(map(
            "name", string(check["name"]),
            "slug", slug,
            "description", string(check["description"]),
            "price", check["price"],
            "old_price", check["old_price"],
            "category", string(check["category"]),
            "emoji", string(check["emoji"]),
            "stock", check["stock"],
            "updated_at", string(unix_time())
        ));

        return self.redirect("/admin/products");
    }

    // POST /admin/products/:id/delete
    public fn destroy(self, req) {
        let id = req.int("id", 0);
        DB.table("products").where("id", "=", id).delete();
        return self.redirect("/admin/products");
    }

    // ------------------------------------------------------------------
    // Order management — GET /admin/orders, GET /admin/orders/:id,
    //                    POST /admin/orders/:id/status
    // ------------------------------------------------------------------
    public fn orders(self, req) {
        let cart = new CartService();

        let status = string(req.query("status", "")).trim().lower();
        let valid = false;
        for s in self.statuses() {
            if s == status {
                valid = true;
            }
        }
        if not valid {
            status = "";
        }

        let q = DB.table("orders");
        if status != "" {
            q.where("status", "=", status);
        }
        let rows = q.orderBy("id", "DESC").limit(100).get();

        // Filter tabs: {value,label,is_active} — BD @if is truthiness-only,
        // so the active flag is precomputed here.
        let tabs = [];
        let all_active = 1;
        if status != "" {
            all_active = 0;
        }
        tabs.push(map("value", "", "label", "All", "is_active", all_active));
        for s in self.statuses() {
            let active = 0;
            if s == status {
                active = 1;
            }
            tabs.push(map("value", s, "label", self.status_label(s), "is_active", active));
        }

        return self.view("admin.orders", self.shared(map(
            "title", "Manage Orders - Spid3r Bazaar",
            "orders", self.decorate_orders(rows),
            "tabs", tabs,
            "cart_count", cart.count(cart.token(req))
        ), req));
    }

    public fn order_detail(self, req) {
        let cart = new CartService();
        let id = req.int("id", 0);
        let row = DB.table("orders").where("id", "=", id).first();
        if row == null {
            return self.redirect("/admin/orders");
        }

        // Fully decode the cart snapshot: name, emoji, qty, unit price
        let items = [];
        try {
            items = json_parse(string(row["items_json"]));
        } catch (_e) {
            items = [];
        }

        // Customer account (nullable for guest checkout)
        let customer = null;
        if row["user_id"] != null and int(row["user_id"]) > 0 {
            customer = DB.table("users").where("id", "=", int(row["user_id"])).first();
        }

        // Status dropdown options with the current one pre-selected
        // (truthiness flag; BD @if cannot compare strings).
        let current = string(row["status"]);
        let status_options = [];
        for s in self.statuses() {
            let selected = 0;
            if s == current {
                selected = 1;
            }
            status_options.push(map("value", s, "label", self.status_label(s), "selected", selected));
        }

        return self.view("admin.order_detail", self.shared(map(
            "title", "Order #" + string(id) + " - Spid3r Bazaar",
            "order", row,
            "items", items,
            "customer", customer,
            "status_class", self.status_class(current),
            "status_label", self.status_label(current),
            "status_options", status_options,
            "form_error", req.query("error", ""),
            "cart_count", cart.count(cart.token(req))
        ), req));
    }

    // POST /admin/orders/:id/status  (whitelist-enforced)
    public fn update_status(self, req) {
        let id = req.int("id", 0);
        let wanted = string(req.string("status")).trim().lower();

        let valid = false;
        for s in self.statuses() {
            if s == wanted {
                valid = true;
            }
        }
        if not valid {
            return self.redirect("/admin/orders/" + string(id) + "?error=Invalid+status");
        }

        let order = DB.table("orders").where("id", "=", id).first();
        if order == null {
            return self.redirect("/admin/orders");
        }

        DB.table("orders").where("id", "=", id).update(map(
            "status", wanted,
            "updated_at", string(unix_time())
        ));

        return self.redirect("/admin/orders/" + string(id));
    }

    // ------------------------------------------------------------------
    // Internal helpers
    // ------------------------------------------------------------------

    // Minimal query-string encoding for short static error messages:
    // letters/digits/.-_ pass through, spaces become '+', anything else
    // is dropped (messages are framework-owned, never raw user input).
    fn qs(self, s: string) -> string {
        let out = "";
        let i = 0;
        while i < s.len() {
            let ch = s.slice(i, i + 1);
            if ch == " " {
                out = out + "+";
            } elif (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "." or ch == "-" or ch == "_" {
                out = out + ch;
            }
            i = i + 1;
        }
        return out;
    }

    // Validate + normalize product form input. Returns a map of clean
    // fields, or a map with only "error" set.
    fn validate_product_input(self, req, except_id) {
        let name = string(req.string("name")).trim();
        let category = string(req.string("category")).trim();
        let description = string(req.string("description", ""));
        let emoji = string(req.string("emoji", "")).trim();
        let price_raw = string(req.string("price", "")).trim();
        let old_raw = string(req.string("old_price", "")).trim();
        let stock_raw = string(req.string("stock", "")).trim();

        if name == "" {
            return map("error", "Product name is required.");
        }
        if category == "" {
            return map("error", "Category is required.");
        }
        if price_raw == "" {
            return map("error", "Price is required.");
        }

        let price = 0;
        try {
            price = int(price_raw);
        } catch (_e) {
            return map("error", "Price must be a whole number.");
        }
        if price < 1 {
            return map("error", "Price must be at least 1.");
        }

        let stock = 0;
        try {
            stock = int(stock_raw);
        } catch (_e) {
            return map("error", "Stock must be a whole number.");
        }
        if stock < 0 {
            return map("error", "Stock cannot be negative.");
        }

        let old_price = null;
        if old_raw != "" {
            try {
                old_price = int(old_raw);
            } catch (_e) {
                return map("error", "Old price must be a whole number.");
            }
            if int(old_price) < 0 {
                return map("error", "Old price cannot be negative.");
            }
        }

        if emoji == "" {
            emoji = "📦";
        }

        return map(
            "name", name,
            "category", category,
            "description", description,
            "emoji", emoji,
            "price", price,
            "old_price", old_price,
            "stock", stock
        );
    }

    // "Wireless Earbuds Pro!" -> "wireless-earbuds-pro"
    fn slugify(self, name: string) -> string {
        let lower = string(name).trim().lower();
        let out = "";
        let prev_dash = false;
        let i = 0;
        while i < lower.len() {
            let ch = lower.slice(i, i + 1);
            let ok = false;
            if (ch >= "a" and ch <= "z") or (ch >= "0" and ch <= "9") {
                ok = true;
            }
            if ok {
                out = out + ch;
                prev_dash = false;
            } else {
                if not prev_dash and out != "" {
                    out = out + "-";
                    prev_dash = true;
                }
            }
            i = i + 1;
        }
        if out.ends_with("-") {
            out = out.slice(0, out.len() - 1);
        }
        if out == "" {
            out = "product";
        }
        return out;
    }

    // First slug, base, base-2, base-3... not taken (excluding a row when
    // editing). Bounded so a pathological table can never hang a request.
    fn unique_slug(self, base: string, except_id) -> string {
        let candidate = base;
        let n = 2;
        while n < 100 {
            let q = DB.table("products").where("slug", "=", candidate);
            if except_id > 0 {
                q.where("id", "!=", except_id);
            }
            if q.first() == null {
                return candidate;
            }
            candidate = base + "-" + string(n);
            n = n + 1;
        }
        return base + "-" + string(unix_time());
    }

    // Decorate raw order rows with item_count parsed from items_json
    fn decorate_orders(self, rows) {
        let out = [];
        for row in rows {
            let m = map();
            for k in row.keys() {
                m[k] = row[k];
            }
            let items = [];
            try {
                items = json_parse(string(row["items_json"]));
            } catch (_e) {
                items = [];
            }
            let item_count = 0;
            for it in items {
                item_count = item_count + int(it["qty"]);
            }
            m["item_count"] = item_count;
            m["status_label"] = self.status_label(string(row["status"]));
            m["status_class"] = self.status_class(string(row["status"]));
            out.push(m);
        }
        return out;
    }
}
