// app/Controllers/AuthController.matrix
import "framework/Controller";
import "framework/Response";
import "framework/View/BD";
import "framework/Auth/Auth";
import "framework/Auth/Hash";
import "framework/Cache/Cache";
import "framework/Database/DB";
import "app/Models/User";
import "app/Support/CartService";

public class AuthController extends Controller {
    fn new() {
        super();
    }

    // Brute-force guard: after MAX_FAILS failed attempts for one email,
    // lock further attempts for LOCK_SECONDS (Cache-backed, per email).
    fn MAX_FAILS(self) -> int { return 5; }
    fn LOCK_SECONDS(self) -> int { return 600; }

    fn fails_key(self, email: string) -> string {
        return "login_fails:" + string(email).trim().lower();
    }

    fn is_locked(self, email: string) -> bool {
        let fails = int(Cache.get(self.fails_key(email), 0));
        return fails >= self.MAX_FAILS();
    }

    fn record_fail(self, email: string) {
        let key = self.fails_key(email);
        let fails = int(Cache.get(key, 0)) + 1;
        Cache.put(key, fails, self.LOCK_SECONDS());
    }

    fn clear_fails(self, email: string) {
        Cache.forget(self.fails_key(email));
    }

    // Password hashes must never leave the server — strip the password
    // field from any user map returned in API responses.
    fn safe_user(self, user) {
        if user == null {
            return null;
        }
        let out = map();
        for k in user.keys() {
            if k != "password" {
                out[k] = user[k];
            }
        }
        return out;
    }

    // POST /login  (email, password)
    public fn login(self, req) {
        let validator = req.validate(map(
            "email", "required|email",
            "password", "required"
        ));

        if validator.fails() {
            if req.path.starts_with("/api/") {
                return json(map("error", "Validation Failed", "messages", validator.error_messages()), 422);
            }
            return self.render_login(req, validator.error_summary());
        }

        let email = req.string("email").trim().lower();
        let password = req.string("password");

        // Brute-force lockout check
        if self.is_locked(email) {
            if req.path.starts_with("/api/") {
                return json(map("error", "Too many attempts. Try again later."), 429);
            }
            return self.render_login(req, "Too many failed attempts. Please try again in a few minutes.");
        }

        if req.auth.attempt(email, password) {
            self.clear_fails(email);
            if req.path.starts_with("/api/") {
                return json(map("status", "success", "token", req.auth.token(), "user", self.safe_user(req.auth.user())));
            }
            let res = redirect("/");
            res.cookie("spid3r_session", req.auth.token(), "/", 86400);
            return res;
        }

        self.record_fail(email);

        if req.path.starts_with("/api/") {
            return json(map("error", "Invalid credentials"), 401);
        }

        return self.render_login(req, "Invalid email or password combination.");
    }

    // Shared renderer so every login view gets full layout data (cart badge)
    fn render_login(self, req, error: string) {
        let cart = new CartService();
        return self.render(req, "auth.login", map(
            "title", "Sign In - Spid3r Bazaar",
            "error", error,
            "cart_count", cart.count(cart.token(req))
        ));
    }

    public fn showLogin(self, req) {
        if self.auth(req).check() {
            return redirect("/");
        }
        return self.render_login(req, "");
    }

    // Shared renderer for the register view (full layout data)
    fn render_register(self, req, error: string) {
        let cart = new CartService();
        return self.render(req, "auth.register", map(
            "title", "Create Account - Spid3r Bazaar",
            "error", error,
            "cart_count", cart.count(cart.token(req))
        ));
    }

    public fn showRegister(self, req) {
        if self.auth(req).check() {
            return redirect("/");
        }
        return self.render_register(req, "");
    }

    public fn register(self, req) {
        let validator = req.validate(map(
            "name", "required|min:2",
            "email", "required|email",
            "password", "required|min:6"
        ));

        if validator.fails() {
            if req.path.starts_with("/api/") {
                return json(map("error", "Validation Failed", "messages", validator.error_messages()), 422);
            }
            return self.render_register(req, validator.error_summary());
        }

        let email = req.string("email").trim().lower();
        let name = req.string("name").trim();
        let existing = UserModel.findByEmail(email);
        if existing != null {
            if req.path.starts_with("/api/") {
                return json(map("error", "Email already in use"), 422);
            }
            return self.render_register(req, "This email address is already registered.");
        }

        let hashed = Hash.make(req.string("password"));
        let user = UserModel.create(map(
            "name", name,
            "email", email,
            "password", hashed
        ));

        req.auth.login(user.to_map());

        if req.path.starts_with("/api/") {
            return json(map("status", "created", "token", req.auth.token(), "user", self.safe_user(req.auth.user())), 201);
        }

        let res = redirect("/");
        res.cookie("spid3r_session", req.auth.token(), "/", 86400);
        return res;
    }

    public fn logout(self, req) {
        req.auth.logout();
        if req.path.starts_with("/api/") {
            return json(map("status", "logged_out"));
        }
        let res = redirect("/");
        res.cookie("spid3r_session", "", "/", 0);
        return res;
    }
}
