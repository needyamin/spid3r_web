// examples/task-api/main.matrix
// Spid3rWeb Task API — a complete, runnable full-stack MVC example.
//
// Demonstrates the modern Spid3rWeb framework end to end WITHOUT opening a port:
// single-import barrel (`framework/Web`), zero-boilerplate `model()` repository,
// service providers, model events, `req.validate_or_fail()`, `find_or_fail()`,
// REST resource envelopes, pagination, and `TestClient` assertions.
//
// Run it:
//   SPID3R_DB_DRIVER=sqlite spid3r run examples/task-api/main.matrix
// Under the bytecode VM:
//   SPID3R_DB_DRIVER=sqlite spid3r run --engine vm examples/task-api/main.matrix

import "framework/Web";
import "framework/Providers/ServiceProvider";
import "framework/Resource";

// ---------------------------------------------------------------------------
// 1. Zero-boilerplate domain model + service provider
// ---------------------------------------------------------------------------

let Task = model("tasks", {
    "fillable": ["title", "done", "priority"],
    "casts": {
        "done": "bool",
        "priority": "int"
    }
});

class TaskProvider extends ServiceProvider {
    public fn register(self, container) {
        container.singleton("task.events_fired", fn(_c) {
            return {"created": 0, "deleted": 0};
        });
    }

    public fn boot(self, container) {
        let counter = container.make("task.events_fired");
        events().listen("model.tasks.created", fn(_task, _name) {
            counter["created"] = counter["created"] + 1;
            return null;
        });
        events().listen("model.tasks.deleted", fn(_task, _name) {
            counter["deleted"] = counter["deleted"] + 1;
            return null;
        });
    }
}

let task_transformer = fn(t) {
    return {
        "id": t["id"],
        "title": t["title"],
        "done": t["done"] == 1 or t["done"] == true,
        "priority": int(t["priority"])
    };
};

// ---------------------------------------------------------------------------
// 2. Clean MVC Controller
// ---------------------------------------------------------------------------

class TaskController {
    public fn index(self, req) {
        let page = Task.orderBy("priority", "DESC").paginate(req.page(), req.per_page(10));
        return resource_paginated(page, task_transformer);
    }

    public fn store(self, req, res) {
        let data = req.validate_or_fail({
            "title": "required|min:3|max:200",
            "priority": "nullable|integer|between:1,9"
        });
        let prio = 1;
        if data["priority"] != null {
            prio = data["priority"];
        }
        let task = Task.create({
            "title": data["title"],
            "priority": prio,
            "done": false
        });
        return res.status(201).json(resource_item(task, task_transformer));
    }

    public fn show(self, req) {
        let task = Task.find_or_fail(req.int("id"), "No task with that id.");
        return resource_item(task, task_transformer);
    }

    public fn destroy(self, req) {
        let task = Task.find_or_fail(req.int("id"), "No task with that id.");
        let snapshot = task.to_map();
        task.delete();
        return resource_item(snapshot, task_transformer);
    }
}

// ---------------------------------------------------------------------------
// 3. App assembly + demo run
// ---------------------------------------------------------------------------

fn show(label: string, test_res) {
    println("---- " + label + " -> " + string(test_res.status));
    let body = test_res.body;
    if len(body) > 220 {
        body = body.slice(0, 220) + " ...";
    }
    println(body);
}

fn main() {
    schema().dropIfExists("tasks");
    schema().create("tasks", t => {
        t.id();
        t.string("title");
        t.integer("done").default(0);
        t.integer("priority").default(1);
        t.timestamps();
    });

    let app = web();
    app.register(new TaskProvider());

    let ctl = new TaskController();
    app.get("/api/tasks", req => ctl.index(req));
    app.post("/api/tasks", (req, res) => ctl.store(req, res));
    app.get("/api/tasks/:id", req => ctl.show(req));
    app.delete("/api/tasks/:id", req => ctl.destroy(req));

    let client = app.test_client();

    println("=== Spid3rWeb Task API demo ===\n");

    // 1. Validation failure -> 422 with field errors.
    let r_invalid = client.post_json("/api/tasks", {"priority": "2"}).assert_unprocessable();
    show("POST invalid (no title)", r_invalid);

    // 2. Create -> 201 + resource envelope.
    let r_created = client.post_json("/api/tasks", {"title": "Ship Spid3rWeb 2.0", "priority": "5"})
        .assert_created()
        .assert_json_path("data.title", "Ship Spid3rWeb 2.0")
        .assert_json_path("data.priority", 5);
    show("POST valid", r_created);

    // 3. Index -> paginated collection envelope.
    let r_index = client.get("/api/tasks").assert_ok().assert_json_path("meta.total", 1);
    show("GET /api/tasks", r_index);

    // 4. Typed 404 from a missing id.
    let r_missing = client.get("/api/tasks/999").assert_not_found();
    show("GET /api/tasks/999", r_missing);

    // 5. Show a real one, then delete it.
    let r_show = client.get("/api/tasks/1").assert_ok().assert_json_path("data.id", 1);
    show("GET /api/tasks/1", r_show);

    let r_del = client.delete("/api/tasks/1").assert_ok();
    show("DELETE /api/tasks/1", r_del);

    // 6. Proof the provider's model-event listeners ran.
    let counter = app.container.make("task.events_fired");
    println("---- model.tasks.created events observed: " + string(counter["created"])
        + ", deleted: " + string(counter["deleted"]));

    schema().dropIfExists("tasks");
    db().close();
    println("\n=== Demo finished cleanly ===");
    return 0;
}
