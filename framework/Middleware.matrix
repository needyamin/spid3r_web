// framework/Middleware.matrix
// Spid3rWeb True Onion Middleware Pipeline & Built-in Guards
//
// Supports THREE middleware styles seamlessly:
//   1. Closure / Function Onion Middleware (Express / Hono / Koa style):
//      `app.use((req, next) => { let res = next(req); res.header("x-foo", "bar"); return res; });`
//   2. Class Onion Middleware (2-argument `handle(self, req, next)`):
//      Calls `let res = next(req);` to invoke downstream pipeline and mutate/inspect response.
//   3. Legacy Pre-Filter Class Middleware (1-argument `handle(self, req)`):
//      Returns `null` to proceed to the next middleware, or returns a `Response`
//      to short-circuit the pipeline.

import "framework/Response";
import "framework/Auth/Auth";
import "framework/Cache/Cache";
import "framework/Config/Config";

public class Pipeline {
    public let passable;
    public let pipes;

    fn new() {
        self.passable = null;
        self.pipes = [];
    }

    public fn send(self, passable) {
        self.passable = passable;
        return self;
    }

    public fn through(self, pipes_list) {
        self.pipes = pipes_list;
        return self;
    }

    // Ensure any handler/middleware return value is wrapped in a Response object
    // when after-middleware needs `.header(...)` or `.status_code`.
    fn ensure_response_obj(self, val) {
        if val == null {
            return null;
        }
        let t = type_of(val);
        if t == "instance" {
            return val;
        }
        if t == "map" {
            if val.has("status") and val.has("headers") and val.has("body") {
                let r = new Response(string(val["body"]), int(val["status"]));
                r.headers = val["headers"];
                return r;
            }
            return json(val, 200);
        }
        if t == "list" {
            return json(val, 200);
        }
        if t == "string" {
            return html(val, 200);
        }
        return response(string(val), 200);
    }

    fn run_step(self, index: int, current_req, destination) {
        if self.pipes == null or index >= self.pipes.len() {
            return destination(current_req);
        }

        let pipe = self.pipes[index];
        let me = self;
        let next_called = {"flag": false, "res": null};

        let next_fn = fn(next_req = null) {
            next_called["flag"] = true;
            let r_to_pass = current_req;
            if next_req != null {
                r_to_pass = next_req;
            }
            let down_res = me.run_step(index + 1, r_to_pass, destination);
            let wrapped = me.ensure_response_obj(down_res);
            next_called["res"] = wrapped;
            return wrapped;
        };

        // Attach `req.next` so even 1-arg middleware can call `req.next()` if desired
        let res = null;
        let pt = type_of(pipe);

        if pt == "function" {
            // Try 2-arg `(req, next) => ...` first, fallback to 1-arg `req => ...`
            res = pipe(current_req, next_fn);
        } else {
            // Instance with `.handle` — try 2-arg `.handle(req, next)` if supported,
            // otherwise fallback to 1-arg `.handle(req)`.
            let handled_2arg = false;
            try {
                res = pipe.handle(current_req, next_fn);
                handled_2arg = true;
            } catch (err) {
                let err_msg = string(err);
                if err_msg.contains("expected 2 arguments, got 3") or err_msg.contains("expected 1 arguments, got 2") or err_msg.contains("arity") or err_msg.contains("arguments") {
                    handled_2arg = false;
                } else {
                    throw err;
                }
            }
            if not handled_2arg {
                res = pipe.handle(current_req);
            }
        }

        // If the middleware returned a non-null response directly, use it
        if res != null {
            return res;
        }
        // If the middleware called `next(req)` and returned null, return the downstream response
        if next_called["flag"] {
            return next_called["res"];
        }
        // Legacy 1-arg middleware returned `null` without calling `next` -> proceed to next step!
        return self.run_step(index + 1, current_req, destination);
    }

    public fn then(self, destination) {
        return self.run_step(0, self.passable, destination);
    }
}

// ----------------------------------------------------------------------------
// Built-in Framework Middleware
// ----------------------------------------------------------------------------

public class CorsMiddleware {
    public let allow_origin;
    public let allow_methods;
    public let allow_headers;

    fn new(origin: string = "*", methods: string = "GET, POST, PUT, DELETE, PATCH, OPTIONS", headers: string = "content-type, authorization, x-requested-with, x-csrf-token") {
        self.allow_origin = origin;
        self.allow_methods = methods;
        self.allow_headers = headers;
    }

    public fn handle(self, req, next = null) {
        if req.method == "OPTIONS" {
            let res = response("", 204);
            res.header("access-control-allow-origin", self.allow_origin);
            res.header("access-control-allow-methods", self.allow_methods);
            res.header("access-control-allow-headers", self.allow_headers);
            return res;
        }
        if next != null {
            let res = next(req);
            if res != null and type_of(res) == "instance" {
                // Attach CORS headers on API / JSON responses unless already set
                if req.path.starts_with("/api/") or (res.headers.has("content-type") and string(res.headers["content-type"]).contains("application/json")) {
                    if not res.headers.has("access-control-allow-origin") {
                        res.header("access-control-allow-origin", self.allow_origin);
                        res.header("access-control-allow-methods", self.allow_methods);
                        res.header("access-control-allow-headers", self.allow_headers);
                    }
                }
            }
            return res;
        }
        return null;
    }
}

public class LoggerMiddleware {
    fn new() {}

    public fn handle(self, req, next = null) {
        let start = now_ms();
        if next != null {
            let res = next(req);
            let elapsed = now_ms() - start;
            let status = 200;
            if res != null and type_of(res) == "instance" {
                status = res.status_code;
            }
            println("[Spid3rWeb] " + req.method + " " + req.path + " -> " + string(status) + " (" + string(elapsed) + "ms)");
            return res;
        }
        println("[Spid3rWeb] " + req.method + " " + req.path);
        return null;
    }
}

public class AuthMiddleware {
    fn new() {}

    public fn handle(self, req, next = null) {
        // Prefer the request-scoped auth state (set by Application); fall
        // back to the global facade for direct/legacy invocation.
        let auth = null;
        if req.auth != null {
            auth = req.auth;
        } else {
            auth = Auth;
        }

        // Authenticate session if token present
        if req.session_id != "" and not auth.check() {
            auth.authenticate_token(req.session_id);
        }

        if not auth.check() {
            if req.path.starts_with("/api/") or req.header("accept", "").contains("application/json") {
                return json({"error": "Unauthorized", "message": "Authentication required."}, 401);
            }
            return redirect("/login");
        }
        if next != null {
            return next(req);
        }
        return null;
    }
}

// GuestMiddleware — the inverse of AuthMiddleware: for routes that only make
// sense while logged out (login/register pages). An authenticated visitor is
// redirected away instead of seeing the form again. Alias: "guest".
public class GuestMiddleware {
    public let redirect_to;

    fn new(redirect_to: string = "/") {
        self.redirect_to = redirect_to;
    }

    public fn handle(self, req, next = null) {
        let auth = null;
        if req.auth != null {
            auth = req.auth;
        } else {
            auth = Auth;
        }
        if auth.check() {
            return redirect(self.redirect_to);
        }
        if next != null {
            return next(req);
        }
        return null;
    }
}

// ----------------------------------------------------------------------------
// ThrottleMiddleware — Cache-backed per-client rate limiting
// ----------------------------------------------------------------------------
// Usage: Route.get("/x", h).middleware("throttle:5,60")
//   → at most 5 requests per 60 seconds per client (IP or session token).
// Exceeding the limit returns 429 (JSON for API clients). The counter lives
// in the configured Cache store; the memory driver resets on process restart.
public class ThrottleMiddleware {
    public let max_attempts;
    public let decay_seconds;

    fn new(max_attempts: int = 60, decay_seconds: int = 60) {
        self.max_attempts = max_attempts;
        self.decay_seconds = decay_seconds;
    }

    public fn handle(self, req, next = null) {
        // Key by session token when present (stable per client), else by IP.
        let identity = req.client_ip();
        if req.session_id != "" {
            identity = req.session_id;
        }
        let key = "throttle:" + identity + ":" + req.method + ":" + req.path;

        // Fixed-window counter: add() seeds the TTL on the first hit so the
        // window always starts at the first request.
        if Cache.missing(key) {
            Cache.add(key, 0, self.decay_seconds);
        }
        let hits = Cache.increment(key);

        if hits > self.max_attempts {
            let retry = self.decay_seconds;
            if req.path.starts_with("/api/") or req.header("accept", "").contains("application/json") {
                return json({
                    "error": "Too Many Requests",
                    "message": "Rate limit exceeded. Try again in " + string(retry) + " seconds."
                }, 429);
            }
            let res = response("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><title>429 Too Many Requests - Spid3rWeb</title></head><body><h1>429 — Too Many Requests</h1><p>Rate limit exceeded. Please try again in a few moments.</p></body></html>", 429);
            res.header("retry-after", string(retry));
            return res;
        }
        if next != null {
            let res = next(req);
            if res != null and type_of(res) == "instance" {
                let remaining = self.max_attempts - hits;
                if remaining < 0 { remaining = 0; }
                res.header("x-ratelimit-limit", string(self.max_attempts));
                res.header("x-ratelimit-remaining", string(remaining));
            }
            return res;
        }
        return null;
    }
}

// ----------------------------------------------------------------------------
// EtagMiddleware — Automatic ETag & 304 Not Modified for GET/HEAD 200 responses
// ----------------------------------------------------------------------------
public class EtagMiddleware {
    fn new() {}

    public fn handle(self, req, next = null) {
        if next == null {
            return null;
        }
        let res = next(req);
        if res == null or type_of(res) != "instance" {
            return res;
        }
        if (req.method == "GET" or req.method == "HEAD") and res.status_code == 200 and res.body != "" {
            let etag = "\"" + sha256(res.body).slice(0, 16) + "\"";
            res.header("etag", etag);
            let inm = req.header("if-none-match", "");
            if inm != "" and inm == etag {
                res.status(304);
                res.body = "";
            }
        }
        return res;
    }
}

// ----------------------------------------------------------------------------
// RequestIdMiddleware — Attaches X-Request-Id to req and response headers
// ----------------------------------------------------------------------------
public class RequestIdMiddleware {
    fn new() {}

    public fn handle(self, req, next = null) {
        let req_id = req.header("x-request-id", "");
        if req_id == "" {
            req_id = "req_" + hex_encode(random_bytes(8).unwrap());
        }
        req.headers["x-request-id"] = req_id;
        if next != null {
            let res = next(req);
            if res != null and type_of(res) == "instance" {
                res.header("x-request-id", req_id);
            }
            return res;
        }
        return null;
    }
}
