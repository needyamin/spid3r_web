// framework/Request.matrix
// Spid3rWeb HTTP Request Representation (query/form/JSON/multipart parsing,
// method spoofing, cookies, file uploads, session & auth accessors, and
// one-line validation).

import "http";
import "framework/Validator";
import "framework/Config/Config";
import "framework/HttpException";
import "framework/Session/Session";
import "framework/Filesystem/Storage";

fn resolve_cookie_secret() -> string {
    let app_key = string(Config.get("app.key", ""));
    if app_key != "" {
        return app_key;
    }
    let env_key = env("APP_KEY");
    if env_key.is_some() and string(env_key.unwrap()).trim() != "" {
        return string(env_key.unwrap()).trim();
    }
    return "spid3rweb-default-cookie-secret-key";
}

public class Request {
    public let method;
    public let original_method;
    public let path;
    public let params;
    public let query_params;
    public let headers;
    public let cookies;
    public let files;
    public let body;
    public let data;
    public let session_id;
    // Request-scoped auth state (an AuthManager instance created per request
    // by Application.handle_request).
    public let auth;
    public let user_data;
    // The Application instance handling this request.
    public let app;
    // Mutable Response builder for 2-arg Express-style `(req, res) => ...` handlers.
    public let res;
    // Lazy general-purpose SessionStore (`req.session()`).
    public let session_store;
    // How the session token arrived: "cookie" | "bearer" | ""
    public let session_source;
    // Original raw request map (kept for driver-specific accessors)
    public let raw;

    fn new(raw_req = null) {
        self.params = map();
        self.query_params = map();
        self.headers = map();
        self.cookies = map();
        self.files = map();
        self.data = map();
        self.body = "";
        self.method = "GET";
        self.original_method = "GET";
        self.path = "/";
        self.session_id = "";
        self.session_source = "";
        self.auth = null;
        self.user_data = null;
        self.app = null;
        self.res = null;
        self.session_store = null;
        self.raw = null;

        if raw_req != null {
            self.init_from_raw(raw_req);
        }
    }

    fn init_from_raw(self, raw) {
        self.raw = raw;
        if raw.has("method") {
            self.method = string(raw["method"]).upper();
            self.original_method = self.method;
        }
        if raw.has("path") {
            self.path = string(raw["path"]);
        }
        if raw.has("params") and raw["params"] != null {
            self.params = raw["params"];
        }
        if raw.has("headers") and raw["headers"] != null {
            let h = raw["headers"];
            for k in h.keys() {
                self.headers[string(k).lower()] = string(h[k]);
            }
        }

        // Parse cookies from Cookie header
        if self.headers.has("cookie") {
            self.parse_cookies(string(self.headers["cookie"]));
        }

        // Direct data injection (useful for tests and programmatic dispatch)
        if raw.has("data") and raw["data"] != null and type_of(raw["data"]) == "map" {
            let d = raw["data"];
            for k in d.keys() {
                self.data[string(k)] = d[k];
            }
        }

        // Query parameters from parsed server map
        if raw.has("query") and raw["query"] != null and type_of(raw["query"]) == "map" {
            let q = raw["query"];
            for k in q.keys() {
                let sk = string(k);
                let sv = string(q[k]);
                self.query_params[sk] = sv;
                if not self.data.has(sk) {
                    self.data[sk] = sv;
                }
            }
        }

        // Raw query string from server map
        if raw.has("raw_query") and raw["raw_query"] != null {
            let rq = string(raw["raw_query"]);
            if rq != "" {
                self.parse_query_string(rq);
            }
        }

        // Parse query string if present in path (e.g., /products?page=2&sort=desc)
        if self.path.contains("?") {
            let parts = self.path.split("?");
            self.path = parts[0];
            if parts.len() > 1 {
                self.parse_query_string(parts[1]);
            }
        }

        // Extract body: support JSON, URL-encoded form data, and multipart/form-data
        let parsed_as_json = false;
        let parsed_json = http_body_json(raw);
        if parsed_json.is_ok() {
            let val = parsed_json.unwrap();
            if type_of(val) == "map" {
                for k in val.keys() {
                    self.data[string(k)] = val[k];
                }
                parsed_as_json = true;
            }
        }

        if raw.has("body") and raw["body"] != null {
            self.body = string(raw["body"]);
            if not parsed_as_json and self.body != "" {
                let ct = "";
                if self.headers.has("content-type") {
                    ct = string(self.headers["content-type"]).lower();
                }
                if ct.contains("application/x-www-form-urlencoded") or (ct == "" and self.body.contains("=")) {
                    self.parse_form_encoded(self.body);
                } elif ct.contains("multipart/form-data") {
                    let ct_raw = string(self.headers["content-type"]);
                    self.parse_multipart(self.body, ct_raw);
                }
            }
        }

        // HTML Form Method Spoofing (_method or X-HTTP-Method-Override on POST)
        if self.method == "POST" {
            let spoof = "";
            if self.headers.has("x-http-method-override") {
                spoof = string(self.headers["x-http-method-override"]).trim().upper();
            } elif self.data.has("_method") {
                spoof = string(self.data["_method"]).trim().upper();
            } elif self.query_params.has("_method") {
                spoof = string(self.query_params["_method"]).trim().upper();
            }
            if spoof == "PUT" or spoof == "PATCH" or spoof == "DELETE" {
                self.method = spoof;
            }
        }

        // Extract Session Cookie or Bearer Token
        self.session_id = self.extract_session_token();
    }

    fn parse_cookies(self, cookie_header: string) {
        let pairs = cookie_header.split(";");
        for p in pairs {
            let trimmed = p.trim();
            if trimmed != "" {
                let eq = trimmed.index_of("=");
                if eq > 0 {
                    let k = trimmed.slice(0, eq).trim();
                    let v = trimmed.slice(eq + 1, trimmed.len()).trim();
                    self.cookies[k] = url_decode(v);
                }
            }
        }
    }

    fn parse_query_string(self, qs: string) {
        let clean_qs = qs.trim();
        if clean_qs.starts_with("?") {
            clean_qs = clean_qs.slice(1);
        }
        let pairs = clean_qs.split("&");
        for p in pairs {
            let p_trim = p.trim();
            if p_trim != "" {
                let eq = p_trim.index_of("=");
                if eq >= 0 {
                    let k = url_decode(p_trim.slice(0, eq).trim());
                    let v = url_decode(p_trim.slice(eq + 1));
                    self.query_params[k] = v;
                    if not self.data.has(k) {
                        self.data[k] = v;
                    }
                } else {
                    let k = url_decode(p_trim);
                    self.query_params[k] = "";
                    if not self.data.has(k) {
                        self.data[k] = "";
                    }
                }
            }
        }
    }

    fn parse_form_encoded(self, body_text: string) {
        let clean_body = body_text.trim();
        let pairs = clean_body.split("&");
        for p in pairs {
            let p_trim = p.trim();
            if p_trim != "" {
                let eq = p_trim.index_of("=");
                if eq >= 0 {
                    let k = url_decode(p_trim.slice(0, eq).trim());
                    let v = url_decode(p_trim.slice(eq + 1));
                    self.data[k] = v;
                } else {
                    let k = url_decode(p_trim);
                    self.data[k] = "";
                }
            }
        }
    }

    // Parse a multipart/form-data body (both text fields and file uploads).
    fn parse_multipart(self, body_text: string, content_type: string) {
        let b_idx = content_type.index_of("boundary=");
        if b_idx < 0 {
            return;
        }
        let boundary = content_type.slice(b_idx + 9, content_type.len()).trim();
        if boundary.starts_with("\"") and boundary.ends_with("\"") {
            boundary = boundary.slice(1, boundary.len() - 1);
        }
        let delim = "--" + boundary;

        let chunks = body_text.split(delim);
        for chunk in chunks {
            let c = chunk;
            if c.starts_with("\r\n") {
                c = c.slice(2, c.len());
            } elif c.starts_with("\n") {
                c = c.slice(1, c.len());
            }
            if c.len() == 0 or c == "--" {
                continue;
            }

            // Split part into headers and value
            let sep = c.index_of("\r\n\r\n");
            let header_len = 4;
            if sep < 0 {
                sep = c.index_of("\n\n");
                header_len = 2;
                if sep < 0 {
                    continue;
                }
            }
            let part_headers_raw = c.slice(0, sep);
            let part_headers = part_headers_raw.lower();
            let value = c.slice(sep + header_len, c.len());

            // Strip the trailing newline that preceded the boundary
            if value.ends_with("\r\n") {
                value = value.slice(0, value.len() - 2);
            } elif value.ends_with("\n") or value.ends_with("\r") {
                value = value.slice(0, value.len() - 1);
            }

            let n_idx = part_headers.index_of("name=\"");
            if n_idx < 0 {
                continue;
            }
            let rest = part_headers_raw.slice(n_idx + 6, part_headers_raw.len());
            let end_q = rest.index_of("\"");
            if end_q < 0 {
                continue;
            }
            let field = rest.slice(0, end_q);
            if field == "" {
                continue;
            }

            // File upload part (`filename="..."`)
            let fn_idx = part_headers.index_of("filename=\"");
            if fn_idx >= 0 {
                let fn_rest = part_headers_raw.slice(fn_idx + 10, part_headers_raw.len());
                let fn_end = fn_rest.index_of("\"");
                let filename = "";
                if fn_end >= 0 {
                    let raw_fn = fn_rest.slice(0, fn_end).replace("\\", "/");
                    let fn_segs = raw_fn.split("/");
                    filename = fn_segs[fn_segs.len() - 1];
                }
                let part_ct = "application/octet-stream";
                let ct_idx = part_headers.index_of("content-type:");
                if ct_idx >= 0 {
                    let ct_sub = part_headers_raw.slice(ct_idx + 13, part_headers_raw.len());
                    let ct_lines = ct_sub.split("\n");
                    if ct_lines.len() > 0 {
                        part_ct = ct_lines[0].trim();
                    }
                }
                if filename != "" {
                    let ext = "";
                    let dot_segs = filename.split(".");
                    if dot_segs.len() > 1 {
                        ext = "." + dot_segs[dot_segs.len() - 1];
                    }
                    self.files[field] = {
                        "name": filename,
                        "type": part_ct,
                        "size": value.len(),
                        "content": value,
                        "ext": ext
                    };
                }
                continue;
            }

            self.data[field] = value;
        }
    }

    fn extract_session_token(self) -> string {
        // 1. Authorization: Bearer <token>
        if self.headers.has("authorization") {
            let auth = self.headers["authorization"];
            if auth.starts_with("Bearer ") {
                self.session_source = "bearer";
                return auth.replace("Bearer ", "").trim();
            }
        }
        // 2. Cookie: <session cookie>=<token>  (name from config/session.matrix)
        let cookie_name = Config.get("session.cookie", "spid3r_session");
        if self.cookies.has(cookie_name) {
            self.session_source = "cookie";
            return string(self.cookies[cookie_name]);
        }
        return "";
    }

    // ------------------------------------------------------------------
    // Client Identity & Content Negotiation
    // ------------------------------------------------------------------
    public fn client_ip(self) -> string {
        let trust_proxy = false;
        let tp = env("SPID3R_TRUST_PROXY");
        if tp.is_some() {
            let v = string(tp.unwrap()).trim().lower();
            if v == "1" or v == "true" or v == "yes" {
                trust_proxy = true;
            }
        }
        if trust_proxy {
            if self.headers.has("x-forwarded-for") {
                let parts = string(self.headers["x-forwarded-for"]).split(",");
                if parts.len() > 0 {
                    let first = parts[0].trim();
                    if first != "" {
                        return first;
                    }
                }
            }
            if self.headers.has("x-real-ip") {
                let rip = string(self.headers["x-real-ip"]).trim();
                if rip != "" {
                    return rip;
                }
            }
        }
        if self.raw != null and type_of(self.raw) == "map" {
            let candidates = list("peer_addr", "remote_addr", "client_addr", "ip");
            for k in candidates {
                if self.raw.has(k) {
                    let v = string(self.raw[k]);
                    if v != "" {
                        return v;
                    }
                }
            }
        }
        return "unknown";
    }

    public fn ip(self) -> string {
        return self.client_ip();
    }

    public fn bearer(self) -> string {
        if self.headers.has("authorization") {
            let auth = string(self.headers["authorization"]);
            if auth.starts_with("Bearer ") {
                return auth.slice(7, auth.len()).trim();
            }
        }
        return "";
    }

    public fn user(self) {
        if self.user_data != null {
            return self.user_data;
        }
        if self.auth != null {
            return self.auth.user();
        }
        return null;
    }

    public fn session(self) {
        if self.session_store == null {
            let sid = self.cookie("spid3r_sid", "");
            self.session_store = new SessionStore(string(sid));
        }
        return self.session_store;
    }

    public fn is_json(self) -> bool {
        let ct = string(self.header("content-type", "")).lower();
        return ct.contains("application/json");
    }

    public fn wants_json(self) -> bool {
        let accept = string(self.header("accept", "")).lower();
        return self.path.starts_with("/api/") or accept.contains("application/json") or self.is_json();
    }

    // ------------------------------------------------------------------------
    // Cookie & File Upload Accessors
    // ------------------------------------------------------------------------

    public fn cookie(self, name: string, default_val = null) {
        if self.cookies.has(name) {
            return self.cookies[name];
        }
        return default_val;
    }

    public fn signed_cookie(self, name: string, default_val = null) {
        if not self.cookies.has(name) {
            return default_val;
        }
        let raw_val = string(self.cookies[name]);
        let parts = raw_val.split(".");
        if parts.len() < 2 {
            return default_val;
        }
        let sig = parts[parts.len() - 1];
        if sig == "" or raw_val.len() <= sig.len() + 1 {
            return default_val;
        }
        let payload = raw_val.slice(0, raw_val.len() - sig.len() - 1);
        let expected = hmac_sha256(resolve_cookie_secret(), name + "=" + payload);
        if secure_compare(sig, expected) {
            return payload;
        }
        return default_val;
    }

    public fn file(self, key: string) {
        if self.files.has(key) {
            return self.files[key];
        }
        return null;
    }

    public fn has_file(self, key: string) -> bool {
        return self.files.has(key) and self.files[key] != null;
    }

    public fn store_file(self, key: string, directory: string = "uploads", disk_name: string = "public") -> string {
        let f = self.file(key);
        if f == null {
            throw bad_request("No uploaded file found for field '" + key + "'.");
        }
        let safe_name = string(unix_time()) + "_" + hex_encode(random_bytes(6).unwrap()) + string(f["ext"]);
        let rel_path = directory;
        if rel_path != "" and not rel_path.ends_with("/") {
            rel_path = rel_path + "/";
        }
        rel_path = rel_path + safe_name;
        Storage.disk(disk_name).put(rel_path, string(f["content"]));
        return rel_path;
    }

    // ------------------------------------------------------------------------
    // Input Accessors
    // ------------------------------------------------------------------------

    public fn input(self, key: string, default_val = null) {
        if self.data.has(key) {
            return self.data[key];
        }
        if self.query_params.has(key) {
            return self.query_params[key];
        }
        if self.params.has(key) {
            return self.params[key];
        }
        return default_val;
    }

    public fn string(self, key: string, default_val: string = "") -> string {
        let v = self.input(key, null);
        if v == null { return default_val; }
        return string(v);
    }

    public fn int(self, key: string, default_val: int = 0) -> int {
        let v = self.input(key, null);
        if v == null { return default_val; }
        try {
            return int(v);
        } catch (_e) {
            return default_val;
        }
    }

    public fn float(self, key: string, default_val: float = 0.0) -> float {
        let v = self.input(key, null);
        if v == null { return default_val; }
        try {
            return float(v);
        } catch (_e) {
            return default_val;
        }
    }

    public fn bool(self, key: string, default_val: bool = false) -> bool {
        let v = self.input(key, null);
        if v == null { return default_val; }
        if type_of(v) == "bool" { return v; }
        let s = string(v).trim().lower();
        if s == "true" or s == "1" or s == "yes" or s == "on" { return true; }
        if s == "false" or s == "0" or s == "no" or s == "off" { return false; }
        return default_val;
    }

    public fn only(self, keys) {
        let out = {};
        for k in keys {
            let sk = string(k);
            if self.has(sk) {
                out[sk] = self.input(sk);
            }
        }
        return out;
    }

    public fn except(self, keys) {
        let excluded = {};
        for k in keys {
            excluded[string(k)] = true;
        }
        let out = {};
        for (k, v) in self.data {
            if not excluded.has(k) {
                out[k] = v;
            }
        }
        return out;
    }

    public fn page(self, default_val: int = 1) -> int {
        let p = self.int("page", default_val);
        if p < 1 { return 1; }
        return p;
    }

    public fn per_page(self, default_val: int = 15, max_val: int = 100) -> int {
        let pp = self.int("per_page", default_val);
        if pp < 1 { return default_val; }
        if pp > max_val { return max_val; }
        return pp;
    }

    public fn has(self, key: string) -> bool {
        return self.data.has(key) or self.query_params.has(key) or self.params.has(key);
    }

    public fn all(self) {
        return self.data;
    }

    public fn param(self, key: string, default_val = null) {
        if self.params.has(key) {
            return self.params[key];
        }
        return default_val;
    }

    public fn query(self, key: string, default_val = null) {
        if self.query_params.has(key) {
            return self.query_params[key];
        }
        return default_val;
    }

    public fn header(self, key: string, default_val = null) {
        let lkey = string(key).lower();
        if self.headers.has(lkey) {
            return self.headers[lkey];
        }
        return default_val;
    }

    // ------------------------------------------------------------------------
    // Declarative Validation (engine in framework/Validator.matrix)
    // ------------------------------------------------------------------------
    public fn validate(self, rules) {
        let engine = new Validator();
        return engine.check(self, rules);
    }

    // Validate request inputs against `rules`. Throws a 422 HttpException if
    // validation fails; otherwise returns the map of validated & coerced values.
    public fn validate_or_fail(self, rules) {
        let v = self.validate(rules);
        if v.fails() {
            throw validation_failed(v.error_messages(), v.first());
        }
        return v.validated();
    }
}
