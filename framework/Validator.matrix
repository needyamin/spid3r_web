// framework/Validator.matrix
// Spid3rWeb Declarative Validation & Type-Coercion Engine.
// Split out of Request.matrix; Request.validate() and Request.validate_or_fail()
// delegate here.
// Rule strings are pipe-separated ("required|integer|min_value:1"); the
// "nullable" modifier lets empty values skip every other rule.

import "framework/Database/DB";

// RFC-style email check: single @, length limits, valid user/domain chars,
// no leading/trailing dots, real TLD (non-numeric, >= 2 chars).
fn is_valid_email(val_str: string) -> bool {
    if val_str.len() < 3 or val_str.len() > 254 {
        return false;
    }
    if val_str.contains(" ") or val_str.contains("\t") or val_str.contains("\r") or val_str.contains("\n") {
        return false;
    }
    let at_parts = val_str.split("@");
    if at_parts.len() != 2 {
        return false;
    }
    let user = at_parts[0];
    let domain = at_parts[1];

    if user.len() == 0 or user.len() > 64 {
        return false;
    }
    if user.starts_with(".") or user.ends_with(".") or user.contains("..") {
        return false;
    }

    if domain.len() == 0 or domain.len() > 255 {
        return false;
    }
    if domain.starts_with(".") or domain.ends_with(".") or domain.contains("..") or not domain.contains(".") {
        return false;
    }

    let allowed_user_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.!#$%&'*+-/=?^_`{|}~";
    for ch in user.split("") {
        if not allowed_user_chars.contains(ch) {
            return false;
        }
    }

    let dot_parts = domain.split(".");
    if dot_parts.len() < 2 {
        return false;
    }

    let allowed_domain_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-";
    for label in dot_parts {
        if label.len() == 0 or label.len() > 63 {
            return false;
        }
        if label.starts_with("-") or label.ends_with("-") {
            return false;
        }
        for ch in label.split("") {
            if not allowed_domain_chars.contains(ch) {
                return false;
            }
        }
    }

    let tld = dot_parts[dot_parts.len() - 1];
    if tld.len() < 2 {
        return false;
    }
    let digits = "0123456789";
    let all_digits = true;
    for ch in tld.split("") {
        if not digits.contains(ch) {
            all_digits = false;
        }
    }
    if all_digits {
        return false;
    }

    return true;
}

fn is_valid_url(val_str: string) -> bool {
    if val_str.contains(" ") or val_str.contains("\t") or val_str.contains("\r") or val_str.contains("\n") {
        return false;
    }
    let rest = "";
    if val_str.starts_with("https://") {
        rest = val_str.slice(8, val_str.len());
    } elif val_str.starts_with("http://") {
        rest = val_str.slice(7, val_str.len());
    } else {
        return false;
    }
    if rest.len() == 0 or rest.starts_with("/") or rest.starts_with(".") {
        return false;
    }
    return true;
}

fn is_valid_uuid(val_str: string) -> bool {
    if val_str.len() != 36 {
        return false;
    }
    let parts = val_str.lower().split("-");
    if parts.len() != 5 {
        return false;
    }
    if parts[0].len() != 8 or parts[1].len() != 4 or parts[2].len() != 4 or parts[3].len() != 4 or parts[4].len() != 12 {
        return false;
    }
    let hex_chars = "0123456789abcdef-";
    for ch in val_str.lower().split("") {
        if not hex_chars.contains(ch) {
            return false;
        }
    }
    return true;
}

public class Validator {
    public let errors;
    public let failed;
    public let validated_data;

    fn new() {
        self.errors = map();
        self.failed = false;
        self.validated_data = map();
    }

    public fn add_error(self, field: string, message: string) {
        self.failed = true;
        if not self.errors.has(field) {
            self.errors[field] = list();
        }
        self.errors[field].push(message);
    }

    public fn fails(self) -> bool {
        return self.failed;
    }

    public fn passes(self) -> bool {
        return not self.failed;
    }

    public fn validated(self) {
        return self.validated_data;
    }

    public fn error_messages(self) {
        return self.errors;
    }

    public fn first_error(self, field: string) {
        if self.errors.has(field) and self.errors[field].len() > 0 {
            return self.errors[field][0];
        }
        return "";
    }

    public fn first(self) -> string {
        for f in self.errors.keys() {
            let list_err = self.errors[f];
            if list_err != null and list_err.len() > 0 {
                return string(list_err[0]);
            }
        }
        return "";
    }

    public fn all_errors(self) {
        let all = list();
        for f in self.errors.keys() {
            let list_err = self.errors[f];
            if list_err != null {
                for msg in list_err {
                    all.push(string(msg));
                }
            }
        }
        return all;
    }

    public fn error_summary(self, sep: string = " ") -> string {
        let all = self.all_errors();
        if all.len() == 0 {
            return "";
        }
        return all.join(sep);
    }

    // ------------------------------------------------------------------
    // Rule engine
    // ------------------------------------------------------------------
    // Evaluate `rules` against the request. Reads input through the
    // request's own input() (body -> query -> route params). Returns the
    // Validator so callers can chain fails()/error_summary()/validated().
    public fn check(self, req, rules) {
        let validator = new Validator();

        for field in rules.keys() {
            let rule_str = string(rules[field]);
            let field_rules = rule_str.split("|");
            let val = req.input(field, null);
            let val_str = "";
            if val != null { val_str = string(val).trim(); }

            // The "nullable" modifier: empty values pass every other rule.
            let skip_if_empty = false;
            let coerce_to = "";
            for nr in field_rules {
                let nrt = nr.trim();
                if nrt == "nullable" {
                    skip_if_empty = true;
                } elif nrt == "integer" or nrt == "int" {
                    coerce_to = "int";
                } elif nrt == "numeric" or nrt == "float" {
                    if coerce_to == "" { coerce_to = "float"; }
                } elif nrt == "boolean" or nrt == "bool" {
                    coerce_to = "bool";
                } elif nrt == "array" or nrt == "list" {
                    coerce_to = "list";
                } elif nrt == "map" {
                    coerce_to = "map";
                }
            }
            if skip_if_empty and (val == null or val_str == "") {
                validator.validated_data[field] = null;
                continue;
            }

            let field_had_error = false;
            for r in field_rules {
                let r_trimmed = r.trim();
                let rule_name = r_trimmed;
                let rule_arg = "";
                let colon_idx = r_trimmed.index_of(":");
                if colon_idx >= 0 {
                    rule_name = r_trimmed.slice(0, colon_idx).trim();
                    rule_arg = r_trimmed.slice(colon_idx + 1).trim();
                }

                if rule_name == "required" {
                    if val == null or (type_of(val) == "string" and val_str == "") or (type_of(val) == "list" and val.len() == 0) {
                        validator.add_error(field, "The " + field + " field is required.");
                        field_had_error = true;
                    }
                } elif rule_name == "min" {
                    if val_str != "" {
                        let min_len = int(rule_arg);
                        if val_str.len() < min_len {
                            validator.add_error(field, "The " + field + " must be at least " + rule_arg + " characters.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "max" {
                    if val_str != "" {
                        let max_len = int(rule_arg);
                        if val_str.len() > max_len {
                            validator.add_error(field, "The " + field + " must not exceed " + rule_arg + " characters.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "between" {
                    if val_str != "" and rule_arg.contains(",") {
                        let b_parts = rule_arg.split(",");
                        let low = float(b_parts[0].trim());
                        let high = float(b_parts[1].trim());
                        if coerce_to == "int" or coerce_to == "float" {
                            try {
                                let n = float(val_str);
                                if n < low or n > high {
                                    validator.add_error(field, "The " + field + " must be between " + b_parts[0].trim() + " and " + b_parts[1].trim() + ".");
                                    field_had_error = true;
                                }
                            } catch (_e) {
                                validator.add_error(field, "The " + field + " must be a number.");
                                field_had_error = true;
                            }
                        } else {
                            let slen = float(val_str.len());
                            if slen < low or slen > high {
                                validator.add_error(field, "The " + field + " must be between " + b_parts[0].trim() + " and " + b_parts[1].trim() + " characters.");
                                field_had_error = true;
                            }
                        }
                    }
                } elif rule_name == "min_value" {
                    if val_str != "" {
                        let num = 0.0;
                        try {
                            num = float(val_str);
                        } catch (_e) {
                            validator.add_error(field, "The " + field + " must be a number.");
                            field_had_error = true;
                            num = null;
                        }
                        if num != null and num < float(rule_arg) {
                            validator.add_error(field, "The " + field + " must be at least " + rule_arg + ".");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "max_value" {
                    if val_str != "" {
                        let num = 0.0;
                        try {
                            num = float(val_str);
                        } catch (_e) {
                            validator.add_error(field, "The " + field + " must be a number.");
                            field_had_error = true;
                            num = null;
                        }
                        if num != null and num > float(rule_arg) {
                            validator.add_error(field, "The " + field + " must not be greater than " + rule_arg + ".");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "numeric" or rule_name == "float" {
                    if val_str != "" {
                        try {
                            let _f = float(val_str);
                        } catch (_e) {
                            validator.add_error(field, "The " + field + " must be a number.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "integer" or rule_name == "int" {
                    if val_str != "" {
                        try {
                            let _i = int(val_str);
                        } catch (_e) {
                            validator.add_error(field, "The " + field + " must be an integer.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "email" {
                    if val_str != "" {
                        if not is_valid_email(val_str) {
                            validator.add_error(field, "The " + field + " must be a valid email address.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "url" {
                    if val_str != "" {
                        if not is_valid_url(val_str) {
                            validator.add_error(field, "The " + field + " must be a valid URL.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "uuid" {
                    if val_str != "" {
                        if not is_valid_uuid(val_str) {
                            validator.add_error(field, "The " + field + " must be a valid UUID.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "regex" {
                    if val_str != "" and rule_arg != "" {
                        if not regex_match(rule_arg, val_str) {
                            validator.add_error(field, "The " + field + " format is invalid.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "array" or rule_name == "list" {
                    if val != null and type_of(val) != "list" {
                        validator.add_error(field, "The " + field + " must be a list.");
                        field_had_error = true;
                    }
                } elif rule_name == "map" {
                    if val != null and type_of(val) != "map" {
                        validator.add_error(field, "The " + field + " must be a map.");
                        field_had_error = true;
                    }
                } elif rule_name == "unique" {
                    if val_str != "" and rule_arg != "" {
                        let u_parts = rule_arg.split(",");
                        let u_table = u_parts[0].trim();
                        let u_col = field;
                        if u_parts.len() > 1 and u_parts[1].trim() != "" {
                            u_col = u_parts[1].trim();
                        }
                        let q = DB.table(u_table).where(u_col, "=", val_str);
                        if u_parts.len() > 2 and u_parts[2].trim() != "" {
                            q.where("id", "!=", u_parts[2].trim());
                        }
                        if q.exists() {
                            validator.add_error(field, "The " + field + " has already been taken.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "exists" {
                    if val_str != "" and rule_arg != "" {
                        let e_parts = rule_arg.split(",");
                        let e_table = e_parts[0].trim();
                        let e_col = field;
                        if e_parts.len() > 1 and e_parts[1].trim() != "" {
                            e_col = e_parts[1].trim();
                        }
                        if not DB.table(e_table).where(e_col, "=", val_str).exists() {
                            validator.add_error(field, "The selected " + field + " does not exist.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "confirmed" {
                    let conf_val = req.input(field + "_confirmation", null);
                    let conf_str = "";
                    if conf_val != null { conf_str = string(conf_val).trim(); }
                    if val_str != conf_str {
                        validator.add_error(field, "The " + field + " confirmation does not match.");
                        field_had_error = true;
                    }
                } elif rule_name == "same" {
                    let same_val = req.input(rule_arg, null);
                    let same_str = "";
                    if same_val != null { same_str = string(same_val).trim(); }
                    if val_str != same_str {
                        validator.add_error(field, "The " + field + " and " + rule_arg + " must match.");
                        field_had_error = true;
                    }
                } elif rule_name == "in" {
                    if val_str != "" {
                        let allowed = rule_arg.split(",");
                        let matched = false;
                        for a in allowed {
                            if a.trim() == val_str {
                                matched = true;
                            }
                        }
                        if not matched {
                            validator.add_error(field, "The selected " + field + " is invalid.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "boolean" or rule_name == "bool" {
                    if val_str != "" {
                        let b_lower = val_str.lower();
                        if b_lower != "true" and b_lower != "false" and b_lower != "1" and b_lower != "0" and b_lower != "yes" and b_lower != "no" {
                            validator.add_error(field, "The " + field + " field must be true or false.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "alpha" {
                    if val_str != "" {
                        let allowed_alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
                        let all_alpha = true;
                        for ch in val_str.split("") {
                            if not allowed_alpha.contains(ch) {
                                all_alpha = false;
                            }
                        }
                        if not all_alpha {
                            validator.add_error(field, "The " + field + " must only contain letters.");
                            field_had_error = true;
                        }
                    }
                } elif rule_name == "alphanumeric" or rule_name == "alpha_num" {
                    if val_str != "" {
                        let allowed_alphanum = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
                        let all_alphanum = true;
                        for ch in val_str.split("") {
                            if not allowed_alphanum.contains(ch) {
                                all_alphanum = false;
                            }
                        }
                        if not all_alphanum {
                            validator.add_error(field, "The " + field + " must only contain letters and numbers.");
                            field_had_error = true;
                        }
                    }
                }
            }

            // Populate coerced validated_data when field passed validation
            if not field_had_error and val != null {
                if coerce_to == "int" and val_str != "" {
                    try { validator.validated_data[field] = int(val_str); } catch (_e) { validator.validated_data[field] = val; }
                } elif coerce_to == "float" and val_str != "" {
                    try { validator.validated_data[field] = float(val_str); } catch (_e) { validator.validated_data[field] = val; }
                } elif coerce_to == "bool" and val_str != "" {
                    let bl = val_str.lower();
                    validator.validated_data[field] = (bl == "true" or bl == "1" or bl == "yes");
                } elif type_of(val) == "string" {
                    validator.validated_data[field] = val_str;
                } else {
                    validator.validated_data[field] = val;
                }
            }
        }

        return validator;
    }
}
