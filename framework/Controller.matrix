// framework/Controller.matrix
// Spid3rWeb Base Controller — the "C" of the MVC triad.
// Every application controller extends this class and inherits the
// response/view helpers plus shared view data (auth state) that the
// global layout template expects on every page.

import "framework/Response";
import "framework/View/BD";
import "framework/Auth/Auth";

public class Controller {
    fn new() {}

    public fn json(self, data, status: int = 200) {
        return json(data, status);
    }

    public fn view(self, view_name: string, data = null) {
        if data == null {
            data = map();
        }
        return view(view_name, data);
    }

    // Preferred way to render a page: shared data (auth state, csrf token,
    // admin flag) is merged automatically. Controllers just write:
    //   return self.render(req, "store.index", map("title", "Hello"));
    public fn render(self, req, view_name: string, data = null) {
        if data == null {
            data = map();
        }
        return self.view(view_name, self.shared(data, req));
    }

    // Raw body response with an explicit content type — for XML feeds,
    // plain text, downloads. No header juggling in controllers.
    public fn respond(self, body: string, content_type: string, status: int = 200) {
        let res = response(body, status);
        res.header("content-type", content_type);
        return res;
    }

    public fn redirect(self, url: string, status: int = 302) {
        return redirect(url, status);
    }

    public fn validate(self, req, rules) {
        return req.validate(rules);
    }

    // ------------------------------------------------------------------
    // Auth resolution
    // ------------------------------------------------------------------
    // Prefer the request-scoped AuthManager (safe under concurrent
    // requests). Falls back to the global facade when called without a
    // request (CLI, tests, legacy code paths).
    public fn auth(self, req = null) {
        if req != null and req.auth != null {
            return req.auth;
        }
        return Auth;
    }

    // ------------------------------------------------------------------
    // Developer / test mode demo logins
    //
    // The storefront shows the seeded demo accounts (admin + customer) so a
    // developer can sign in with one click. This is deliberately gated:
    //   * APP_ENV=production / prod / live  -> never shown
    //   * SPID3R_SHOW_DEMO_LOGINS=0         -> explicitly hidden
    //   * SPID3R_ADMIN_EMAIL set            -> hidden (real admin, real
    //     password must never be printed) unless the flag is forced to 1
    // Defaults mirror database/seeders/DatabaseSeeder.matrix.
    // ------------------------------------------------------------------
    fn env_value(self, key: string) -> string {
        if env(key).is_some() {
            return string(env(key).unwrap()).trim();
        }
        return "";
    }

    public fn demo_mode(self) -> bool {
        let app_env = self.env_value("APP_ENV").lower();
        if app_env == "" {
            app_env = "development";
        }
        if app_env == "production" or app_env == "prod" or app_env == "live" {
            return false;
        }

        let flag = self.env_value("SPID3R_SHOW_DEMO_LOGINS").lower();
        if flag == "0" or flag == "false" or flag == "no" {
            return false;
        }
        let forced = flag == "1" or flag == "true" or flag == "yes";

        if self.env_value("SPID3R_ADMIN_EMAIL") != "" and not forced {
            return false;
        }
        return true;
    }

    public fn demo_accounts(self) {
        if not self.demo_mode() {
            return list();
        }

        let admin_email = self.env_value("SPID3R_DEMO_ADMIN_EMAIL");
        if admin_email == "" {
            admin_email = "admin@spid3r.test";
        }
        let admin_pw = self.env_value("SPID3R_DEMO_ADMIN_PASSWORD");
        if admin_pw == "" {
            admin_pw = "secret123";
        }
        let customer_email = self.env_value("SPID3R_DEMO_CUSTOMER_EMAIL");
        if customer_email == "" {
            customer_email = "ada@example.com";
        }
        let customer_pw = self.env_value("SPID3R_DEMO_CUSTOMER_PASSWORD");
        if customer_pw == "" {
            customer_pw = "secret123";
        }

        return list(
            map("label", "Admin", "hint", "Admin panel access", "email", admin_email, "password", admin_pw),
            map("label", "Customer", "hint", "Shop and checkout", "email", customer_email, "password", customer_pw)
        );
    }

    // ------------------------------------------------------------------
    // Shared view data
    // Merges caller data with the auth-state variables the global store
    // layout renders in the navbar (is_auth, user_name), the CSRF token and
    // the dev-mode demo accounts. Prefer render(), which calls this for you:
    //   return self.render(req, "store.index", map(...));
    // ------------------------------------------------------------------
    public fn shared(self, data = null, req = null) {
        if data == null {
            data = map();
        }
        let auth = self.auth(req);
        data["is_auth"] = auth.check();

        let user_name = "";
        let user = auth.user();
        if user != null and user.has("name") {
            user_name = string(user["name"]);
        }
        data["user_name"] = user_name;
        data["csrf_token"] = auth.csrf();

        // Admin flag for the navbar link (false for guests/non-admins).
        data["is_admin"] = false;
        if user != null and user.has("is_admin") and user["is_admin"] != null {
            if string(user["is_admin"]) == "1" {
                data["is_admin"] = true;
            }
        }

        // Demo credentials are exposed to views ONLY in dev/test mode.
        data["demo_mode"] = self.demo_mode();
        data["demo_accounts"] = self.demo_accounts();
        return data;
    }
}
