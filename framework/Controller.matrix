// framework/Controller.matrix
// Spid3rWeb Base Controller — the "C" of the MVC triad.
// Every application controller extends this class and inherits fluent
// response/view helpers plus shared view context (auth state, CSRF token).

import "framework/Response";
import "framework/View/BD";
import "framework/Auth/Auth";

public class Controller {
    fn new() {}

    public fn json(self, data, status: int = 200) {
        return json(data, status);
    }

    public fn ok(self, data) {
        return json(data, 200);
    }

    public fn created(self, data) {
        return json(data, 201);
    }

    public fn no_content(self) {
        return response("", 204);
    }

    public fn view(self, view_name: string, data = null) {
        if data == null {
            data = map();
        }
        return view(view_name, data);
    }

    // Preferred way to render a page: shared data (auth state, user, csrf_token)
    // is merged automatically. Controllers just write:
    //   return self.render(req, "posts.index", {"posts": posts});
    public fn render(self, req, view_name: string, data = null) {
        if data == null {
            data = map();
        }
        return self.view(view_name, self.shared(data, req));
    }

    // Raw body response with an explicit content type — for XML feeds,
    // plain text, downloads.
    public fn respond(self, body: string, content_type: string, status: int = 200) {
        let res = response(body, status);
        res.header("content-type", content_type);
        return res;
    }

    public fn redirect(self, url: string, status: int = 302) {
        return redirect(url, status);
    }

    public fn back(self, req, fallback: string = "/") {
        let referer = "";
        if req != null {
            referer = string(req.header("referer", fallback));
        }
        if referer == "" {
            referer = fallback;
        }
        return redirect(referer, 302);
    }

    public fn validate(self, req, rules) {
        return req.validate(rules);
    }

    public fn validate_or_fail(self, req, rules) {
        return req.validate_or_fail(rules);
    }

    // Prefer the request-scoped AuthManager (safe under concurrent requests).
    public fn auth(self, req = null) {
        if req != null and req.auth != null {
            return req.auth;
        }
        return Auth;
    }

    // Merges caller data with auth-state variables (`is_auth`, `user`, `user_name`,
    // `csrf_token`, `is_admin`).
    public fn shared(self, data = null, req = null) {
        if data == null {
            data = map();
        }
        let auth = self.auth(req);
        data["is_auth"] = auth.check();

        let user_name = "";
        let user = auth.user();
        data["user"] = user;
        if user != null and user.has("name") {
            user_name = string(user["name"]);
        }
        data["user_name"] = user_name;
        data["csrf_token"] = auth.csrf();

        data["is_admin"] = false;
        if user != null and user.has("is_admin") and user["is_admin"] != null {
            let adm = string(user["is_admin"]).lower();
            if adm == "1" or adm == "true" {
                data["is_admin"] = true;
            }
        }
        return data;
    }
}
