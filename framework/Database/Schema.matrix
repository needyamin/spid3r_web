// framework/Database/Schema.matrix
// Spid3rWeb DDL Schema Builder & Blueprint (multi-dialect: sqlite, postgres, mysql/mariadb)

import "DB";
import "Connection";

public class ColumnDefinition {
    public let name;
    public let kind;        // id | string | text | integer | float | boolean
    public let len;         // varchar length for string columns
    public let is_primary;
    public let is_unique;
    public let is_nullable;
    public let default_value;

    fn new(name: string, kind: string, len: int = 255) {
        self.name = name;
        self.kind = kind;
        self.len = len;
        self.is_primary = false;
        self.is_unique = false;
        self.is_nullable = false;
        self.default_value = null;
    }

    public fn unique(self) {
        self.is_unique = true;
        return self;
    }

    public fn nullable(self) {
        self.is_nullable = true;
        return self;
    }

    public fn default(self, val) {
        self.default_value = val;
        return self;
    }

    // Per-dialect base type mapping
    fn base_sql(self, dialect: string) -> string {
        if self.kind == "id" {
            if dialect == "postgres" {
                return "SERIAL PRIMARY KEY";
            }
            if dialect == "mysql" {
                return "INT AUTO_INCREMENT PRIMARY KEY";
            }
            return "INTEGER PRIMARY KEY AUTOINCREMENT";
        }
        if self.kind == "string" {
            if dialect == "postgres" {
                return "VARCHAR(" + string(self.len) + ")";
            }
            if dialect == "mysql" {
                return "VARCHAR(" + string(self.len) + ")";
            }
            return "TEXT";
        }
        if self.kind == "text" {
            return "TEXT";
        }
        if self.kind == "integer" {
            if dialect == "mysql" {
                return "INT";
            }
            return "INTEGER";
        }
        if self.kind == "float" {
            if dialect == "postgres" {
                return "DOUBLE PRECISION";
            }
            if dialect == "mysql" {
                return "DOUBLE";
            }
            return "REAL";
        }
        if self.kind == "boolean" {
            if dialect == "postgres" {
                return "BOOLEAN";
            }
            if dialect == "mysql" {
                return "TINYINT(1)";
            }
            return "INTEGER";
        }
        return "TEXT";
    }

    public fn to_sql(self, dialect: string = "sqlite") -> string {
        let parts = [self.name, self.base_sql(dialect)];
        if self.is_unique {
            parts.push("UNIQUE");
        }
        if not self.is_nullable and not self.is_primary {
            parts.push("NOT NULL");
        }
        if self.default_value != null {
            if type_of(self.default_value) == "string" {
                parts.push("DEFAULT '" + string(self.default_value) + "'");
            } elif type_of(self.default_value) == "bool" {
                if dialect == "postgres" {
                    if self.default_value { parts.push("DEFAULT TRUE"); } else { parts.push("DEFAULT FALSE"); }
                } else {
                    if self.default_value { parts.push("DEFAULT 1"); } else { parts.push("DEFAULT 0"); }
                }
            } else {
                parts.push("DEFAULT " + string(self.default_value));
            }
        }
        return parts.join(" ");
    }
}

public class Blueprint {
    public let columns;

    fn new() {
        self.columns = [];
    }

    public fn id(self, name: string = "id") {
        let col = new ColumnDefinition(name, "id");
        self.columns.push(col);
        return col;
    }

    public fn string(self, name: string, len: int = 255) {
        let col = new ColumnDefinition(name, "string", len);
        self.columns.push(col);
        return col;
    }

    public fn text(self, name: string) {
        let col = new ColumnDefinition(name, "text");
        self.columns.push(col);
        return col;
    }

    public fn integer(self, name: string) {
        let col = new ColumnDefinition(name, "integer");
        self.columns.push(col);
        return col;
    }

    public fn float(self, name: string) {
        let col = new ColumnDefinition(name, "float");
        self.columns.push(col);
        return col;
    }

    public fn boolean(self, name: string) {
        let col = new ColumnDefinition(name, "boolean");
        self.columns.push(col);
        return col;
    }

    // Timestamps stay TEXT/VARCHAR across dialects because the Active Record
    // layer stores unix_time() string values in created_at / updated_at.
    public fn timestamps(self) {
        let c1 = new ColumnDefinition("created_at", "text");
        c1.nullable();
        self.columns.push(c1);

        let c2 = new ColumnDefinition("updated_at", "text");
        c2.nullable();
        self.columns.push(c2);
    }

    public fn to_sql(self, table_name: string, dialect: string = "sqlite") -> string {
        let col_defs = [];
        for col in self.columns {
            col_defs.push(col.to_sql(dialect));
        }
        return "CREATE TABLE IF NOT EXISTS " + table_name + " (\n  " + col_defs.join(",\n  ") + "\n);";
    }
}

public class SchemaBuilder {
    fn new() {}

    fn dialect(self) -> string {
        let d = DB.driver_name();
        // MariaDB uses MySQL DDL
        if d == "mariadb" {
            return "mysql";
        }
        return d;
    }

    // Table/column identifiers are interpolated into DDL — validate them
    // with the shared identifier guard so user-influenced names can never
    // inject SQL.
    fn check_identifier(self, name: string) -> string {
        return sql_check_identifier(name);
    }

    public fn create(self, table_name: string, callback) {
        let blueprint = new Blueprint();
        callback(blueprint);
        let sql = blueprint.to_sql(self.check_identifier(table_name), self.dialect());
        DB.statement(sql);
        return true;
    }

    // ALTER TABLE helper: add new columns to an existing table.
    // Emits one ALTER TABLE ... ADD COLUMN per column in the blueprint.
    // Note: Column.to_sql() already renders "name TYPE", so no extra
    // name prefix here. Duplicate-column errors are tolerated so the
    // call is idempotent.
    public fn table(self, table_name: string, callback) {
        let blueprint = new Blueprint();
        callback(blueprint);
        let safe_name = self.check_identifier(table_name);
        for col in blueprint.columns {
            let sql = "ALTER TABLE " + safe_name + " ADD COLUMN "
                + col.to_sql(self.dialect()) + ";";
            try {
                DB.statement(sql);
            } catch (e) {
                // Only tolerate "column already exists" — anything else
                // (syntax, locking, permissions) is a real failure and
                // must not be silently recorded as applied.
                let msg = string(e).lower();
                if msg.contains("duplicate column") or msg.contains("already exists") or msg.contains("42701") {
                    // Column already exists — treat as applied.
                } else {
                    throw e;
                }
            }
        }
        return true;
    }

    public fn dropIfExists(self, table_name: string) {
        let sql = "DROP TABLE IF EXISTS " + self.check_identifier(table_name) + ";";
        DB.statement(sql);
        return true;
    }
}

public let Schema = new SchemaBuilder();
