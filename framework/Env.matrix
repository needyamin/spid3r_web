// framework/Env.matrix
// Spid3rWeb Environment File Loader (.env)
//
// Loads KEY=VALUE pairs from a .env file at project root. Real OS environment
// variables ALWAYS win — .env only fills in values that are unset/empty.
// Called automatically before the DB singleton is constructed (see DB.matrix),
// so driver selection and connection settings can be controlled per-project
// without exporting variables manually.
//
// Supported syntax:
//   KEY=value
//   KEY="quoted value"        (quotes are stripped)
//   export KEY=value          (shell-style prefix is stripped)
//   # comment                 (blank lines and # comments are skipped)

public fn load_env_file(path: string = ".env") -> bool {
    if not file_exists(path) {
        return false;
    }
    let res = read_file(path);
    if res.is_err() {
        return false;
    }
    let content = res.unwrap();

    for raw_line in content.split("\n") {
        let line = raw_line.trim();
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        // Optional shell-style "export " prefix
        if line.starts_with("export ") {
            line = line.slice(7, line.len()).trim();
        }

        let eq = line.index_of("=");
        if eq <= 0 {
            continue;
        }
        let key = line.slice(0, eq).trim();
        let mut_val = line.slice(eq + 1, line.len()).trim();

        // Strip one pair of surrounding quotes
        if mut_val.len() >= 2 {
            if (mut_val.starts_with("\"") and mut_val.ends_with("\"")) or (mut_val.starts_with("'") and mut_val.ends_with("'")) {
                mut_val = mut_val.slice(1, mut_val.len() - 1);
            }
        }

        if key.len() == 0 {
            continue;
        }

        // Precedence: real OS environment always wins over .env
        let existing = env(key);
        if existing.is_some() and string(existing.unwrap()) != "" {
            continue;
        }
        env_set(key, mut_val);
    }
    return true;
}
