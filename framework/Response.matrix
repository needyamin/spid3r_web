// framework/Response.matrix
// Spid3rWeb HTTP Response Builder & Helpers

import "http";
import "framework/Env";
import "framework/Config/Config";

fn init_hsts_enabled() -> bool {
    let hsts = env("SPID3R_HSTS");
    return hsts.is_some() and string(hsts.unwrap()).trim().lower() == "1";
}

let HSTS_ENABLED = init_hsts_enabled();

fn resolve_response_cookie_secret() -> string {
    let app_key = string(Config.get("app.key", ""));
    if app_key != "" {
        return app_key;
    }
    let env_key = env("APP_KEY");
    if env_key.is_some() and string(env_key.unwrap()).trim() != "" {
        return string(env_key.unwrap()).trim();
    }
    return "spid3rweb-default-cookie-secret-key";
}

public class Response {
    public let status_code;
    public let headers;
    public let body;

    fn new(body = "", status_code: int = 200) {
        self.body = string(body);
        self.status_code = status_code;
        // Sensible security headers on every response. CORS headers are
        // intentionally NOT global defaults: blanket access-control-allow-*
        // should only be set by CorsMiddleware / API routing, never on
        // cookie-authenticated HTML responses.
        self.headers = map(
            "content-type", "text/html; charset=utf-8",
            "x-content-type-options", "nosniff",
            "x-frame-options", "SAMEORIGIN",
            "referrer-policy", "strict-origin-when-cross-origin",
            "x-permitted-cross-domain-policies", "none",
            "cross-origin-opener-policy", "same-origin",
            "permissions-policy", "camera=(), microphone=(), geolocation=()",
            "content-security-policy", "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
        );
        if HSTS_ENABLED {
            self.headers["strict-transport-security"] = "max-age=31536000; includeSubDomains";
        }
    }

    // Header names and values must never carry CRLF — a single \r or \n
    // enables HTTP response splitting. Values are rejected, not sanitized,
    // so misuse fails loudly instead of silently corrupting headers.
    fn is_header_safe(self, value: string) -> bool {
        return not value.contains("\r") and not value.contains("\n") and not value.contains(chr(0));
    }

    public fn header(self, key: string, value: string) {
        let k = string(key).lower();
        if not self.is_header_safe(string(value)) {
            throw "Response.header: illegal character (CR/LF/NUL) in header value for '" + k + "'";
        }
        self.headers[k] = string(value);
        return self;
    }

    public fn withHeaders(self, new_headers) {
        for k in new_headers.keys() {
            self.header(k, string(new_headers[k]));
        }
        return self;
    }

    public fn cookie(self, name: string, value: string, path: string = "/", max_age: int = 86400, secure = null) {
        if not self.is_header_safe(name) or not self.is_header_safe(value) {
            throw "Response.cookie: illegal character (CR/LF/NUL) in cookie name or value";
        }
        // Secure flag: explicit argument wins; then SPID3R_COOKIE_SECURE=1;
        // then config/session.matrix "secure"; then a production APP_ENV.
        let secure_flag = false;
        if secure != null {
            secure_flag = secure == true or secure == 1 or string(secure) == "1" or string(secure) == "true";
        } else {
            let env_secure = env("SPID3R_COOKIE_SECURE");
            if env_secure.is_some() and string(env_secure.unwrap()).trim() == "1" {
                secure_flag = true;
            } else {
                let cfg_secure = Config.get("session.secure", false);
                if cfg_secure == true {
                    secure_flag = true;
                } else {
                    let app_env = env("APP_ENV");
                    if app_env.is_some() and string(app_env.unwrap()).trim().lower() == "production" {
                        secure_flag = true;
                    }
                }
            }
        }
        // HttpOnly / SameSite come from config/session.matrix (defaults keep
        // the historical "HttpOnly; SameSite=Lax" behavior).
        let cookie_str = name + "=" + value + "; Path=" + path + "; Max-Age=" + string(max_age);
        let httponly = Config.get("session.httponly", true);
        if httponly == true {
            cookie_str = cookie_str + "; HttpOnly";
        }
        cookie_str = cookie_str + "; SameSite=" + string(Config.get("session.same_site", "Lax"));
        if secure_flag {
            cookie_str = cookie_str + "; Secure";
        }
        // Support multiple cookies per response: comma-join Set-Cookie values
        // (safe here — cookies use Max-Age, never Expires dates).
        if self.headers.has("set-cookie") {
            self.headers["set-cookie"] = string(self.headers["set-cookie"]) + ", " + cookie_str;
        } else {
            self.headers["set-cookie"] = cookie_str;
        }
        return self;
    }

    public fn signed_cookie(self, name: string, value: string, path: string = "/", max_age: int = 86400, secure = null) {
        let sig = hmac_sha256(resolve_response_cookie_secret(), name + "=" + value);
        return self.cookie(name, value + "." + sig, path, max_age, secure);
    }

    public fn clear_cookie(self, name: string, path: string = "/") {
        return self.cookie(name, "", path, 0);
    }

    public fn status(self, code: int) {
        self.status_code = code;
        return self;
    }

    // Express-style fluent methods on `res` (`res.status(201).json(data)`)
    public fn json(self, data, status: int = 0) {
        if status > 0 {
            self.status_code = status;
        }
        self.body = json_write(data);
        self.header("content-type", "application/json; charset=utf-8");
        return self;
    }

    public fn html(self, content: string, status: int = 0) {
        if status > 0 {
            self.status_code = status;
        }
        self.body = string(content);
        self.header("content-type", "text/html; charset=utf-8");
        return self;
    }

    public fn text(self, content: string, status: int = 0) {
        if status > 0 {
            self.status_code = status;
        }
        self.body = string(content);
        self.header("content-type", "text/plain; charset=utf-8");
        return self;
    }

    public fn send(self, content, status: int = 0) {
        if status > 0 {
            self.status_code = status;
        }
        let t = type_of(content);
        if t == "map" or t == "list" {
            return self.json(content);
        }
        return self.html(string(content));
    }

    public fn redirect(self, url: string, status: int = 302) {
        self.status_code = status;
        self.body = "";
        self.header("location", url);
        return self;
    }

    public fn to_http(self) {
        return http_response(self.status_code, self.headers, self.body);
    }
}

// ----------------------------------------------------------------------------
// Global Fluent Response Helpers
// ----------------------------------------------------------------------------

public fn response(content = "", status: int = 200) {
    return new Response(content, status);
}

public fn json(data, status: int = 200) {
    let res = new Response(json_write(data), status);
    res.header("content-type", "application/json; charset=utf-8");
    return res;
}

public fn html(content: string, status: int = 200) {
    let res = new Response(content, status);
    res.header("content-type", "text/html; charset=utf-8");
    return res;
}

public fn text(content: string, status: int = 200) {
    let res = new Response(content, status);
    res.header("content-type", "text/plain; charset=utf-8");
    return res;
}

public fn text_405(allow: string) {
    let res = new Response("405 Method Not Allowed", 405);
    res.header("content-type", "text/plain; charset=utf-8");
    res.header("allow", allow);
    return res;
}

public fn redirect(url: string, status: int = 302) {
    let res = new Response("", status);
    res.header("location", url);
    return res;
}
