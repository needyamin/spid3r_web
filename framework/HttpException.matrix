// framework/HttpException.matrix
// Spid3rWeb Typed HTTP Exceptions
//
// Handlers, middleware, and resources can abort request processing with a
// meaningful status code instead of a generic 500:
//
//   import "framework/HttpException";
//
//   let post = DB.table("posts").find(id);
//   if post == null {
//       throw not_found("Post not found.");
//   }
//   throw validation_failed(map("email", "The email has already been taken."));
//
// Application.handle_request catches these centrally and renders them
// through ErrorRenderer.http_error: JSON payloads for /api/* paths and
// Accept: application/json clients, HTML error cards otherwise. Anything
// thrown that is NOT an http exception still becomes a 500 with a generic
// message — internal details never leak.
//
// Exceptions are plain maps carrying a marker key (Spid3r's type_of cannot
// tell class instances apart), built exclusively by the helpers below.

// The one true constructor — helpers feed it; is_http_exception() checks it.
public fn make_http_exception(status: int, message: string, errors = null) {
    let e = map(
        "__spid3rweb_exception", true,
        "status", status,
        "message", message
    );
    if errors != null {
        e["errors"] = errors;
    }
    return e;
}

public fn is_http_exception(e) -> bool {
    return type_of(e) == "map" and e.has("__spid3rweb_exception") and e["__spid3rweb_exception"] == true;
}

// 400 — malformed request syntax.
public fn bad_request(message: string = "Bad Request.") {
    return make_http_exception(400, message);
}

// 401 — unauthenticated (who are you?).
public fn unauthorized(message: string = "Authentication required.") {
    return make_http_exception(401, message);
}

// 403 — authenticated but not allowed (I know who you are; no).
public fn forbidden(message: string = "This action is unauthorized.") {
    return make_http_exception(403, message);
}

// 404 — resource does not exist.
public fn not_found(message: string = "Not Found.") {
    return make_http_exception(404, message);
}

// 422 — request parsed but semantically invalid; `errors` maps field names
// to their messages (validated with the framework Validator or by hand).
public fn validation_failed(errors, message: string = "The given data was invalid.") {
    return make_http_exception(422, message, errors);
}

// 429 — rate limit exceeded.
public fn too_many_requests(message: string = "Too Many Requests.") {
    return make_http_exception(429, message);
}
