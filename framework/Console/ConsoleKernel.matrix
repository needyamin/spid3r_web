// framework/Console/ConsoleKernel.matrix
// Spid3rWeb Magic CLI Command Engine

import "framework/Router";
import "framework/Application";
import "framework/Database/DB";
import "framework/Database/Schema";
import "framework/Database/Migration";

public class ConsoleKernel {
    public let migrations_list;
    public let seeders_list;

    fn new() {
        self.migrations_list = list();
        self.seeders_list = list();
    }

    public fn register_migration(self, migration) {
        self.migrations_list.push(migration);
    }

    public fn register_seeder(self, seeder_fn) {
        self.seeders_list.push(seeder_fn);
    }

    public fn handle(self, cli_args) {
        if cli_args.len() == 0 or cli_args[0] == "help" or cli_args[0] == "--help" or cli_args[0] == "-h" {
            self.print_help();
            return 0;
        }

        let command = cli_args[0];

        if command == "serve" {
            let port = "8000";
            let dry_run = false;
            let i = 1;
            while i < cli_args.len() {
                let p_arg = cli_args[i];
                if p_arg.starts_with("--port=") {
                    port = p_arg.replace("--port=", "");
                } elif p_arg == "--port" and i + 1 < cli_args.len() {
                    i = i + 1;
                    port = cli_args[i];
                } elif p_arg == "--dry-run" or p_arg == "--check" {
                    dry_run = true;
                } else {
                    port = p_arg;
                }
                i = i + 1;
            }
            return self.command_serve(int(port), dry_run);
        } elif command == "test" {
            return self.command_test(cli_args);
        } elif command == "route:list" {
            return self.command_route_list();
        } elif command == "migrate" {
            return self.command_migrate();
        } elif command == "migrate:sync" {
            return self.command_migrate_sync();
        } elif command == "migrate:rollback" {
            return self.command_rollback();
        } elif command == "migrate:status" {
            return self.command_migrate_status();
        } elif command == "db:seed" {
            return self.command_db_seed();
        } elif command == "make:controller" {
            if cli_args.len() < 2 {
                println("Error: Not enough arguments (missing controller name). Usage: make:controller <Name>");
                return 1;
            }
            return self.command_make_controller(cli_args[1]);
        } elif command == "make:model" {
            if cli_args.len() < 2 {
                println("Error: Not enough arguments (missing model name). Usage: make:model <Name> [-m]");
                return 1;
            }
            let make_mig = false;
            if cli_args.len() > 2 and cli_args[2] == "-m" {
                make_mig = true;
            }
            return self.command_make_model(cli_args[1], make_mig);
        } elif command == "make:migration" {
            if cli_args.len() < 2 {
                println("Error: Not enough arguments (missing migration name). Usage: make:migration <name>");
                return 1;
            }
            return self.command_make_migration(cli_args[1]);
        } else {
            println("Unknown command: '" + command + "'. Run 'spid3r magic help' for a list of available commands.");
            return 1;
        }
    }

    fn print_help(self) {
        println("==================================================================");
        println("         Spid3rWeb Magic CLI (Developer Tooling for Spid3r)       ");
        println("==================================================================");
        println("Usage:");
        println("  spid3r magic <command> [arguments] [options]\n");
        println("Available commands:");
        println("  serve [--port N]          Start the Spid3rWeb local development server");
        println("  test [options]            Run the Spid3rWeb automated test suite");
        println("  route:list                List all registered application routes");
        println("  migrate                   Run outstanding database migrations");
        println("  migrate:sync              Re-scan database/migrations and rebuild the registry");
        println("  migrate:rollback          Rollback the last database migration batch");
        println("  migrate:status            Show the status of each migration");
        println("  db:seed                   Seed the database with records");
        println("  make:controller <Name>    Create a new controller class");
        println("  make:model <Name> [-m]    Create a new Active Record model (optional migration)");
        println("  make:migration <name>     Create a new database migration file");
        println("  help                      Display this help message\n");
    }

    // ------------------------------------------------------------------------
    // Command Implementations
    // ------------------------------------------------------------------------

    fn command_serve(self, port: int, dry_run: bool = false) -> int {
        println("Starting Spid3rWeb development server: http://127.0.0.1:" + string(port));
        println("Press Ctrl+C to stop the server.");
        if dry_run {
            DB.close();
            return 0;
        }
        let app = new Application();
        app.listen(port);
        DB.close();
        return 0;
    }

    fn resolve_spid3r_binary(self) -> string {
        let cur = exe_path();
        if cur.is_ok() {
            let p = cur.unwrap();
            if file_exists(p) {
                return p;
            }
        }

        let env_keys = list(
            "SPID3R_BIN",
            "SPID3R_EXE",
            "CARGO_BIN_EXE_spid3r",
            "CARGO_BIN_EXE_spidr"
        );
        for k in env_keys {
            let v = env(k);
            if v.is_some() {
                let p = v.unwrap();
                if file_exists(p) {
                    return p;
                }
            }
        }

        let candidates = list(
            "target/debug/spid3r.exe",
            "target/debug/spid3r",
            "../../target/debug/spid3r.exe",
            "../../target/debug/spid3r",
            "target/release/spid3r.exe",
            "target/release/spid3r",
            "../../target/release/spid3r.exe",
            "../../target/release/spid3r"
        );
        for c in candidates {
            if file_exists(c) {
                return c;
            }
        }

        return "spid3r";
    }

    fn cleanup_db_artifacts(self) {
        let root = self.resolve_root();
        let candidates = list(
            root + "database/database.sqlite",
            "database/database.sqlite",
            "examples/spid3r_web/database/database.sqlite"
        );
        for p in candidates {
            let shm_file = p + "-shm";
            let wal_file = p + "-wal";
            if file_exists(shm_file) {
                file_delete(shm_file);
            }
            if file_exists(wal_file) {
                file_delete(wal_file);
            }
        }
    }

    fn command_test(self, cli_args = null) -> int {
        let root = self.resolve_root();
        if root != "" {
            env_set("SPID3R_PATH", root);
        } else {
            env_set("SPID3R_PATH", ".");
        }

        let spid3r_bin = self.resolve_spid3r_binary();

        let filter_substr = "";
        let engine_override = "";
        if cli_args != null {
            let i = 1;
            while i < cli_args.len() {
                let arg = cli_args[i];
                if arg.starts_with("--filter=") {
                    filter_substr = arg.replace("--filter=", "");
                } elif arg == "--filter" and i + 1 < cli_args.len() {
                    i = i + 1;
                    filter_substr = cli_args[i];
                } elif arg.starts_with("--engine=") {
                    engine_override = arg.replace("--engine=", "");
                } elif arg == "--engine" and i + 1 < cli_args.len() {
                    i = i + 1;
                    engine_override = cli_args[i];
                }
                i = i + 1;
            }
        }

        println("==================================================================");
        println("            Spid3rWeb Complete Test Suite Execution               ");
        println("==================================================================");

        let test_suites = list(
            "tests/test_router.matrix",
            "tests/test_validator.matrix",
            "tests/test_query_builder.matrix",
            "tests/test_model.matrix",
            "tests/test_bd.matrix",
            "tests/test_http_lifecycle.matrix",
            "tests/test_drivers.matrix",
            "tests/test_cache.matrix",
            "tests/test_ecommerce.matrix",
            "tests/test_multi_db_live.matrix"
        );

        let total_run = 0;
        let passed = 0;

        for suite in test_suites {
            if filter_substr != "" and not suite.contains(filter_substr) {
                continue;
            }

            let test_path = suite;
            let candidates = list(
                suite,
                root + suite,
                "examples/spid3r_web/" + suite
            );
            for c in candidates {
                if file_exists(c) {
                    test_path = c;
                    break;
                }
            }

            println("------------------------------------------------------------------");
            println("Running: " + suite);
            println("------------------------------------------------------------------");

            let run_args = list("run");
            if engine_override != "" {
                run_args.push("--engine");
                run_args.push(engine_override);
            }
            run_args.push(test_path);

            let res = exec_capture(spid3r_bin, run_args, null);
            total_run = total_run + 1;

            if res.is_ok() {
                let out = res.unwrap();
                print(out["stdout"]);
                if out["stderr"] != "" {
                    print(out["stderr"]);
                }
                if out["code"] == 0 {
                    passed = passed + 1;
                } else {
                    println("[FAILED]: " + suite + " (exit code " + string(out["code"]) + ")");
                }
            } else {
                println("[EXEC ERROR] " + res.unwrap_err());
                println("[FAILED]: " + suite);
            }
        }

        DB.close();
        self.cleanup_db_artifacts();

        println("==================================================================");
        println("Test Summary: " + string(passed) + "/" + string(total_run) + " test suites passed.");
        println("==================================================================");

        if total_run == 0 or passed < total_run {
            return 1;
        }
        return 0;
    }

    fn command_route_list(self) -> int {
        let routes = Route.routes();
        println("\n+--------+------------------------------------+--------------------------------+");
        println("| Method | URI                                | Action                         |");
        println("+--------+------------------------------------+--------------------------------+");

        for r in routes {
            let m_pad = r.method;
            while m_pad.len() < 6 { m_pad = m_pad + " "; }

            let path_pad = r.path;
            while path_pad.len() < 34 { path_pad = path_pad + " "; }

            let action_str = "Closure";
            if type_of(r.handler) == "string" {
                action_str = r.handler;
            }
            let a_pad = action_str;
            while a_pad.len() < 30 { a_pad = a_pad + " "; }

            println("| " + m_pad + " | " + path_pad + " | " + a_pad + " |");
        }
        println("+--------+------------------------------------+--------------------------------+\n");
        return 0;
    }

    fn command_migrate(self) -> int {
        // Auto-discovery: pick up any hand-written migration files first.
        // Spid3r imports are compile-time constants, so brand-new files are
        // registered for the NEXT process; re-run to apply them.
        let new_count = self.sync_migration_registry(false);
        if new_count > 0 {
            println("[Migrate] Detected " + string(new_count) + " new migration file(s). Registry updated.");
            println("[Migrate] Re-run `spid3r magic migrate` to apply them.");
            return 0;
        }
        let runner = new MigrationRunner();
        runner.migrate(self.migrations_list);
        DB.close();
        return 0;
    }

    // ------------------------------------------------------------------
    // Migration Auto-Discovery (artisan-style)
    // Spid3r's `import` is a compile-time, string-literal-only construct —
    // modules cannot be loaded dynamically at runtime. So instead of
    // runtime require() like PHP's autoloader, the kernel scans
    // database/migrations/ and generates `registry.matrix`, which the
    // `magic` entrypoint imports once. `make:migration` and `migrate`
    // keep the registry in sync automatically.
    // ------------------------------------------------------------------

    fn migrations_dir(self) -> string {
        return self.resolve_root() + "database/migrations";
    }

    // Sorted list of migration filenames (*.matrix, excluding registry)
    fn scan_migration_files(self) {
        let out = [];
        let res = list_dir(self.migrations_dir());
        if res.is_err() {
            return out;
        }
        for name in res.unwrap() {
            let n = string(name);
            if n.ends_with(".matrix") and n != "registry.matrix" {
                out.push(n);
            }
        }
        // Insertion sort → deterministic execution order
        let i = 1;
        while i < out.len() {
            let cur = out[i];
            let j = i - 1;
            while j >= 0 and out[j] > cur {
                out[j + 1] = out[j];
                j = j - 1;
            }
            out[j + 1] = cur;
            i = i + 1;
        }
        return out;
    }

    // Pull the migration class name out of a file's source text
    fn extract_class_name(self, content: string) -> string {
        // Only register classes that extend the Migration base
        if not content.contains("extends Migration") {
            return "";
        }
        let parts = content.split("public class ");
        if parts.len() < 2 {
            return "";
        }
        let seg = parts[1].trim();
        let words = seg.split(" ");
        if words.len() == 0 {
            return "";
        }
        return words[0].trim();
    }

    // Regenerate registry.matrix from all migration files.
    // Returns the number of newly discovered files (0 = up to date),
    // or -1 on write failure. Set force=true to rebuild even when the
    // scan looks up to date (used when migration files were deleted —
    // see tools/resync.matrix).
    public fn sync_migration_registry(self, verbose: bool, force: bool = false) -> int {
        let files = self.scan_migration_files();
        let reg_path = self.migrations_dir() + "/registry.matrix";

        // How many of the scanned files does the current registry cover?
        let known = 0;
        let stale = 0;
        if file_exists(reg_path) {
            let res = read_file(reg_path);
            if res.is_ok() {
                let content = string(res.unwrap());
                for f in files {
                    let mod_name = f.slice(0, f.len() - 7); // strip ".matrix"
                    if content.contains("\"database/migrations/" + mod_name + "\"") {
                        known = known + 1;
                    }
                }
                // Registry entries whose files no longer exist
                for line in content.split("\n") {
                    let t = line.trim();
                    if t.starts_with("import \"database/migrations/") {
                        let ref_name = t.replace("import \"database/migrations/", "").replace("\";", "");
                        if not file_exists(self.migrations_dir() + "/" + ref_name + ".matrix") {
                            stale = stale + 1;
                        }
                    }
                }
            }
        }
        let new_count = files.len() - known;
        if not force and new_count <= 0 and stale == 0 and file_exists(reg_path) {
            return 0;
        }

        let imports = [];
        let calls = [];
        for f in files {
            let res = read_file(self.migrations_dir() + "/" + f);
            if res.is_err() {
                continue;
            }
            let cls = self.extract_class_name(string(res.unwrap()));
            if cls == "" {
                continue;
            }
            let mod_name = f.slice(0, f.len() - 7); // strip ".matrix"
            imports.push("import \"database/migrations/" + mod_name + "\";");
            calls.push("    kernel.register_migration(new " + cls + "());");
        }

        let content = "// database/migrations/registry.matrix
// AUTO-GENERATED by `spid3r magic migrate:sync` — do not edit by hand.
// Regenerated automatically by `make:migration` and `migrate` whenever
// migration files change. Spid3r imports are compile-time constants,
// so newly created files are picked up on the next CLI invocation.

" + imports.join("\n") + "

public fn register_all_migrations(kernel) {
" + calls.join("\n") + "
}
";
        let res = write_file(reg_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return -1;
        }
        if verbose {
            println("[Magic] Migration registry synced — " + string(files.len()) + " migration(s) registered.");
        }
        return new_count;
    }

    fn command_migrate_sync(self) -> int {
        let n = self.sync_migration_registry(true, false);
        if n < 0 {
            return 1;
        }
        if n == 0 {
            println("[Magic] Migration registry is up to date.");
        }
        return 0;
    }

    fn command_rollback(self) -> int {
        let runner = new MigrationRunner();
        runner.rollback(self.migrations_list);
        DB.close();
        return 0;
    }

    fn command_migrate_status(self) -> int {
        let runner = new MigrationRunner();
        runner.status(self.migrations_list);
        DB.close();
        return 0;
    }

    fn command_db_seed(self) -> int {
        println("[Database Seeder] Seeding database...");
        let count = 0;
        for seeder in self.seeders_list {
            seeder();
            count = count + 1;
        }
        println("[Database Seeder] Complete. Executed " + string(count) + " seeders.");
        DB.close();
        return 0;
    }

    fn resolve_root(self) -> string {
        let candidates = list(
            "",
            "examples/spid3r_web/"
        );
        for c in candidates {
            if file_exists(c + "framework/Router.matrix") {
                return c;
            }
        }
        return "";
    }

    fn command_make_controller(self, name: string) -> int {
        let clean_name = name;
        if not clean_name.ends_with("Controller") {
            clean_name = clean_name + "Controller";
        }
        let file_path = self.resolve_root() + "app/Controllers/" + clean_name + ".matrix";

        let content = "// app/Controllers/" + clean_name + ".matrix
import \"framework/Response\";
import \"framework/View/BD\";

public class " + clean_name + " {
    fn new() {}

    public fn index(self, req) {
        return json(map(\"message\", \"Hello from " + clean_name + "\"));
    }

    public fn show(self, req) {
        let id = req.param(\"id\");
        return json(map(\"id\", id));
    }
}
";
        let res = write_file(file_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return 1;
        }
        println("[Magic] Controller created successfully: " + file_path);
        return 0;
    }

    fn command_make_model(self, name: string, with_migration: bool) -> int {
        let file_path = self.resolve_root() + "app/Models/" + name + ".matrix";
        let table_name = string(name).lower() + "s";

        let content = "// app/Models/" + name + ".matrix
import \"framework/Database/Model\";
import \"framework/Database/DB\";

public class " + name + " extends Model {
    public let model;

    fn new(attrs = null) {
        super(\"" + table_name + "\", [], attrs);
        self.model = self;
    }

    public static fn find(id) {
        let _ = self;
        let row = DB.table(\"" + table_name + "\").where(\"id\", \"=\", id).first();
        if row != null {
            return new " + name + "(row);
        }
        return null;
    }

    public static fn create(attrs) {
        let _ = self;
        let m = new " + name + "(attrs);
        m.save();
        return m;
    }

    public static fn all() {
        let _ = self;
        let rows = DB.table(\"" + table_name + "\").get();
        let items = [];
        for r in rows {
            items.push(new " + name + "(r));
        }
        return items;
    }
}

public let " + name + "Model = " + name + ";
";
        let res = write_file(file_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return 1;
        }
        println("[Magic] Model created successfully: " + file_path);

        if with_migration {
            self.command_make_migration("create_" + table_name + "_table");
        }
        return 0;
    }

    fn command_make_migration(self, name: string) -> int {
        let ts = string(unix_time());
        let file_name = ts + "_" + name + ".matrix";
        let file_path = self.resolve_root() + "database/migrations/" + file_name;

        let content = "// database/migrations/" + file_name + "
import \"framework/Database/Schema\";
import \"framework/Database/Migration\";

public class Migration_" + ts + " extends Migration {
    fn new(name: string = \"" + name + "\") {
        super(name);
    }

    public fn up(self) {
        Schema.create(\"sample\", table => {
            table.id();
            table.timestamps();
        });
    }

    public fn down(self) {
        Schema.dropIfExists(\"sample\");
    }
}
";
        let res = write_file(file_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return 1;
        }
        println("[Magic] Migration created successfully: " + file_path);
        self.sync_migration_registry(true);
        println("[Magic] Registered automatically — run `spid3r magic migrate` to apply.");
        return 0;
    }
}

