// framework/Console/ConsoleKernel.matrix
// Spid3rWeb Magic CLI Command Engine

import "framework/Router";
import "framework/Application";
import "framework/Database/DB";
import "framework/Database/Schema";
import "framework/Database/Migration";
import "framework/Queue/Queue";
import "framework/Cache/Cache";
import "TestRunner";

public class ConsoleKernel {
    public let migrations_list;
    public let seeders_list;

    fn new() {
        self.migrations_list = list();
        self.seeders_list = list();
    }

    public fn register_migration(self, migration) {
        self.migrations_list.push(migration);
    }

    public fn register_seeder(self, seeder_fn) {
        self.seeders_list.push(seeder_fn);
    }

    public fn handle(self, cli_args) {
        if cli_args.len() == 0 or cli_args[0] == "help" or cli_args[0] == "--help" or cli_args[0] == "-h" {
            self.print_help();
            return 0;
        }

        let command = cli_args[0];

        if command == "serve" {
            let port = "8000";
            let dry_run = false;
            let i = 1;
            while i < cli_args.len() {
                let p_arg = cli_args[i];
                if p_arg.starts_with("--port=") {
                    port = p_arg.replace("--port=", "");
                } elif p_arg == "--port" and i + 1 < cli_args.len() {
                    i = i + 1;
                    port = cli_args[i];
                } elif p_arg == "--dry-run" or p_arg == "--check" {
                    dry_run = true;
                } else {
                    port = p_arg;
                }
                i = i + 1;
            }
            return self.command_serve(int(port), dry_run);
        } elif command == "test" {
            return self.command_test(cli_args);
        } elif command == "route:list" {
            return self.command_route_list();
        } elif command == "migrate" {
            return self.command_migrate();
        } elif command == "migrate:sync" {
            return self.command_migrate_sync();
        } elif command == "migrate:rollback" {
            return self.command_rollback();
        } elif command == "migrate:status" {
            return self.command_migrate_status();
        } elif command == "db:seed" {
            return self.command_db_seed();
        } elif command == "queue:work" {
            return self.command_queue_work(cli_args);
        } elif command == "cache:clear" {
            return self.command_cache_clear();
        } elif command == "key:generate" {
            return self.command_key_generate();
        } elif command == "make:controller" {
            if cli_args.len() < 2 {
                println("Error: Not enough arguments (missing controller name). Usage: make:controller <Name>");
                return 1;
            }
            return self.command_make_controller(cli_args[1]);
        } elif command == "make:model" {
            if cli_args.len() < 2 {
                println("Error: Not enough arguments (missing model name). Usage: make:model <Name> [-m]");
                return 1;
            }
            let make_mig = false;
            if cli_args.len() > 2 and cli_args[2] == "-m" {
                make_mig = true;
            }
            return self.command_make_model(cli_args[1], make_mig);
        } elif command == "make:middleware" {
            if cli_args.len() < 2 {
                println("Error: Not enough arguments (missing middleware name). Usage: make:middleware <Name>");
                return 1;
            }
            return self.command_make_middleware(cli_args[1]);
        } elif command == "make:provider" {
            if cli_args.len() < 2 {
                println("Error: Not enough arguments (missing provider name). Usage: make:provider <Name>");
                return 1;
            }
            return self.command_make_provider(cli_args[1]);
        } elif command == "make:test" {
            if cli_args.len() < 2 {
                println("Error: Not enough arguments (missing test name). Usage: make:test <name>");
                return 1;
            }
            return self.command_make_test(cli_args[1]);
        } elif command == "make:migration" {
            if cli_args.len() < 2 {
                println("Error: Not enough arguments (missing migration name). Usage: make:migration <name>");
                return 1;
            }
            return self.command_make_migration(cli_args[1]);
        } else {
            println("Unknown command: '" + command + "'. Run 'spid3r magic help' for a list of available commands.");
            return 1;
        }
    }

    fn print_help(self) {
        println("==================================================================");
        println("         Spid3rWeb Magic CLI (Developer Tooling for Spid3r)       ");
        println("==================================================================");
        println("Usage:");
        println("  spid3r magic <command> [arguments] [options]\n");
        println("Available commands:");
        println("  serve [--port N]          Start the Spid3rWeb local development server");
        println("  test [options]            Run the Spid3rWeb automated test suite");
        println("  route:list                List all registered application routes");
        println("  migrate                   Run outstanding database migrations");
        println("  migrate:sync              Re-scan database/migrations and rebuild the registry");
        println("  migrate:rollback          Rollback the last database migration batch");
        println("  migrate:status            Show the status of each migration");
        println("  db:seed                   Seed the database with records");
        println("  queue:work [--once]       Process queued jobs (--once = drain and exit)");
        println("  cache:clear               Flush the application cache store");
        println("  key:generate              Generate a random 256-bit APP_KEY in .env");
        println("  make:controller <Name>    Create a new MVC controller class");
        println("  make:model <Name> [-m]    Create a new model repository (optional migration)");
        println("  make:middleware <Name>    Create a new Onion HTTP middleware class");
        println("  make:provider <Name>      Create a new ServiceProvider class");
        println("  make:test <name>          Create a new integration test suite");
        println("  make:migration <name>     Create a new database migration file");
        println("  help                      Display this help message\n");
    }

    // ------------------------------------------------------------------------
    // Command Implementations
    // ------------------------------------------------------------------------

    fn command_serve(self, port: int, dry_run: bool = false) -> int {
        println("Starting Spid3rWeb development server: http://127.0.0.1:" + string(port));
        println("Press Ctrl+C to stop the server.");
        if dry_run {
            DB.close();
            return 0;
        }
        let app = new Application();
        app.listen(port);
        DB.close();
        return 0;
    }

    fn command_test(self, cli_args = null) -> int {
        if env("SPID3R_MAGIC_TEST_GUARD").is_some() {
            return 0;
        }
        env_set("SPID3R_MAGIC_TEST_GUARD", "1");

        let runner = new TestRunner(self.resolve_root());
        return runner.run(cli_args);
    }

    fn command_cache_clear(self) -> int {
        Cache.flush();
        println("[Magic] Application cache cleared.");
        return 0;
    }

    fn command_key_generate(self) -> int {
        let new_key = "hex:" + hex_encode(random_bytes(32).unwrap());
        let env_path = self.resolve_root() + ".env";
        let content = "";
        if file_exists(env_path) {
            let r = read_file(env_path);
            if r.is_ok() {
                content = string(r.unwrap());
            }
        }
        if content.contains("APP_KEY=") {
            let out_lines = [];
            for line in content.split("\n") {
                if line.trim().starts_with("APP_KEY=") {
                    out_lines.push("APP_KEY=" + new_key);
                } else {
                    out_lines.push(line);
                }
            }
            content = out_lines.join("\n");
        } else {
            if content != "" and not content.ends_with("\n") {
                content = content + "\n";
            }
            content = content + "APP_KEY=" + new_key + "\n";
        }
        let w = write_file(env_path, content);
        if w.is_err() {
            println("[Magic Error] " + w.unwrap_err());
            return 1;
        }
        println("[Magic] Application key set successfully in " + env_path);
        return 0;
    }

    fn command_route_list(self) -> int {
        let routes = Route.routes();
        println("\n+--------+------------------------------------+--------------------------------+");
        println("| Method | URI                                | Action / Name                  |");
        println("+--------+------------------------------------+--------------------------------+");

        for r in routes {
            let m_pad = r.method;
            while m_pad.len() < 6 { m_pad = m_pad + " "; }

            let path_pad = r.path;
            while path_pad.len() < 34 { path_pad = path_pad + " "; }

            let action_str = "Closure";
            if type_of(r.handler) == "string" {
                action_str = r.handler;
            } elif r.route_name != "" {
                action_str = "Closure [" + r.route_name + "]";
            }
            let a_pad = action_str;
            while a_pad.len() < 30 { a_pad = a_pad + " "; }

            println("| " + m_pad + " | " + path_pad + " | " + a_pad + " |");
        }
        println("+--------+------------------------------------+--------------------------------+\n");
        return 0;
    }

    fn command_queue_work(self, cli_args) -> int {
        let once = false;
        let queue = "";
        let i = 0;
        while i < cli_args.len() {
            let a = string(cli_args[i]);
            if a == "--once" {
                once = true;
            } elif a.starts_with("--queue=") {
                queue = a.slice(8, a.len());
            }
            i = i + 1;
        }

        let label = queue;
        if label == "" {
            label = "default";
        }
        let pending = Queue.size(queue);
        println("[Queue] worker on queue '" + label + "' — " + string(pending) + " job(s) pending");

        let processed = 0;
        if once {
            if Queue.run_next(queue) {
                processed = processed + 1;
            }
        } else {
            processed = Queue.work(0, queue);
        }

        println("[Queue] processed " + string(processed) + " job(s) — done");
        DB.close();
        return 0;
    }

    fn command_migrate(self) -> int {
        let new_count = self.sync_migration_registry(false);
        if new_count > 0 {
            println("[Migrate] Detected " + string(new_count) + " new migration file(s). Registry updated.");
            println("[Migrate] Re-run `spid3r magic migrate` to apply them.");
            return 0;
        }
        let runner = new MigrationRunner();
        runner.migrate(self.migrations_list);
        DB.close();
        return 0;
    }

    fn migrations_dir(self) -> string {
        return self.resolve_root() + "database/migrations";
    }

    fn scan_migration_files(self) {
        let out = [];
        let res = list_dir(self.migrations_dir());
        if res.is_err() {
            return out;
        }
        for name in res.unwrap() {
            let n = string(name);
            if n.ends_with(".matrix") and n != "registry.matrix" {
                out.push(n);
            }
        }
        let i = 1;
        while i < out.len() {
            let cur = out[i];
            let j = i - 1;
            while j >= 0 and out[j] > cur {
                out[j + 1] = out[j];
                j = j - 1;
            }
            out[j + 1] = cur;
            i = i + 1;
        }
        return out;
    }

    fn extract_class_name(self, content: string) -> string {
        if not content.contains("extends Migration") {
            return "";
        }
        let parts = content.split("public class ");
        if parts.len() < 2 {
            return "";
        }
        let seg = parts[1].trim();
        let words = seg.split(" ");
        if words.len() == 0 {
            return "";
        }
        return words[0].trim();
    }

    public fn sync_migration_registry(self, verbose: bool, force: bool = false) -> int {
        let files = self.scan_migration_files();
        let reg_path = self.migrations_dir() + "/registry.matrix";

        let known = 0;
        let stale = 0;
        if file_exists(reg_path) {
            let res = read_file(reg_path);
            if res.is_ok() {
                let content = string(res.unwrap());
                for f in files {
                    let mod_name = f.slice(0, f.len() - 7);
                    if content.contains("\"database/migrations/" + mod_name + "\"") {
                        known = known + 1;
                    }
                }
                for line in content.split("\n") {
                    let t = line.trim();
                    if t.starts_with("import \"database/migrations/") {
                        let ref_name = t.replace("import \"database/migrations/", "").replace("\";", "");
                        if not file_exists(self.migrations_dir() + "/" + ref_name + ".matrix") {
                            stale = stale + 1;
                        }
                    }
                }
            }
        }
        let new_count = files.len() - known;
        if not force and new_count <= 0 and stale == 0 and file_exists(reg_path) {
            return 0;
        }

        let imports = [];
        let calls = [];
        for f in files {
            let res = read_file(self.migrations_dir() + "/" + f);
            if res.is_err() {
                continue;
            }
            let cls = self.extract_class_name(string(res.unwrap()));
            if cls == "" {
                continue;
            }
            let mod_name = f.slice(0, f.len() - 7);
            imports.push("import \"database/migrations/" + mod_name + "\";");
            calls.push("    kernel.register_migration(new " + cls + "());");
        }

        let content = "// database/migrations/registry.matrix
// AUTO-GENERATED by `spid3r magic migrate:sync` — do not edit by hand.

" + imports.join("\n") + "

public fn register_all_migrations(kernel) {
" + calls.join("\n") + "
}
";
        let res = write_file(reg_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return -1;
        }
        if verbose {
            println("[Magic] Migration registry synced — " + string(files.len()) + " migration(s) registered.");
        }
        return new_count;
    }

    fn command_migrate_sync(self) -> int {
        let n = self.sync_migration_registry(true, false);
        if n < 0 {
            return 1;
        }
        if n == 0 {
            println("[Magic] Migration registry is up to date.");
        }
        return 0;
    }

    fn command_rollback(self) -> int {
        let runner = new MigrationRunner();
        runner.rollback(self.migrations_list);
        DB.close();
        return 0;
    }

    fn command_migrate_status(self) -> int {
        let runner = new MigrationRunner();
        runner.status(self.migrations_list);
        DB.close();
        return 0;
    }

    fn command_db_seed(self) -> int {
        println("[Database Seeder] Seeding database...");
        let count = 0;
        for seeder in self.seeders_list {
            seeder();
            count = count + 1;
        }
        println("[Database Seeder] Complete. Executed " + string(count) + " seeders.");
        DB.close();
        return 0;
    }

    fn resolve_root(self) -> string {
        let candidates = list(
            "",
            "examples/spid3r_web/"
        );
        for c in candidates {
            if file_exists(c + "framework/Router.matrix") {
                return c;
            }
        }
        return "";
    }

    fn ensure_parent_dir(self, file_path: string) -> string {
        let parts = string(file_path).split("/");
        if parts.len() < 2 {
            return file_path;
        }
        let dir = parts[0];
        if not file_exists(dir) {
            dir_create(dir);
        }
        let i = 1;
        while i < parts.len() - 1 {
            dir = dir + "/" + parts[i];
            if not file_exists(dir) {
                dir_create(dir);
            }
            i = i + 1;
        }
        return file_path;
    }

    fn valid_scaffold_name(self, name: string) -> bool {
        let s = string(name);
        if s.len() == 0 {
            return false;
        }
        let allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_";
        let i = 0;
        while i < s.len() {
            if not allowed.contains(s.slice(i, i + 1)) {
                return false;
            }
            i = i + 1;
        }
        let first = s.slice(0, 1);
        if string("0123456789").contains(first) {
            return false;
        }
        return true;
    }

    fn command_make_controller(self, name: string) -> int {
        if not self.valid_scaffold_name(name) {
            println("[Magic Error] Invalid controller name '" + string(name) + "' — use letters, digits and underscores only (e.g. PostController).");
            return 1;
        }
        let clean_name = name;
        if not clean_name.ends_with("Controller") {
            clean_name = clean_name + "Controller";
        }
        let file_path = self.resolve_root() + "app/Controllers/" + clean_name + ".matrix";
        let _ = self.ensure_parent_dir(file_path);
        let base_view = clean_name.slice(0, clean_name.len() - 10).lower();

        let content = "// app/Controllers/" + clean_name + ".matrix
import \"framework/Controller\";

public class " + clean_name + " extends Controller {
    fn new() {
        super();
    }

    public fn index(self, req) {
        return self.render(req, \"" + base_view + ".index\", {
            \"title\": \"" + clean_name + "\"
        });
    }

    public fn show(self, req) {
        let id = req.int(\"id\");
        return self.ok({\"id\": id});
    }

    public fn store(self, req) {
        let data = req.validate_or_fail({
            \"title\": \"required|min:2\"
        });
        return self.created(data);
    }
}
";
        let res = write_file(file_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return 1;
        }
        println("[Magic] Controller created successfully: " + file_path);
        return 0;
    }

    fn command_make_model(self, name: string, with_migration: bool) -> int {
        if not self.valid_scaffold_name(name) {
            println("[Magic Error] Invalid model name '" + string(name) + "' — use letters, digits and underscores only (e.g. Post).");
            return 1;
        }
        let file_path = self.resolve_root() + "app/Models/" + name + ".matrix";
        let _ = self.ensure_parent_dir(file_path);
        let table_name = string(name).lower() + "s";

        let content = "// app/Models/" + name + ".matrix
import \"framework/Database/Model\";

public let " + name + " = define_model(\"" + table_name + "\", {
    \"fillable\": [],
    \"hidden\": [],
    \"casts\": {}
});

public let " + name + "Model = " + name + ";
";
        let res = write_file(file_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return 1;
        }
        println("[Magic] Model created successfully: " + file_path);

        if with_migration {
            self.command_make_migration("create_" + table_name + "_table");
        }
        return 0;
    }

    fn command_make_middleware(self, name: string) -> int {
        if not self.valid_scaffold_name(name) {
            println("[Magic Error] Invalid middleware name '" + string(name) + "'.");
            return 1;
        }
        let clean_name = name;
        if not clean_name.ends_with("Middleware") {
            clean_name = clean_name + "Middleware";
        }
        let file_path = self.resolve_root() + "app/Middleware/" + clean_name + ".matrix";
        let _ = self.ensure_parent_dir(file_path);

        let content = "// app/Middleware/" + clean_name + ".matrix
public class " + clean_name + " {
    fn new() {}

    public fn handle(self, req, next = null) {
        if next != null {
            return next(req);
        }
        return null;
    }
}
";
        let res = write_file(file_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return 1;
        }
        println("[Magic] Middleware created successfully: " + file_path);
        return 0;
    }

    fn command_make_provider(self, name: string) -> int {
        if not self.valid_scaffold_name(name) {
            println("[Magic Error] Invalid provider name '" + string(name) + "'.");
            return 1;
        }
        let clean_name = name;
        if not clean_name.ends_with("Provider") {
            clean_name = clean_name + "Provider";
        }
        let file_path = self.resolve_root() + "app/Providers/" + clean_name + ".matrix";
        let _ = self.ensure_parent_dir(file_path);

        let content = "// app/Providers/" + clean_name + ".matrix
import \"framework/Providers/ServiceProvider\";

public class " + clean_name + " extends ServiceProvider {
    fn new() {
        super();
    }

    public fn register(self, container) {
        let _ = container;
    }

    public fn boot(self, container) {
        let _ = container;
    }
}
";
        let res = write_file(file_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return 1;
        }
        println("[Magic] Provider created successfully: " + file_path);
        return 0;
    }

    fn command_make_test(self, name: string) -> int {
        if not self.valid_scaffold_name(name) {
            println("[Magic Error] Invalid test name '" + string(name) + "'.");
            return 1;
        }
        let clean = name.lower();
        if not clean.starts_with("test_") {
            clean = "test_" + clean;
        }
        let file_path = self.resolve_root() + "tests/" + clean + ".matrix";
        let _ = self.ensure_parent_dir(file_path);

        let content = "// tests/" + clean + ".matrix
import \"framework/Web\";

fn main() {
    let app = web();
    app.get(\"/ping\", req => {\"pong\": true});

    let client = app.test_client();
    client.get(\"/ping\").assert_ok().assert_json_path(\"pong\", true);
    println(\"  [PASS] " + clean + "\");
}
";
        let res = write_file(file_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return 1;
        }
        println("[Magic] Test suite created successfully: " + file_path);
        return 0;
    }

    fn command_make_migration(self, name: string) -> int {
        let allowed = "abcdefghijklmnopqrstuvwxyz0123456789_";
        let sn = string(name);
        let name_ok = sn.len() > 0;
        let i = 0;
        while i < sn.len() {
            if not allowed.contains(sn.slice(i, i + 1)) {
                name_ok = false;
            }
            i = i + 1;
        }
        if not name_ok {
            println("[Magic Error] Invalid migration name '" + sn + "' — use lowercase words separated by underscores (e.g. create_posts_table).");
            return 1;
        }
        let ts = string(unix_time());
        let file_name = ts + "_" + name + ".matrix";
        let file_path = self.resolve_root() + "database/migrations/" + file_name;

        let words = name.split("_");
        let class_words = [];
        for w in words {
            if w.trim() != "" {
                let fw = w.trim();
                let head = fw.slice(0, 1).upper();
                if fw.len() > 1 {
                    head = head + fw.slice(1, fw.len());
                }
                class_words.push(head);
            }
        }
        let class_name = "Migration" + class_words.join("");

        let content = "// database/migrations/" + file_name + "
import \"framework/Database/Schema\";
import \"framework/Database/Migration\";

public class " + class_name + " extends Migration {
    fn new(name: string = \"" + name + "\") {
        super(name);
    }

    public fn up(self) {
        Schema.create(\"sample\", table => {
            table.id();
            table.timestamps();
        });
    }

    public fn down(self) {
        Schema.dropIfExists(\"sample\");
    }
}
";
        let res = write_file(file_path, content);
        if res.is_err() {
            println("[Magic Error] " + res.unwrap_err());
            return 1;
        }
        println("[Magic] Migration created successfully: " + file_path);
        self.sync_migration_registry(true);
        println("[Magic] Registered automatically — run `spid3r magic migrate` to apply.");
        return 0;
    }
}
