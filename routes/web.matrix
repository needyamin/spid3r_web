// routes/web.matrix
// Spid3rWeb Web Application Route Registrations
// Fresh installation: a welcome page at "/" and a runtime info page at "/info".

import "framework/Router";
import "framework/Response";
import "framework/View/BD";

// ---------------------------------------------------------------------------
// /info — renders the language builtin spid3rinfo() as a readable page.
// Dev-only diagnostic (like phpinfo). Values whose NAME looks sensitive
// (key / token / secret / password / credential / cookie) are redacted
// before they ever reach the response body.
// ---------------------------------------------------------------------------

fn info_is_sensitive(name: string) -> bool {
    let n = string(name).lower();
    return n.contains("key") or n.contains("token") or n.contains("secret")
        or n.contains("password") or n.contains("credential") or n.contains("cookie");
}

fn info_scalar(v) -> string {
    if v == null { return "null"; }
    if v == true { return "true"; }
    if v == false { return "false"; }
    return string(v);
}

// One table row for a section entry. Nested maps are flattened as
// "subkey: value" lines inside the cell; sensitive names are redacted.
fn info_row(k: string, v) -> string {
    let label = "<th>" + html_escape(k) + "</th>";

    if info_is_sensitive(k) {
        return "<tr>" + label + "<td class=\"redacted\">redacted (sensitive name)</td></tr>";
    }

    // Nested map (e.g. section values that are maps themselves)
    let nested = false;
    try {
        let _keys_probe = v.keys();
        nested = true;
    } catch (_e) {
        nested = false;
    }
    if nested {
        let parts = "";
        for sk in v.keys() {
            if parts != "" {
                parts = parts + "<br>";
            }
            if info_is_sensitive(string(sk)) {
                parts = parts + html_escape(string(sk)) + ": <span class=\"redacted\">redacted</span>";
            } else {
                parts = parts + html_escape(string(sk)) + ": " + html_escape(info_scalar(v[sk]));
            }
        }
        return "<tr>" + label + "<td>" + parts + "</td></tr>";
    }

    return "<tr>" + label + "<td>" + html_escape(info_scalar(v)) + "</td></tr>";
}

fn info_section(name: string, data) -> string {
    let out = "<section><h2>" + html_escape(name) + "</h2><table>";

    // A section is normally a map of entries; if it ever arrives as a
    // plain scalar, render it as a single "value" row instead.
    let is_map = false;
    try {
        let _probe = data.keys();
        is_map = true;
    } catch (_e) {
        is_map = false;
    }

    if is_map {
        for k in data.keys() {
            out = out + info_row(k, data[k]);
        }
    } else {
        out = out + info_row("value", data);
    }

    return out + "</table></section>";
}

fn info_page() -> string {
    let info = spid3rinfo();

    let page = "<!DOCTYPE html>";
    page = page + "<html lang=\"en\"><head>";
    page = page + "<meta charset=\"UTF-8\">";
    page = page + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">";
    page = page + "<meta name=\"description\" content=\"Spid3rWeb runtime information — Spid3r language, host system, features and configuration, rendered from the spid3rinfo() builtin.\">";
    page = page + "<title>Runtime Info — Spid3rWeb</title>";
    page = page + "<link rel=\"stylesheet\" href=\"/css/info.css\">";
    page = page + "</head><body><main class=\"info\">";

    page = page + "<header>";
    page = page + "<span class=\"badge\">Diagnostic</span>";
    page = page + "<h1>Runtime Info</h1>";
    page = page + "<p class=\"tagline\">Live output of the Spid3r language builtin <code>spid3rinfo()</code>.</p>";
    page = page + "</header>";

    page = page + "<a class=\"back\" href=\"/\">&larr; Back to welcome page</a>";

    page = page + "<p class=\"notice\"><strong>Note:</strong> this is a development diagnostic page. "
        + "Entries with sensitive names (keys, tokens, secrets, passwords, credentials, cookies) "
        + "are automatically redacted. Remove the <code>/info</code> route before exposing "
        + "this application publicly.</p>";

    for section_name in info.keys() {
        page = page + info_section(section_name, info[section_name]);
    }

    page = page + "<p class=\"info-footer\">Generated by Spid3rWeb &middot; spid3rinfo()</p>";
    page = page + "</main></body></html>";
    return page;
}

public fn register_web_routes() {
    Route.get("/", fn(req) { return view("welcome"); }).name("welcome");
    Route.get("/info", fn(req) { return html(info_page()); }).name("info");
}
