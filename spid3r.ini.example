# Spid3rWeb production runtime guardrails for Spid3r v1.1.1+
# Copy to `spid3r.ini` in the project root (or manage live via `spid3r-control`).
# All keys below are consumed directly by the Spid3r v1.1.1 runtime.

[spid3r]
# Bytecode VM is the default engine in v1.1.1+ ("vm" | "tree")
engine = "vm"

[net]
# HTTP/1.1 keep-alive idle timeout in milliseconds
keepalive_ms = 5000
# Per-request read/write socket timeout in milliseconds
timeout_ms = 30000
# Concurrent connection cap for serve_listener
max_connections = 1024
# Max HTTP request body size (10 MiB)
max_request_bytes = 10485760
# Max HTTP request header block size (64 KiB)
max_header_bytes = 65536

[db]
# SQLite/driver busy & query timeout in milliseconds
timeout_ms = 10000
# Upper bound on rows returned by a single query
max_rows = 100000

[limits]
# Soft memory ceiling in MiB for the script runtime
max_memory_mb = 512

[modules]
# Disable untrusted dynamic plugin routes unless explicitly needed
allow_wasm = false
allow_host = false
