// database/seeders/DatabaseSeeder.matrix
import "framework/Database/DB";
import "framework/Auth/Hash";

public fn run_database_seeder() {
    // 1. Seed demo user
    let users_count = DB.table("users").count();
    if users_count == 0 {
        let hashed_pw = Hash.make("secret123");
        let now = string(unix_time());
        DB.table("users").insert(map(
            "name", "Ada Lovelace",
            "email", "ada@example.com",
            "password", hashed_pw,
            "created_at", now,
            "updated_at", now
        ));
        println("  -> Seeded demo user: ada@example.com (Password: secret123)");
    }

    // 2. Seed store products (Daraz-style demo catalog)
    let products_count = DB.table("products").count();
    if products_count == 0 {
        let now = string(unix_time());
        let catalog = [
            ["Wireless Earbuds Pro", "wireless-earbuds-pro", "Bluetooth 5.3 earbuds with noise cancellation, 30-hour battery life and charging case.", 2490, 3500, "Electronics", "🎧", 42, 156, 4.6],
            ["Smart Watch Fit 2", "smart-watch-fit-2", "1.85 inch HD display, heart-rate and SpO2 monitoring, 100+ sport modes, IP68 water resistance.", 3200, 4500, "Electronics", "⌚", 30, 98, 4.4],
            ["Power Bank 20000mAh", "power-bank-20000mah", "Fast-charging 22.5W dual-output power bank with LED display and triple ports.", 1850, null, "Electronics", "🔋", 55, 210, 4.7],
            ["Cotton Casual T-Shirt", "cotton-casual-tshirt", "100% combed cotton half-sleeve t-shirt. Breathable, pre-shrunk, available in 6 colors.", 690, 990, "Fashion", "👕", 120, 340, 4.3],
            ["Slim Fit Denim Jeans", "slim-fit-denim-jeans", "Stretchable slim-fit denim with reinforced stitching and zip fly.", 1450, 1990, "Fashion", "👖", 65, 87, 4.2],
            ["Running Shoes AirLite", "running-shoes-airlite", "Lightweight mesh running shoes with cushioned EVA sole and anti-slip grip.", 2290, 3200, "Fashion", "👟", 48, 132, 4.5],
            ["Non-Stick Cookware Set", "non-stick-cookware-set", "5-piece granite-coated cookware set with glass lids. Induction and gas compatible.", 3850, 5200, "Home & Kitchen", "🍳", 25, 64, 4.6],
            ["LED Desk Lamp", "led-desk-lamp", "Rechargeable touch-control LED lamp with 3 light modes and foldable arm.", 1250, null, "Home & Kitchen", "💡", 80, 156, 4.4],
            ["Vitamin C Face Serum", "vitamin-c-face-serum", "20% Vitamin C brightening serum with hyaluronic acid. 30ml, dermatologist tested.", 890, 1290, "Beauty", "🧴", 90, 275, 4.5],
            ["Backpack 25L Waterproof", "backpack-25l-waterproof", "Water-resistant 25L laptop backpack with USB charging port and anti-theft pocket.", 1690, 2400, "Bags", "🎒", 70, 198, 4.5]
        ];

        for item in catalog {
            DB.table("products").insert(map(
                "name", item[0],
                "slug", item[1],
                "description", item[2],
                "price", item[3],
                "old_price", item[4],
                "category", item[5],
                "emoji", item[6],
                "stock", item[7],
                "sold", item[8],
                "rating", item[9],
                "created_at", now,
                "updated_at", now
            ));
        }
        println("  -> Seeded 10 store products.");
    }

    // 3. Admin bootstrap (admin panel needs at least one is_admin = 1 user)
    //    Priority:
    //    a) SPID3R_ADMIN_EMAIL (.env or OS env) — promote that user, or
    //       create it (password: SPID3R_ADMIN_PASSWORD or "secret123").
    //    b) Otherwise, if no admin exists at all, create the demo admin
    //       admin@spid3r.test (Password: secret123) — change it in prod!
    let admin_now = string(unix_time());
    if env("SPID3R_ADMIN_EMAIL").is_some() {
        let admin_email = string(env("SPID3R_ADMIN_EMAIL").unwrap()).trim().lower();
        if admin_email != "" {
            let admin_pw = "secret123";
            if env("SPID3R_ADMIN_PASSWORD").is_some() {
                admin_pw = string(env("SPID3R_ADMIN_PASSWORD").unwrap());
            }
            let existing = DB.table("users").where("email", "=", admin_email).first();
            if existing == null {
                DB.table("users").insert(map(
                    "name", "Administrator",
                    "email", admin_email,
                    "password", Hash.make(admin_pw),
                    "is_admin", 1,
                    "created_at", admin_now,
                    "updated_at", admin_now
                ));
                println("  -> Created admin user: " + admin_email);
            } else {
                DB.table("users").where("email", "=", admin_email).update(map(
                    "is_admin", 1,
                    "updated_at", admin_now
                ));
                println("  -> Promoted to admin: " + admin_email);
            }
        }
    } else {
        let admins_count = DB.table("users").where("is_admin", "=", 1).count();
        if admins_count == 0 {
            if DB.table("users").where("email", "=", "admin@spid3r.test").first() == null {
                DB.table("users").insert(map(
                    "name", "Administrator",
                    "email", "admin@spid3r.test",
                    "password", Hash.make("secret123"),
                    "is_admin", 1,
                    "created_at", admin_now,
                    "updated_at", admin_now
                ));
                println("  -> Seeded demo admin: admin@spid3r.test (Password: secret123) — change it before deploying!");
            }
        }
    }
}
