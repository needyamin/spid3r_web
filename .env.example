# =====================================================================
# Spid3rWeb environment configuration
# =====================================================================
# Copy this file to `.env` in the project root and adjust values.
#   cp .env.example .env
#
# Precedence: real OS environment variables ALWAYS win over .env —
# the file only fills in values that are not already set.
# `.env` is git-ignored; never commit real credentials.

# ---------------------------------------------------------------------
# Application mode & developer/test demo logins
#   development (default) | test | production
#   In dev/test the login page and footer show the seeded demo accounts:
#     admin@spid3r.test / secret123   (admin panel)
#     ada@example.com  / secret123   (customer)
#   APP_ENV=production always hides them. SPID3R_ADMIN_EMAIL set also
#   hides them (never print a real admin password).
# ---------------------------------------------------------------------
APP_ENV=development
#SPID3R_SHOW_DEMO_LOGINS=0     # hide demo logins even in dev
#SPID3R_SHOW_DEMO_LOGINS=1     # force-show (only if you know what you do)

# Override the credentials printed by the dev/test hint, if your seed
# data uses different demo accounts.
#SPID3R_DEMO_ADMIN_EMAIL=admin@spid3r.test
#SPID3R_DEMO_ADMIN_PASSWORD=secret123
#SPID3R_DEMO_CUSTOMER_EMAIL=ada@example.com
#SPID3R_DEMO_CUSTOMER_PASSWORD=secret123

# ---------------------------------------------------------------------
# Database driver: sqlite (default) | postgres | mysql | mariadb
# ---------------------------------------------------------------------
SPID3R_DB_DRIVER=sqlite

# ---------------------------------------------------------------------
# SQLite (default engine — nothing else required)
# ---------------------------------------------------------------------
SPID3R_DB_PATH=database/database.sqlite

# ---------------------------------------------------------------------
# PostgreSQL
#   Auth note: the runtime client supports md5/trust auth (not SCRAM).
#   On the server run:
#     SET password_encryption = 'md5';
#     ALTER USER app WITH PASSWORD 'secret';
# ---------------------------------------------------------------------
#SPID3R_DB_DRIVER=postgres
#SPID3R_PG_HOST=127.0.0.1
#SPID3R_PG_PORT=5432
#SPID3R_PG_USER=spid3r
#SPID3R_PG_PASSWORD=secret
#SPID3R_PG_DATABASE=spid3r

# ---------------------------------------------------------------------
# MySQL / MariaDB (MariaDB uses the same SPID3R_MYSQL_* variables)
#   Auth note: MySQL 8 users must use mysql_native_password:
#     ALTER USER 'app'@'%' IDENTIFIED WITH mysql_native_password BY 'secret';
#   MariaDB ships mysql_native_password by default — works as-is.
# ---------------------------------------------------------------------
#SPID3R_DB_DRIVER=mysql
#SPID3R_MYSQL_HOST=127.0.0.1
#SPID3R_MYSQL_PORT=3306
#SPID3R_MYSQL_USER=spid3r
#SPID3R_MYSQL_PASSWORD=secret
#SPID3R_MYSQL_DATABASE=spid3r

# ---------------------------------------------------------------------
# Session (config/session.matrix)
# ---------------------------------------------------------------------
#SPID3R_SESSION_COOKIE=spid3r_session

# ---------------------------------------------------------------------
# Logging (config/logging.matrix) — minimum level: debug|info|warn|error
# ---------------------------------------------------------------------
#SPID3R_LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Mail (config/mail.matrix)
#   The "log" driver writes every message to storage/logs/mail.log-*.log.
#   The smtp driver needs an outbound TCP API the runtime does not expose
#   yet, so keep the log driver until then.
# ---------------------------------------------------------------------
#SPID3R_MAIL_MAILER=log

# ---------------------------------------------------------------------
# Queue (config/queue.matrix)
#   database driver persists jobs in the `jobs` table; drain with:
#     spid3r magic queue:work           (process until empty)
#     spid3r magic queue:work --once    (single job)
# ---------------------------------------------------------------------
#SPID3R_QUEUE=default
#SPID3R_QUEUE_CONNECTION=database

# ---------------------------------------------------------------------
# Third-party services (config/services.matrix) — all optional
# ---------------------------------------------------------------------
#SPID3R_SMS_ENDPOINT=
#SPID3R_SMS_API_KEY=
#SPID3R_SSLCZ_STORE_ID=
#SPID3R_SSLCZ_STORE_PASSWORD=
#SPID3R_STRIPE_KEY=
#SPID3R_STRIPE_SECRET=
#SPID3R_GOOGLE_CLIENT_ID=
#SPID3R_GOOGLE_CLIENT_SECRET=
